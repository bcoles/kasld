#!/bin/sh
# This file is part of KASLD - https://github.com/bcoles/kasld
#
# tests/vm/run — reproducible cross-architecture LIVE soundness check.
#
# For each architecture, this boots a real, publicly-fetchable kernel under
# qemu-system, captures the kernel's ground-truth text base, runs the
# cross-built kasld against the running kernel, and verifies the soundness
# invariant the whole tool rests on:
#
#     truth ∈ [virt_image_base_min, virt_image_base_max]
#
# Unlike tests/replay (offline, over captured fixtures), this exercises kasld
# end to end against a live kernel — the same check a user can run on their own
# machine with extra/collect + extra/validate-bundle, generalised across arches.
#
# Prerequisites:
#   - `make cross` already run (build/<triple>/kasld + components), with the
#     same cross toolchains on PATH (used here to build the tiny init).
#   - qemu-system-<arch> on PATH (the host's qemu packages, e.g. Debian/Ubuntu
#     qemu-system-x86 / -arm / -misc). Guest kernels are fetched from Alpine.
#   - curl, cpio, gzip.
#
# Usage:
#   tests/vm/run                 # every supported arch, default profile
#   tests/vm/run <arch>          # one arch, default profile
#   tests/vm/run <arch> <mode>   # mode: default | kptr-hidden | perf-open |
#                                #       dmesg-open | bpf-open | hardened |
#                                #       nokaslr | no5lvl | no4lvl | la57
#   tests/vm/run all <mode>      # every arch in a given mode
#   tests/vm/run table           # render the results matrix (markdown) from the
#                                # boot logs, followed by the speculative-
#                                # narrowing table
#   tests/vm/run fetch-modules [cell ...]   # stage a distro cell's own modules
#                                # from the published build its kernel came from
#                                # (mainline cells: tests/vm/stage-modules)
#   tests/vm/run spec-table      # render only the speculative-narrowing table
#                                # (cells where the likely window beats guaranteed)
#   tests/vm/run table --with-timing        # include timing/side-channel rows in
#   tests/vm/run spec-table --with-timing   # the speculative-narrowing table
#                                # (excluded by default — see SPEC_INCLUDE_TIMING)
#
# Modes (the analysis always runs unprivileged at uid 1000; modes differ only
# by the sysctl hardening applied — the root ground-truth capture is the sole
# privileged step):
# perf/dmesg only affect the result once kallsyms is hidden, so those toggles
# branch off kptr-hidden, not default. Values not named are the kernel's own
# booted defaults (captured per cell; no distro sysctl.d runs under the minimal
# initramfs, so dmesg_restrict is the compile-time .config value):
#   default     uid 1000, all sysctls at booted defaults — kallsyms is zeroed at
#               the upstream perf=2 (needs perf<=1 or CAP_SYSLOG), so inference
#   kptr-hidden default + kptr_restrict=2 — isolates kptr (perf already gates kallsyms)
#   perf-open   default + perf_event_paranoid=0 — unlocks kallsyms + the perf leak
#   dmesg-open  default + dmesg_restrict=0 — dmesg log readable
#   hardened    kptr=2 + dmesg_restrict=1 + perf=3 — unprivileged floor
#   nokaslr     boot with `nokaslr` — verifies the KASLR-disabled pin
#   no5lvl      boot with `no5lvl` — x86_64 drops to 4-level paging, riscv64 to
#               SV48. Both move PAGE_OFFSET, so this is what exercises a
#               linear-map base other than the one the cell boots by default.
#   no4lvl      boot with `no4lvl` — riscv64 drops to SV39, its third paging
#               mode and a third PAGE_OFFSET.
#   la57        x86_64 only, and the one mode that changes QEMU rather than the
#               kernel command line: forces TCG so `-cpu max` can expose la57.
#               Under KVM the guest only gets features the HOST has, and a host
#               without la57 pins the guest to 4-level paging however the kernel
#               is configured — so this is the only way to reach x86_64's
#               5-level layout on such a host. Slow: TCG, not KVM.
#
# The last two are kernel parameters, not init tokens: the paging mode is
# chosen at boot, so it needs no separate cell the way a VMSPLIT does. Every
# other architecture ignores them and boots exactly as `default`.
#
# Env overrides:
#   QEMU_DIR        directory holding qemu-system-* (default: search PATH)
#   ALPINE_VER      Alpine release for netboot kernels (default: 3.21)
#   ALPINE_MIRROR   mirror base URL
#   BUILD_DIR       kasld build root (default: ./build)
#   LOONGARCH_BIOS  path to edk2 loongarch firmware (loongarch64 needs UEFI)
#   TIMEOUT         per-boot timeout seconds (default: 240)
#   SPEC_INCLUDE_TIMING  1 = include timing/side-channel (method:timing) rows in
#                   the speculative-narrowing table; default 0 excludes them
#                   because their result is hardware- and run-dependent
#                   (equivalent to passing --with-timing)
# ---
# <bcoles@gmail.com>
set -u

HERE=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH='' cd -- "$HERE/../.." && pwd)
BUILD_DIR=${BUILD_DIR:-$ROOT/build}
QEMU_DIR=${QEMU_DIR:-}
ALPINE_VER=${ALPINE_VER:-3.21}
ALPINE_MIRROR=${ALPINE_MIRROR:-https://dl-cdn.alpinelinux.org/alpine}
TIMEOUT=${TIMEOUT:-600}
CACHE=$HERE/.cache

# Speculative-narrowing table: which consensus-method names are treated as
# non-reproducible and excluded from the table by default. Microarchitectural
# side channels (method:timing — cache/speculation oracles such as prefetch and
# entrybleed) succeed as a function of the host CPU and vary from run to run,
# even on the same machine, so a table that listed them would not be
# reproducible. Deterministic sub-floor signals (a leaked pointer, a memory-map
# heuristic) are unaffected and stay. Opt the timing rows back in with
# --with-timing or SPEC_INCLUDE_TIMING=1.
SPEC_NONREPRO_METHODS="timing"
SPEC_INCLUDE_TIMING=${SPEC_INCLUDE_TIMING:-0}
for _arg in "$@"; do
  [ "$_arg" = --with-timing ] && SPEC_INCLUDE_TIMING=1
done

# name | alpine-arch | flavor | build-prefix | qemu-suffix | machine | console
#   name:   <arch>-<distro>-<kernel maj.minor>. <arch> is the display arch (it
#           carries no '-', so it is recovered as the leading dash-component);
#           <distro> is alpine (a distro netboot/apk kernel) or mainline (a
#           kernel.org build via build-kernel); <kernel maj.minor> is the guest
#           kernel line. An arch may appear under several (distro, version) cells.
#   flavor: a netboot kernel name (virt/lts) or "apk" (extract vmlinuz from the
#           linux-lts apk — for ports with no netboot image, e.g. riscv64/
#           loongarch64), or "local" (built from kernel.org by build-kernel).
TABLE='
x86_64-alpine-6.12      | x86_64      | virt| x86_64       | x86_64      | -M q35 -cpu max        | ttyS0
i686-alpine-6.12        | x86         | lts | i686         | i386        | -M pc -cpu max         | ttyS0
aarch64-alpine-6.12     | aarch64     | virt| aarch64      | aarch64     | -M virt -cpu max       | ttyAMA0
