trim() { echo "$1" | xargs; }

# True if ELF $1 has no dynamic interpreter (static / static-pie) — the minimal
# initramfs carries no loader or shared libs, so only static binaries run.
is_static() {
  if command -v readelf >/dev/null 2>&1; then
    ! readelf -l "$1" 2>/dev/null | grep -q 'INTERP'
  else
    ! file -L "$1" 2>/dev/null | grep -q 'dynamically linked'
  fi
}

# Echo "<build-dir> <cc>" for build-prefix $1: the first build/<prefix>-*/ whose
# kasld is present AND static (the host gnu build is dynamic; `make cross` musl
# builds are static-pie) AND whose <triple>-gcc is on PATH (the toolchain that
# built it, reused here to cross-compile init.c). Empty if none.
resolve_target() {
  for d in "$BUILD_DIR/$1"-*; do
    [ -x "$d/kasld" ] || continue
    [ -d "$d/components" ] || continue
    is_static "$d/kasld" || continue
    t=$(basename "$d")
    if command -v "$t-gcc" >/dev/null 2>&1; then echo "$d $t-gcc"; return; fi
  done
}

# qemu binary for suffix $1: prefer QEMU_DIR, else fall back to PATH. Empty if
# neither has it. The preference (not exclusive) lets one run mix a locally built
# qemu (e.g. qemu-system-ppc) with the system qemu for the other arches.
resolve_qemu() {
  if [ -n "$QEMU_DIR" ] && [ -x "$QEMU_DIR/qemu-system-$1" ]; then
    echo "$QEMU_DIR/qemu-system-$1"
  else
    command -v "qemu-system-$1" 2>/dev/null
  fi
}

# Fetch (and cache) the kernel for one arch. Args: name alpine-arch flavor dest
fetch_kernel() {
  _name=$1 _aarch=$2 _flavor=$3 _dest=$4
  [ -f "$_dest" ] && return 0
  mkdir -p "$(dirname "$_dest")"
  if [ "$_flavor" = local ]; then
    # Gap arch with no Alpine port: the kernel is supplied locally, not fetched.
    # Produce one with tests/vm/build-kernel, or drop a stock kernel (e.g. from a
    # Debian qemu image) at this path. Absent -> skip, never a false download.
    echo "  !! no kernel at $_dest — build it (tests/vm/build-kernel $_name) or"
    echo "     copy a stock kernel for this arch there, then re-run"
    return 1
  elif [ "$_flavor" = apk ]; then
    _repo="$ALPINE_MIRROR/edge/main/$_aarch"
    _apk=$(curl -fsSL "$_repo/" | grep -oE 'linux-lts-[0-9][^"<]*\.apk' | sort -V | tail -1)
    [ -n "$_apk" ] || { echo "  !! no linux-lts apk for $_aarch"; return 1; }
    _tmp=$(mktemp -d)
    curl -fsSL -o "$_tmp/k.apk" "$_repo/$_apk" || { rm -rf "$_tmp"; return 1; }
    # An apk is concatenated gzip streams; -i reads across the control segment.
    (cd "$_tmp" && tar -xzif k.apk boot/vmlinuz-lts 2>/dev/null)
    [ -f "$_tmp/boot/vmlinuz-lts" ] || { echo "  !! no vmlinuz in $_apk"; rm -rf "$_tmp"; return 1; }
    # Some ports ship the image gzip-compressed; qemu -kernel wants it raw.
    if gzip -t "$_tmp/boot/vmlinuz-lts" 2>/dev/null; then
      gunzip -c "$_tmp/boot/vmlinuz-lts" >"$_dest"
    else
      cp "$_tmp/boot/vmlinuz-lts" "$_dest"
    fi
    rm -rf "$_tmp"
  else
    _url="$ALPINE_MIRROR/v$ALPINE_VER/releases/$_aarch/netboot/vmlinuz-$_flavor"
    echo "  [*] fetching $_url"
    curl -fsSL -o "$_dest" "$_url" || { echo "  !! kernel download failed"; rm -f "$_dest"; return 1; }
  fi
}

# --- soundness verdict from a boot log (adapted from the matrix extractor) ---
norm() { v=$(printf '%s' "$1" | sed 's/^0x//' | tr 'A-F' 'a-f'); [ -n "$v" ] || return 0; printf '%016s' "$v" | tr ' ' 0; }
hexle() { [ "$1" = "$2" ] && return 0; [ "$(printf '%s\n%s\n' "$1" "$2" | LC_ALL=C sort | head -1)" = "$1" ]; }

# Physical soundness for a boot log, echoed as one word:
#   Y   truth inside the window and outside every carved sub-range
#   Y*  as Y, but the carved list was truncated, so membership is unsettled
#   N   truth outside the window bounds
#   X   truth inside the bounds but inside a carved sub-range
#   NA  coupled arch, or no truth / no window to compare
# Truth = the lowest "Kernel code" address in the root-captured /proc/iomem dump
# (raw "START-END : Kernel code" format). Window = the -j phys_kaslr_text_min/max.
# Only meaningful on DECOUPLED arches: where text tracks the direct map (coupled)
# the phys base is a projection of the virt base and the window is the wide honest
# top, so a phys verdict is trivially-sound noise -> NA.
phys_verdict() {
  _plog=$1
  _dec=$(grep -am1 -oE '"text_tracks_directmap": *(true|false)' "$_plog" | awk '{print $2}')
  [ "$_dec" = false ] || { echo NA; return; }
  _pt=$(grep -am1 -aE '[0-9a-fA-F]+-[0-9a-fA-F]+ : Kernel code' "$_plog" \
        | sed -E 's/^[[:space:]]*([0-9a-fA-F]+)-.*/\1/')
  _pmin=$(grep -am1 -oE '"phys_kaslr_text_min": *"0x[0-9a-fA-F]+"' "$_plog" | grep -oE '0x[0-9a-fA-F]+')
  _pmax=$(grep -am1 -oE '"phys_kaslr_text_max": *"0x[0-9a-fA-F]+"' "$_plog" | grep -oE '0x[0-9a-fA-F]+')
  _pt=$(norm "$_pt"); _plo=$(norm "$_pmin"); _phi=$(norm "$_pmax")
  if [ -z "$_pt" ] || [ -z "$_plo" ] || [ -z "$_phi" ]; then echo NA; return; fi
  if ! hexle "$_plo" "$_pt" || ! hexle "$_pt" "$_phi"; then echo N; return; fi
  # Inside the headline window is not the same as inside the candidate SET. A
  # C_EXCLUDE carves an interior hole: the counts drop but range_min/range_max
  # do not move, so a truth sitting in a carved hole passes every bound test
  # while having been ruled out. Test the holes too, or this whole class of
  # over-narrowing is invisible here.
  _holes=$(awk '
    /"excluded": \[/          { inb = 1; next }
    inb && /^[[:space:]]*\]/  { exit }
    inb {
      n = 0
      while (match($0, /0x[0-9a-fA-F]+/)) {
        v[++n] = substr($0, RSTART, RLENGTH)
        $0 = substr($0, RSTART + RLENGTH)
      }
      if (n >= 2) print v[1], v[2]
    }
  ' "$_plog")
  echo "$_holes" | while read -r _hlo _hhi; do
    [ -n "$_hlo" ] || continue
    if hexle "$(norm "$_hlo")" "$_pt" && hexle "$_pt" "$(norm "$_hhi")"; then
      exit 9
    fi
  done || { echo X; return; }
  # The report keeps at most KASLD_REPORT_MAX_EXCLUDED holes; past that the list
  # is a sample and membership cannot be settled from it. Say so rather than
  # reporting a pass the evidence does not support.
  _etot=$(grep -am1 -oE '"excluded_total": *[0-9]+' "$_plog" | grep -oE '[0-9]+')
  _elist=$(echo "$_holes" | grep -c '[0-9]')
  if [ -n "$_etot" ] && [ "$_etot" -gt "$_elist" ]; then echo 'Y*'; return; fi
  echo Y
}

# region_verdict <log>: gates the RANDOMIZE_MEMORY region bases (direct map,
# vmalloc, vmemmap) and, where the init can establish it, the module region
# base. Each truth the init reads from /proc/kcore (the
# "region_truth <sym> = 0x..." lines) must lie inside its resolved window
# (the "virt_<region>_base" {min,max} in -j). The module entry matters because a
# region placed by arithmetic on a reported width is pinned exactly, so an error
# in that arithmetic is a wrong C_EQUALS in the guaranteed window rather than a
# window merely too wide, and no unit test comparing the rule against its own
# expression can see it. Prints:
#   Y        every captured region truth was compared and is inside its window
#   NA       no region truth captured (arch without RANDOMIZE_MEMORY, or no kcore)
#   N:<sym>  <sym>'s truth is outside its resolved window (a soundness violation)
#   ?:<sym>  <sym>'s truth was captured but no window was found to gate it
#            against — nothing was verified, which is not a pass
region_verdict() {
  _rlog=$1
  _rany=0
  for _rp in page_offset_base:virt_page_offset_base \
             vmalloc_base:virt_vmalloc_base \
             vmemmap_base:virt_vmemmap_base \
             modules_vaddr:module_base; do
    _rsym=${_rp%%:*}; _rkey=${_rp#*:}
    _rt=$(grep -am1 -oE "region_truth $_rsym = 0x[0-9a-fA-F]+" "$_rlog" | grep -oE '0x[0-9a-fA-F]+')
    [ -n "$_rt" ] || continue
    # The window object is read from the key onwards up to its closing brace, so
    # a pretty-printed one spanning several lines is found as readily as one
    # written inline. A line-at-a-time match sees only the inline form, and
    # silently gates nothing where the emitter wraps.
    _rwin=$(awk -v k="\"$_rkey\":" '
      { p = index($0, k)
        if (!f && p) { f = 1; $0 = substr($0, p) }
        if (f) { buf = buf " " $0; if (index(buf, "}")) { print buf; exit } } }' "$_rlog")
    _rmin=$(printf '%s' "$_rwin" | grep -oE '0x[0-9a-fA-F]+' | sed -n 1p)
    _rmax=$(printf '%s' "$_rwin" | grep -oE '0x[0-9a-fA-F]+' | sed -n 2p)
    _rtn=$(norm "$_rt"); _rlo=$(norm "$_rmin"); _rhi=$(norm "$_rmax")
    # A truth with no window gates nothing. Report it rather than counting it as
    # a pass: a silent skip here is indistinguishable from a comparison that
    # succeeded, which is how a gate comes to hold open.
    { [ -n "$_rlo" ] && [ -n "$_rhi" ]; } || { echo "?:$_rsym"; return; }
    _rany=1
    if hexle "$_rlo" "$_rtn" && hexle "$_rtn" "$_rhi"; then :; else echo "N:$_rsym"; return; fi
  done
  [ "$_rany" = 1 ] && echo Y || echo NA
}

# verdict <log>: prints "PASS|FAIL|N/A  <detail>" and returns 0 only on PASS/NA.
# Gates on BOTH axes: the virtual text base AND (on decoupled arches) the physical
# image base must lie inside their resolved windows.
# Echo "<_text> <_stext>" (link addresses) from a symbol source, or nothing.
#
# Two forms, because the two sources differ: a System.map is text in the same
# "addr type name" shape as /proc/kallsyms, and a vmlinux is an ELF whose symtab
# readelf prints. Both state the same two addresses; the map is staged because it
# is a tenth the size and survives the build tree being pruned.
sym_pair() {
  _sp=$1
  [ -f "$_sp" ] || return 1
  case "$(od -An -c -N4 "$_sp" 2>/dev/null | tr -d ' ')" in
  177ELF*)
    command -v readelf >/dev/null 2>&1 || return 1
    readelf -sW "$_sp" 2>/dev/null | awk '
      $8 == "_text"  { t = $2 }
      $8 == "_stext" { s = $2 }
      END { if (t != "" && s != "") print t " " s; else exit 1 }'
    ;;
  *)
    awk '
      $3 == "_text"  { t = $1 }
      $3 == "_stext" { s = $1 }
      END { if (t != "" && s != "") print t " " s; else exit 1 }' "$_sp"
    ;;
  esac
}

# Runtime _text truth for a kernel that does not export _text through kallsyms.
#
# mips exports only _stext, at any privilege, so a capture from one carries no
# truth for the quantity kasld solves. The image that was booted carries both
# symbols, and the gap between them is this build's fact: runtime _text =
# runtime _stext - (link _stext - link _text).
#
# It has to come from the image. Reconstructing _text from the physical address
# in /proc/iomem would need PAGE_OFFSET, which cancels against the window the
# truth is later checked against -- leaving a comparison that holds for any
# kernel ever built. STEXT_OFFSET is no good either: a per-arch fallback
# constant, not this build's fact.
#
# Only the low word reaches the shell. Arithmetic here is intmax_t, and every
# mips64 kernel address is above INTMAX_MAX, where dash silently yields 0 --
# so the halves are compared as strings and only the low 32 bits are subtracted.
hex_gap() {
  _ga=$(printf '%s' "$1" | tr 'A-F' 'a-f')
  _gb=$(printf '%s' "$2" | tr 'A-F' 'a-f')
  # A 32-bit address is exactly the low word, so the high half is empty -- that
  # is a valid case, not a missing one. Equal halves is the whole requirement.
  _gah=${_ga%????????}; _gbh=${_gb%????????}
  [ "$_ga" != "$_gah" ] && [ "$_gah" = "$_gbh" ] || return 1
  _gd=$(( 0x${_gb#"$_gbh"} - 0x${_ga#"$_gah"} ))
  [ "$_gd" -ge 0 ] || return 1
  printf '%s' "$_gd"
}

# Echoes the runtime _text as 0x-hex, or nothing when it cannot be established:
# no image symbols (stripped or compressed), no runtime _stext, or the image
# already exports _text, in which case the capture needs no recorded truth.
runtime_text_truth() {
  _rt_img=$1; _rt_ks=$2; _rt_map=$3; _rt_vml=$4
  [ -s "$_rt_ks" ] || return 0
  command -v readelf >/dev/null 2>&1 || return 0
  awk '$3 == "_text" { exit 1 }' "$_rt_ks" || return 0
  _rt_st=$(awk '$3 == "_stext" { print $1; exit }' "$_rt_ks")
  [ -n "$_rt_st" ] || return 0
  # The staged boot image first, then the vmlinux it was made from. arm stages a
  # zImage and riscv an Image; neither carries a symbol table, so the gap has to
  # come from the build tree. Taking it from the compile-time STEXT_OFFSET is not
  # an option: arm32 declares none, and this build puts _stext 0xf8000 above
  # _text -- the constant is a fallback, not the fact.
  _rt_pair=''
  for _rt_src in "$_rt_map" "$_rt_img" "$_rt_vml"; do
    _rt_pair=$(sym_pair "$_rt_src") && [ -n "$_rt_pair" ] && break
    _rt_pair=''
  done
  [ -n "$_rt_pair" ] || return 0
  _rt_lt=${_rt_pair%% *}
  _rt_ls=${_rt_pair##* }
  _rt_gap=$(hex_gap "$_rt_lt" "$_rt_ls") || return 0
  _rt_lo=$(printf '%s' "$_rt_st" | tr 'A-F' 'a-f')
  _rt_hi=${_rt_lo%????????}
  [ "$_rt_lo" != "$_rt_hi" ] || return 0
  _rt_d=$(( 0x${_rt_lo#"$_rt_hi"} - _rt_gap ))
  [ "$_rt_d" -ge 0 ] || return 0
  printf '0x%s%08x' "$_rt_hi" "$_rt_d"
}

# Write the runtime _text into the boot log when the kernel withheld it.
#
# The verdicts read the log and nothing else, so the derivation belongs here,
# once, rather than at each reader. mips exports only _stext, and a verdict that
# substitutes _stext for _text compares a value a head gap above the quantity
# kasld solves -- which passes a window whose lower edge sits between the two,
# hiding an over-narrowing of up to that gap.
#
# The appended block says where the value came from, so a reader of the log can
# tell a derived landmark from one the kernel published.
append_text_truth() {
  _at_log=$1 _at_img=$2 _at_map=$3 _at_vml=$4
  [ -f "$_at_log" ] || return 0
  awk '/ _text$/ { exit 1 }' "$_at_log" || return 0
  _at_st=$(awk '/ _stext$/ { print $1; exit }' "$_at_log")
  [ -n "$_at_st" ] || return 0
  command -v readelf >/dev/null 2>&1 || return 0
  # Boot image first, then the vmlinux it came from: arm stages a zImage and
  # riscv an Image, neither of which carries a symbol table. Without this the
  # verdict silently falls back to _stext and compares the window against the
  # wrong quantity -- which is how a window pinned to _stext reads as PASS.
  _at_pair=''
  for _at_src in "$_at_map" "$_at_img" "$_at_vml"; do
    _at_pair=$(sym_pair "$_at_src") && [ -n "$_at_pair" ] && break
    _at_pair=''
  done
  [ -n "$_at_pair" ] || return 0
  _at_lt=${_at_pair%% *}
  _at_ls=${_at_pair##* }
  _at_gap=$(hex_gap "$_at_lt" "$_at_ls") || return 0
  _at_lo=$(printf '%s' "$_at_st" | tr 'A-F' 'a-f')
  _at_hi=${_at_lo%????????}
  [ "$_at_lo" != "$_at_hi" ] || return 0
  _at_d=$(( 0x${_at_lo#"$_at_hi"} - _at_gap ))
  [ "$_at_d" -ge 0 ] || return 0
  printf '=== derived _text (booted vmlinux head gap) ===\n%s%08x T _text\n' \
    "$_at_hi" "$_at_d" >> "$_at_log"
}

# ---------------------------------------------------------------------------
# The record: every fact a boot establishes, extracted from its log exactly once.
#
# Two readers wanted these numbers -- the verdict printed after a boot and the
# rendered matrix -- and each dug them out of the log on its own. They had already
# drifted: the matrix substituted `_stext` for `_text` where the kernel exports no
# `_text`, which is a head gap above the quantity kasld solves, so a window pinned
# to `_stext` contains the very value it is checked against and the cell reads
# sound. The verdict refuses that substitution. One extractor removes the
# possibility of a second such disagreement.
#
# Facts only. The verdict is a FUNCTION of these fields (record_verdict), never a
# column, so a stored pass cannot outlive the numbers that justified it.
#
# Tab-separated, every field a single token, `-` where a boot established none:
#   1 sweep      the invocation that produced it, as a UTC stamp
#   2 repeat     which boot of that (cell, profile) within the sweep
#   3 cell       4 profile      5 done (yes|no: reached the end of its run)
#   6 release    7 source (alpine|mainline)     8 kaslr (on|off|unknown)
#   9 truth      the runtime _text the kernel published, or that was derived
#  10 vlo 11 vhi 12 vbits       the guaranteed virtual image-base window
#  13 plo 14 phi 15 pbits       the same on the physical axis
#  16 coupled    yes where text tracks the direct map, so phys is not independent
#  17 pverdict   18 rverdict    as phys_verdict / region_verdict report them
# ---------------------------------------------------------------------------
REC_FIELDS=18

# The index this boot takes in the ledger: one past the highest already recorded
# for this (sweep, cell, profile).
#
# The pass number cannot serve. It counts within one invocation, and a sweep is
# routinely several -- a full matrix is one invocation per profile, and boots
# added to a sweep later are another. Numbering from the pass number gave two
# records claiming to be boot 1 of the same pair, so (sweep, cell, profile, boot)
# was not a key: "boot 2 gave 13 bits" named two different boots, and anything
# filed under that tuple, an archived log included, would collide.
#
# Read per boot rather than counted in the shell, because a sweep is resumable:
# the ledger is the only thing that knows what a pair already has. Concurrent
# boots of ONE pair would race here, and cannot happen -- a cell is held by its
# lock for the duration of its run.
next_boot_index() { # sweep cell profile
  [ -f "$LEDGER" ] || { echo 1; return; }
  awk -F'\t' -v s="$1" -v c="$2" -v p="$3" '
    NF >= 4 && $1 == s && $3 == c && $4 == p && $2 + 0 > m { m = $2 + 0 }
    END { print m + 1 }' "$LEDGER"
}

extract_record() { # log cell profile sweep repeat
  _er_log=$1 _er_cell=$2 _er_prof=$3 _er_sweep=$4 _er_rep=$5

  _er_done=no
  grep -aq 'KASLD VM DONE' "$_er_log" && _er_done=yes

  _er_rel=$(grep -am1 'Linux version' "$_er_log" |
    sed -E 's/.*Linux version ([^ ]+).*/\1/')
  _er_flavor=$(printf '%s' "$TABLE" | awk -F'|' -v a="$_er_cell" \
    'NF>1{gsub(/ /,"",$1); if ($1==a) {gsub(/ /,"",$3); print $3; exit}}')
  _er_src=alpine; [ "$_er_flavor" = local ] && _er_src=mainline

  _er_dis=$(grep -am1 -oE '"disabled": *(true|false)' "$_er_log" | awk '{print $2}')
  case "$_er_dis" in true) _er_kaslr=off ;; false) _er_kaslr=on ;; *) _er_kaslr=unknown ;; esac

  # _text or nothing. _stext is a DIFFERENT symbol and substituting it compares
  # the window against the wrong address, in the direction that hides a failure.
  _er_truth=$(awk '/ _text$/{print $1; exit}' "$_er_log")
  [ -n "$_er_truth" ] && _er_truth=0x$_er_truth

  _er_vlo=$(grep -am1 -oE '"virt_image_base_min": *"0x[0-9a-fA-F]+"' "$_er_log" | grep -oE '0x[0-9a-fA-F]+')
  _er_vhi=$(grep -am1 -oE '"virt_image_base_max": *"0x[0-9a-fA-F]+"' "$_er_log" | grep -oE '0x[0-9a-fA-F]+')
  _er_vbits=$(bits_of "$_er_log")
  _er_plo=$(grep -am1 -oE '"phys_kaslr_text_min": *"0x[0-9a-fA-F]+"' "$_er_log" | grep -oE '0x[0-9a-fA-F]+')
  _er_phi=$(grep -am1 -oE '"phys_kaslr_text_max": *"0x[0-9a-fA-F]+"' "$_er_log" | grep -oE '0x[0-9a-fA-F]+')
  _er_pbits=$(phys_bits_of "$_er_log")

  _er_dec=$(grep -am1 -oE '"text_tracks_directmap": *(true|false)' "$_er_log" | awk '{print $2}')
  case "$_er_dec" in true) _er_coupled=yes ;; false) _er_coupled=no ;; *) _er_coupled=unknown ;; esac

  _er_pv=$(phys_verdict "$_er_log")
  _er_rv=$(region_verdict "$_er_log")

  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$_er_sweep" "$_er_rep" "$_er_cell" "$_er_prof" "$_er_done" \
    "${_er_rel:--}" "$_er_src" "$_er_kaslr" "${_er_truth:--}" \
    "${_er_vlo:--}" "${_er_vhi:--}" "${_er_vbits:--}" \
    "${_er_plo:--}" "${_er_phi:--}" "${_er_pbits:--}" \
    "$_er_coupled" "${_er_pv:--}" "${_er_rv:--}"
}

# Split one record into R_* for the readers below. A field count that does not
# match REC_FIELDS is a truncated or foreign line, which is refused rather than
# read: a short line would otherwise shift every field left of the one missing.
rec_read() { # record
  # Split in full, because it is a record: the gate below reads the containment
  # fields and the awk aggregation reads the rest by column number, so a reader
  # that dropped what this shell does not name would have to be edited every time
  # a consumer appeared.
  R_sweep='' R_repeat='' R_cell='' R_profile='' R_done='' R_release=''
  R_source='' R_kaslr='' R_truth='' R_vlo='' R_vhi='' R_vbits='' R_plo=''
  R_phi='' R_pbits='' R_coupled='' R_pverdict='' R_rverdict=''
  [ "$(printf '%s' "$1" | awk -F'\t' '{print NF}')" = "$REC_FIELDS" ] || return 1
  # shellcheck disable=SC2034  # the fields this shell does not name are read by
  # ledger_rows, in awk, by column position
  IFS="$(printf '\t')" read -r R_sweep R_repeat R_cell R_profile R_done \
    R_release R_source R_kaslr R_truth R_vlo R_vhi R_vbits R_plo R_phi \
    R_pbits R_coupled R_pverdict R_rverdict <<EOF
$1
EOF
}

# The verdict for the record in R_*: one word, then a detail. Computed from the
# facts every time rather than stored beside them, so the two cannot drift.
# Gates BOTH axes and the RANDOMIZE_MEMORY region bases.
record_verdict() {
  [ "$R_done" = yes ] || { echo "INCOMPLETE  boot did not finish"; return 1; }
  if [ "$R_truth" = - ]; then
    echo "UNVERIFIED  no _text truth (kernel exports none; no symbol map to derive it)"
    return 2
  fi
  if [ "$R_vlo" = - ] || [ "$R_vhi" = - ]; then
    echo "N/A   truth=$R_truth window=[-,-] kaslr=$R_kaslr phys=$R_pverdict"
    return 0
  fi
  _rv_t=$(norm "$R_truth"); _rv_lo=$(norm "$R_vlo"); _rv_hi=$(norm "$R_vhi")
  if hexle "$_rv_lo" "$_rv_t" && hexle "$_rv_t" "$_rv_hi"; then :; else
    echo "FAIL  truth=$R_truth OUTSIDE [$R_vlo,$R_vhi] — soundness violation (phys=$R_pverdict)"
    return 1
  fi
  case "$R_pverdict" in
  N) echo "FAIL  phys base OUTSIDE resolved window — soundness violation (virt truth=$R_truth ∈ [$R_vlo,$R_vhi])"
     return 1 ;;
  X) echo "FAIL  phys base EXCLUDED by a carved sub-range of the resolved window — soundness violation (virt truth=$R_truth ∈ [$R_vlo,$R_vhi])"
     return 1 ;;
  esac
  case "$R_rverdict" in
  N:*) echo "FAIL  region ${R_rverdict#N:} OUTSIDE resolved window — soundness violation (text/phys sound)"
       return 1 ;;
  \?:*) echo "FAIL  region ${R_rverdict#?:} truth captured but no resolved window to gate it against"
        return 1 ;;
  esac
  _rv_rec=N; [ "$_rv_lo" = "$_rv_hi" ] && _rv_rec=Y
  echo "PASS  truth=$R_truth ∈ [$R_vlo,$R_vhi] recovered=$_rv_rec phys=$R_pverdict region=$R_rverdict"
  return 0
}

# Record one boot in the ledger and report its verdict. The ledger is append-only
# and one line per boot, which is what lets a cell be booted several times and the
# spread of its results be read back, and archive_log keeps that boot's own log
# beside the record indexing it.
#
# Facts are extracted once, here, and the verdict computed from them -- so the
# line printed after a boot and the row rendered from the ledger are the same
# judgement of the same numbers rather than two readings of one log.
# Keep this boot's log beside the record that indexes it.
#
# The live log is one file per (cell, profile), and the next boot of that pair
# overwrites it. That was invisible while a pair was only ever booted once; over
# a sweep of fifteen it means the surviving log is whichever boot happened to run
# last, which for a cell whose boots disagree is rarely the one worth reading --
# the ledger records that some boot gave 12 bits while the log sitting beside it
# is a 14-bit boot. The numbers survive in the record; everything else about that
# boot, the component list and the dmesg and the full document, does not.
#
# Every boot is kept, with no judgement about which are interesting. A log is
# ~90 KB and compresses fourfold, so a whole sweep of them costs a fraction of
# one cached kernel image: there is nothing to ration, and a rule picking the
# boots worth keeping would be deciding now which question gets asked later.
#
# Named by the same sweep and index the record carries, so a row of the ledger
# names exactly one file.
archive_log() { # log cell profile sweep index
  [ -f "$1" ] || return 0
  _al_dir=$(dirname "$1")/logs
  mkdir -p "$_al_dir" 2>/dev/null || return 0
  gzip -c "$1" >"$_al_dir/$4-$3-$5.log.gz" 2>/dev/null || true
}

verdict() { # log cell profile sweep
  _v_idx=$(next_boot_index "$4" "$2" "$3")
  archive_log "$1" "$2" "$3" "$4" "$_v_idx"
  _v_rec=$(extract_record "$1" "$2" "$3" "$4" "$_v_idx")
  printf '%s\n' "$_v_rec" >> "$LEDGER"
  rec_read "$_v_rec" || { echo "INCOMPLETE  (could not record this boot)"; return 1; }
  record_verdict
}

# Remove host/build identity the capture inherits from the machine it ran on:
# qemu `-cpu max` passes the host CPU brand into /proc/cpuinfo, and a locally
# built kernel embeds "builduser@buildhost" in /proc/version. Strip only those
# identifying strings — the addresses (truth), CPU flags and "address sizes"
# (which the inference reads) are kept. Distro kernels' version build-tags
# (e.g. Alpine's buildozer@...) are non-sensitive but scrubbed uniformly.
scrub_host_identity() {
  _s=$1
  # /proc/cpuinfo under qemu `-cpu max` is a host CPU fingerprint (brand,
  # vendor, family/model/stepping, flags, MHz, cache). The inference reads only
  # "address sizes"; keep that plus the structural "processor" index and drop
  # the rest. Arch-generic: on arches without "address sizes" (arm64/riscv/...)
  # this leaves the processor lines, which the analysis reads nothing from.
  _ci="$_s/proc/cpuinfo"
  if [ -f "$_ci" ]; then
    grep -iE '^(processor|address sizes)[[:space:]]*:' "$_ci" > "$_ci.t" 2>/dev/null
    if [ -s "$_ci.t" ]; then mv "$_ci.t" "$_ci"; else rm -f "$_ci.t"; fi
  fi
  _hn=$(hostname 2>/dev/null)
  for _f in "$_s/proc/version" "$_s/proc/cmdline"; do
    [ -f "$_f" ] || continue
    sed -E 's/\([^ ()@]+@[^ ()@]+\)/(builder@host)/g' "$_f" > "$_f.t" 2>/dev/null &&
      mv "$_f.t" "$_f"
    [ -n "$_hn" ] && { sed "s/$_hn/host/g" "$_f" > "$_f.t" 2>/dev/null && mv "$_f.t" "$_f"; }
  done

  # Device tree (arm/ppc/riscv/mips): the captured flattened blob can carry a
  # board serial-number / MAC. Scrub via extra/anonymize-fdt, which round-trips
  # through dtc and preserves the kaslr-seed the inference reads. Abort the
  # fixture rather than commit an unscrubbed blob if dtc is missing.
  _fdt="$_s/sys/firmware/fdt"
  if [ -f "$_fdt" ]; then
    if command -v dtc >/dev/null 2>&1; then
      "$ROOT/extra/anonymize-fdt" "$_fdt" >/dev/null 2>&1 || true
      rm -f "$_fdt.orig"
    else
      echo "  !! dtc not found — refusing to keep an unscrubbed /sys/firmware/fdt" >&2
      rm -f "$_fdt"
      return 1
    fi
  fi
}

# capture: reconstruct a truth-bearing fixture from a capture-mode boot log.
# Args: name flavor prefix log kimg
# Decodes the guest's KCAPv1 frames into a path-preserving sysroot mirror, adds
# meta.txt + sizes.txt (+ the boot image's size and 4 KiB header, taken
# host-side from the cached vmlinuz), and installs it under
# tests/fixtures/<canonical-arch>/<distro>-<release>/. Unlike the committed
# corpus these carry real kallsyms + iomem (captured as root, kptr=0), so
# extra/validate-bundle can check truth ∈ resolved window.
reconstruct_fixture() {
  _name=$1 _flavor=$2 _prefix=$3 _log=$4 _kimg=$5
  grep -aq 'KCAPv1 DONE' "$_log" || {
    echo "  CAPTURE FAIL  (no KCAPv1 DONE marker; see $_log)"; return 1; }

  _tmp=$(mktemp -d) || return 1
  _sr="$_tmp/sysroot"; mkdir -p "$_sr"

  # Split the framed capture into per-file base64 blobs + a manifest
  # ("<idx> <nbytes> <path>"), and pull the META release/machine lines.
  awk -v dir="$_tmp" '
    /^KCAPv1 META release / { print $4 > (dir "/release"); next }
    /^KCAPv1 META machine / { print $4 > (dir "/machine"); next }
    /^KCAPv1 BEGIN / { path=$3; n++; f=sprintf("%s/f%04d.b64", dir, n); printf "" > f; next }
    /^KCAPv1 END /   { printf "%04d %s %s\n", n, $4, path >> (dir "/manifest"); close(f); path=""; next }
    /^KCAPv1 DONE/   { exit }
    path != ""       { print > f }
  ' "$_log"

  [ -s "$_tmp/manifest" ] || {
    echo "  CAPTURE FAIL  (no frames parsed from $_log)"; rm -rf "$_tmp"; return 1; }

  # Decode each frame into the sysroot, verifying the byte count.
  _ok=0; _bad=0
  while read -r idx nbytes path; do
    dst="$_sr$path"
    mkdir -p "$(dirname "$dst")" || continue
    if base64 -d "$_tmp/f$idx.b64" > "$dst" 2>/dev/null; then
      got=$(wc -c < "$dst" | tr -d ' ')
      if [ "$got" = "$nbytes" ]; then _ok=$((_ok + 1)); else
        echo "  !! size mismatch $path: got $got want $nbytes"; _bad=$((_bad + 1)); fi
    else
      echo "  !! decode failed $path"; rm -f "$dst"; _bad=$((_bad + 1)); fi
  done < "$_tmp/manifest"

  scrub_host_identity "$_sr"

  _rel=$(cat "$_tmp/release" 2>/dev/null)
  _mach=$(cat "$_tmp/machine" 2>/dev/null)
  [ -n "$_rel" ] || { echo "  CAPTURE FAIL  (no kernel release captured)"; rm -rf "$_tmp"; return 1; }

  # uname -m on MIPS carries no endianness — BE and LE both report `mips` /
  # `mips64` — so validate-bundle and replay would resolve the wrong-endian
  # binary. The build prefix does encode it (mips / mipsel / mips64el) and
  # matches their arch keys; use it for MIPS. The `endianness:` field below
  # states the same fact for every arch and is what a capture made by
  # extra/collect (which only has the blind `uname -m`) relies on.
  _uname=${_mach:-$_prefix}
  case "$_prefix" in
  mips | mipsel | mips64 | mips64el) _uname=$_prefix ;;
  esac
  # flavor=local => a mainline kernel.org build; else an Alpine distro kernel.
  _canon=$(kasld_arch_for "$_prefix")
  if [ "$_flavor" = local ]; then _distro="mainline"; else _distro="alpine-$ALPINE_VER"; fi
  # A cell name is <prefix>-<flavor>-<version>[-<variant>]; the variant is what
  # makes the boot non-default (a VA size, a VMSPLIT). It has to reach the
  # fixture id: without it a variant cell and its default sibling resolve to the
  # same directory, and the capture rm -rf's the destination first, so whichever
  # ran last would silently be the one kept.
  _variant=$(printf '%s' "$_name" | cut -s -d- -f4-)

  # Byte order, read from the booted image's ELF header rather than a table of
  # which cell is which: EI_DATA is the kernel's own statement of it. The image
  # first, where it is an ELF. Not every arch boots one: arm stages a zImage and
  # riscv an Image, which carry no EI_DATA, so the read there yields neither 01
  # nor 02. The cell's own kasld is the fallback -- built by the target's
  # toolchain, so its byte order is the target's by construction. The spelling
  # is the one extra/collect records, since both fill the same meta field.
  _endian=unknown
  for _e_src in "$_kimg" $(ls "$BUILD_DIR/$_prefix"-*/kasld 2>/dev/null); do
    [ -f "$_e_src" ] || continue
    case "$(od -An -tx1 -j5 -N1 "$_e_src" 2>/dev/null | tr -d ' ')" in
    01) _endian=little; break ;;
    02) _endian=big; break ;;
    esac
  done

  # The id carries it on the arch directories that can hold both orders. There
  # is no per-arch header for an endianness -- mips32.h serves mips and mipsel
  # alike -- so it is a property of the capture, not an architecture, and
  # belongs in the id beside the variant. Without it the two orders resolve to
  # one directory and the capture rm -rf's it: ppc64 already holds a ppc64 and
  # a ppc64le bundle, kept apart only by their release strings happening to
  # differ.
  _esuf=
  case "$_canon" in
  arm32 | ppc32 | ppc64 | mips32 | mips64)
    case "$_endian" in little) _esuf=el ;; big) _esuf=eb ;; esac
    [ -n "$_esuf" ] ||
      echo "  !! $_name: byte order undetermined; fixture id will not carry it" >&2
    ;;
  esac

  _fid=$(printf '%s-%s%s%s' "$_distro" "$_rel" "${_esuf:+-$_esuf}" \
    "${_variant:+-$_variant}" | sed 's/[^A-Za-z0-9._-]/-/g')

  # Boot image: size (sizes.txt) + 4 KiB header prefix, taken host-side from the
  # kernel we booted — mirrors extra/collect's boot_image "hdr" mode.
  if [ -f "$_kimg" ]; then
    _isz=$(stat -c %s "$_kimg" 2>/dev/null || stat -f %z "$_kimg" 2>/dev/null)
    printf '%s /boot/vmlinuz-%s\n' "$_isz" "$_rel" > "$_tmp/sizes.txt"
    mkdir -p "$_sr/boot"
    dd if="$_kimg" of="$_sr/boot/vmlinuz-$_rel" bs=4096 count=1 2>/dev/null || true
  else
    : > "$_tmp/sizes.txt"
  fi

  _tvt=$(runtime_text_truth "$_kimg" "$_sr/proc/kallsyms" \
    "$CACHE/$_name-System.map" "$CACHE/kbuild-$_name/vmlinux")

  _kbin=""
  for _c in "$BUILD_DIR/$_prefix"-*/kasld; do [ -x "$_c" ] && { _kbin=$_c; break; }; done
  _kid=unknown
  [ -n "$_kbin" ] && _kid=$("$_kbin" --version 2>/dev/null | head -1)
  {
    echo "collect_version:  1"
    echo "collected_utc:    $(date -u 2>/dev/null || echo unknown)"
    echo "uname_m_raw:      $_uname"
    echo "endianness:       $_endian"
    echo "arch_canonical:   $_canon"
    echo "kernel_release:   $_rel"
    echo "distro:           $_distro"
    echo "kasld:            $_kid"
    echo "suggested_fixture: tests/fixtures/$_canon/$_fid/"
    echo "anonymized:       0"
    echo "host_scrubbed:    1"
    echo "kallsyms:         1"
    echo "source:           vm ($_name)"
    # Only where the kernel withholds _text from kallsyms; elsewhere the sysroot
    # already carries it, and a second copy is a second thing to keep true.
    if [ -n "$_tvt" ]; then
      echo "truth_virt_text:  $_tvt"
      echo "truth_virt_text_source: booted vmlinux symtab (_stext - head gap)"
    fi
  } > "$_tmp/meta.txt"

  dest="$ROOT/tests/fixtures/$_canon/$_fid"
  rm -rf "$dest"; mkdir -p "$dest"
  mv "$_sr" "$dest/sysroot"
  mv "$_tmp/meta.txt" "$dest/meta.txt"
  mv "$_tmp/sizes.txt" "$dest/sizes.txt"
  rm -rf "$_tmp"
  printf '  %-11s CAPTURE %s files (%s bad) -> tests/fixtures/%s/%s/\n' \
    "$_name" "$_ok" "$_bad" "$_canon" "$_fid"
  [ "$_bad" = 0 ]
}

# The kernel release a cell's STAGED image actually boots: the release recorded
# beside the image, else the image's own banner, else its newest boot log.
#
# The image outranks any log. A log says what booted when it was written, so a
# cell restaged since then keeps older logs naming the kernel it used to run —
# and those logs outlive the image they describe. Logs come last, newest first,
# because the banner does not survive every image format.
staged_release() { # cell
  [ -s "$CACHE/$1-kernel.release" ] && { cat "$CACHE/$1-kernel.release"; return 0; }
  _r=$(strings -a "$CACHE/$1-vmlinuz" 2>/dev/null |
    grep -m1 -oE '[0-9]+\.[0-9]+\.[0-9]+[^ ]* \(.*\) #' | grep -oE '^[^ ]+')
  [ -n "$_r" ] && { echo "$_r"; return 0; }
  # shellcheck disable=SC2012  # boot-<scenario>.log names are fixed by this script
  _newest=$(ls -t "$HERE/$1"/boot-*.log 2>/dev/null | head -1)
  [ -n "$_newest" ] || return 1
  grep -ahm1 -oE 'Linux version [^ ]+' "$_newest" | sed 's/Linux version //'
}

# Stage loadable modules for a DISTRO cell, taken from the same published build
# that produced its kernel. Nothing is compiled: the distro already built these
# against this exact kernel, so vermagic and the symbol CRCs match by
# construction — which is what finit_module() checks.
#
# Two sources, mirroring the two kernel-fetch paths:
#   netboot flavors  modloop-<flavor>, a squashfs beside vmlinuz-<flavor>
#   apk flavor       the linux-lts apk the kernel itself came from
#
# The release inside the artifact is compared against the staged kernel's before
# anything is staged. A mirror serves what is current, not what was fetched, so
# the two drift apart on their own; a module built for another release is
# rejected at load: init logs it FAILED and continues, so it silently fails to
# load rather than giving a readable error. Mismatch therefore refuses, and says so.
fetch_modules_distro() { # cell alpine-arch flavor
  _cell=$1 _aarch=$2 _flavor=$3
  _want=$(staged_release "$_cell")
  [ -n "$_want" ] || { echo "  !! $_cell: cannot determine the staged kernel release"; return 1; }

  _tmp=$(mktemp -d) || return 1
  if [ "$_flavor" = apk ]; then
    _repo="$ALPINE_MIRROR/edge/main/$_aarch"
    _apk=$(curl -fsSL "$_repo/" | grep -oE 'linux-lts-[0-9][^"<]*\.apk' | sort -V | tail -1)
    [ -n "$_apk" ] || { echo "  !! $_cell: no linux-lts apk for $_aarch"; rm -rf "$_tmp"; return 1; }
    curl -fsSL -o "$_tmp/k.apk" "$_repo/$_apk" || { rm -rf "$_tmp"; return 1; }
    (cd "$_tmp" && tar -xzif k.apk --wildcards \
      'lib/modules/*/kernel/drivers/net/dummy.ko*' \
      'lib/modules/*/kernel/drivers/net/veth.ko*' 2>/dev/null)
  else
    _url="$ALPINE_MIRROR/v$ALPINE_VER/releases/$_aarch/netboot/modloop-$_flavor"
    curl -fsSL -o "$_tmp/modloop" "$_url" || {
      echo "  !! $_cell: no modloop at $_url"
      rm -rf "$_tmp"
      return 1
    }
    unsquashfs -q -d "$_tmp/x" "$_tmp/modloop" \
      'modules/*/kernel/drivers/net/dummy.ko*' \
      'modules/*/kernel/drivers/net/veth.ko*' \
      'lib/modules/*/kernel/drivers/net/dummy.ko*' \
      'lib/modules/*/kernel/drivers/net/veth.ko*' >/dev/null 2>&1
  fi

  # The release the artifact itself carries, read from the path it unpacked into
  # rather than from the cell name or the mirror's directory.
  _got=$(find "$_tmp" -name '*.ko*' 2>/dev/null | head -1 |
    sed -E 's|.*/modules/([^/]+)/.*|\1|')
  if [ -z "$_got" ]; then
    echo "  !! $_cell: no dummy/veth module in the published $_flavor artifact"
    rm -rf "$_tmp"
    return 1
  fi
  if [ "$_got" != "$_want" ]; then
    echo "  !! $_cell: mirror serves $_got, staged kernel is $_want — refetch the kernel and the modules together"
    rm -rf "$_tmp"
    return 1
  fi

  mkdir -p "$CACHE/$_cell-modules"
  _n=0
  find "$_tmp" -name '*.ko*' 2>/dev/null >"$_tmp/list"
  while IFS= read -r _k; do
    _b=${_k##*/}
    case "$_b" in
    # A distro may ship modules compressed; finit_module() takes plain ELF.
    *.ko.gz) gunzip -c "$_k" >"$CACHE/$_cell-modules/${_b%.gz}" || continue ;;
    *.ko.zst) zstd -qdc "$_k" >"$CACHE/$_cell-modules/${_b%.zst}" || continue ;;
    *.ko.xz) xz -dc "$_k" >"$CACHE/$_cell-modules/${_b%.xz}" || continue ;;
    *.ko) cp "$_k" "$CACHE/$_cell-modules/$_b" ;;
    *) continue ;;
    esac
    _n=$((_n + 1))
  done <"$_tmp/list"
  rm -rf "$_tmp"
  [ "$_n" -gt 0 ] || { echo "  !! $_cell: nothing staged"; return 1; }
  echo "$_want" >"$CACHE/$_cell-kernel.release"
  printf '  %-26s %s  (%s)\n' "$_cell" "$_want" \
    "$(find "$CACHE/$_cell-modules" -name '*.ko' -exec basename {} \; | tr '\n' ' ')"
}

# Stage distro-cell modules. Cells default to every non-`local` cell with a
# staged kernel.
cmd_fetch_modules() {
  _sel=$*
  _ok=0 _fail=0
  for _a in ${_sel:-$arches}; do
    _row=$(echo "$TABLE" | grep -E "^[[:space:]]*${_a}[[:space:]]*\|")
    [ -n "$_row" ] || continue
    IFS='|' read -r _ _aa _fl _ _ _ _ <<EOF
$_row
EOF
    _aa=$(trim "$_aa"); _fl=$(trim "$_fl")
    [ "$_fl" = local ] && continue
    [ -f "$CACHE/$_a-vmlinuz" ] || continue
    if fetch_modules_distro "$_a" "$_aa" "$_fl"; then
      _ok=$((_ok + 1))
    else
      _fail=$((_fail + 1))
    fi
  done
  echo "----------------------------------------------------------------------"
  echo "modules: $_ok staged, $_fail unavailable"
  [ "$_fail" -eq 0 ]
}

# The kasld binary a cell would run. Unlike resolve_target this does not need the
# cell's toolchain on PATH, because inspecting a binary does not require building
# one.
cell_binary() {
  _p=$(printf '%s' "$TABLE" | awk -F'|' -v a="$1" \
    'NF>1{gsub(/ /,"",$1); if ($1==a) {gsub(/ /,"",$4); print $4; exit}}')
  [ -n "$_p" ] || return 1
  for _d in "$BUILD_DIR/$_p"-*; do
    [ -x "$_d/kasld" ] || continue
    echo "$_d/kasld"
    return 0
  done
  return 1
}

# True when a binary is big-endian arm WITHOUT EF_ARM_BE8, i.e. BE32
# (word-invariant byte order). Big-endian arm kernels from ARMv6 on run userspace
# BE8 (byte-invariant), so a BE32 binary faults on its first instruction and the
# process dies with SIGILL before main() — the kernel boots, the payload cannot
# run. Detected from the ELF header rather than the cell name, so the cell starts
# working by itself if a BE8 toolchain is installed.
arm_be32_binary() {
  [ -f "$1" ] || return 1
  [ "$(od -An -tx1 -j5 -N1 "$1" 2>/dev/null | tr -d ' ')" = 02 ] || return 1
  [ "$(od -An -tx1 -j18 -N2 "$1" 2>/dev/null | tr -d ' ')" = 0028 ] || return 1
  _fl=$(od -An -tx1 -j36 -N4 "$1" 2>/dev/null | tr -d ' ')
  [ ${#_fl} -eq 8 ] || return 1
  [ $((0x$_fl & 0x00800000)) -eq 0 ]
}

# Stage the cell's initramfs: the tree the guest boots into, and the image made
# from it. Reads the caller's $work / $bdir / $name, as the rest of run_one does.
stage_image() {
  rm -rf "$work/root"
  mkdir -p "$work/root/proc" "$work/root/sys" "$work/root/dev" "$work/root/tmp" "$work/root/components"
  cp "$work/init.bin" "$work/root/init"
  cp "$bdir/kasld" "$work/root/kasld"
  cp "$CACHE/$name-vmlinuz" "$work/root/kernel-image"
  cp "$bdir"/components/* "$work/root/components/" 2>/dev/null || true
  # The kernel's own .config as /boot/config-<release>, what a real system
  # exposes. boot_config reads it as plain text (proc_config's /proc/config.gz
  # needs the zlib the static cross binaries lack), so this is what runs the
  # PAGE_OFFSET_FROM_CONFIG path end-to-end on the VMSPLIT arches. Keyed on the
  # staged kernel's release so boot_config's uname-r match holds.
  _kcfg="$CACHE/kbuild-$name/.config"; _krel=$(cat "$CACHE/$name-kernel.release" 2>/dev/null)
  if [ -n "$_krel" ] && [ -f "$_kcfg" ]; then
    mkdir -p "$work/root/boot"
    cp "$_kcfg" "$work/root/boot/config-$_krel"
  fi
  # Modules the cell's kernel build staged, if any. init loads every .ko here
  # before the run, so /proc/modules and /sys/module carry real addresses.
  if [ -d "$CACHE/$name-modules" ]; then
    mkdir -p "$work/root/modules"
    cp "$CACHE/$name-modules"/*.ko "$work/root/modules/" 2>/dev/null || true
  fi
  chmod +x "$work/root/init" "$work/root/kasld" "$work/root/components/"* 2>/dev/null || true
  # gzip -1: the guest decompresses this in memory and the image is ~40 MiB of
  # already-compact static binaries, where -9 spends seconds of host CPU per
  # staging to save a fraction of a second of guest boot.
  (cd "$work/root" && find . -print0 | cpio --null -o --format=newc 2>/dev/null | gzip -1 >"$work/initramfs.cpio.gz")
}

# Build + boot one arch in one mode. Returns the verdict's status.
run_one() {
  name=$1 mode=$2
  row=$(echo "$TABLE" | grep -E "^[[:space:]]*${name}[[:space:]]*\|")
  [ -n "$row" ] || { echo "$name: unknown arch"; return 2; }
  IFS='|' read -r _ aarch flavor prefix qsuf machine console <<EOF
$row
EOF
  aarch=$(trim "$aarch"); flavor=$(trim "$flavor"); prefix=$(trim "$prefix")
  qsuf=$(trim "$qsuf"); machine=$(trim "$machine"); console=$(trim "$console")

  # Guest RAM. Default 1 GiB; the qemu malta board (mips) caps at 256 MiB.
  mem=1024; case "$name" in mips | mipsel | mips64 | mips64el) mem=256 ;; ppc32*) mem=512 ;; esac

  echo "=================== $name ($mode) ==================="
  tc=$(resolve_target "$prefix")
  [ -n "$tc" ] || { echo "  SKIP  no build/$prefix-*/kasld with toolchain on PATH (run make cross)"; return 3; }
  bdir=${tc% *}; cc=${tc#* }
  if arm_be32_binary "$bdir/kasld"; then
    echo "  SKIP  $(basename "$bdir") emits BE32; a big-endian arm kernel runs userspace BE8, so kasld cannot execute"
    return 3
  fi
  qemu=$(resolve_qemu "$qsuf")
  [ -n "$qemu" ] || { echo "  SKIP  qemu-system-$qsuf not found"; return 3; }

  work=$HERE/$name
  mkdir -p "$work"
  fetch_kernel "$name" "$aarch" "$flavor" "$CACHE/$name-vmlinuz" || { echo "  SKIP  no kernel"; return 3; }

  # The payload has to match the kernel's userspace byte order, not just the
  # toolchain's default. A big-endian arm kernel from ARMv6 on runs userspace
  # BE8, and an armeb toolchain emits BE32 unless asked: init then takes SIGILL
  # on its first instruction and the kernel panics killing pid 1, which reads as
  # a boot failure rather than a build one. Same requirement `make cross` applies
  # to the kasld binary this init execs.
  _initf=
  case "$cc" in
  *armeb-*) _initf=-mbe8 ;;
  esac
  # Rebuilt only when its source or its compiler is newer than it, so that the
  # binary's timestamp stays a fact about its inputs -- the staged-image check
  # below reads it as one, and an unconditional compile would make every run look
  # like a changed input.
  _initsrc=$(command -v "$cc" 2>/dev/null)
  _initold=0
  [ -f "$work/init.bin" ] || _initold=1
  for _in in "$HERE/init.c" $_initsrc; do
    [ -e "$_in" ] || continue
    [ -n "$(find "$_in" -newer "$work/init.bin" -print -quit 2>/dev/null)" ] && _initold=1
  done
  if [ "$_initold" = 1 ]; then
    # shellcheck disable=SC2086  # $_initf is one optional flag, deliberately split
    "$cc" -O2 -static $_initf -o "$work/init.bin" "$HERE/init.c" || { echo "  !! init build failed ($cc)"; return 2; }
  fi

  # The staged tree and the image built from it do not depend on the mode: the
  # profile travels on the kernel command line, not in the initramfs. So a cell
  # swept through several profiles stages once, and restages only when one of its
  # inputs is newer than the image. `find -newer` rather than `test -nt`, which
  # is not in POSIX test.
  _stale=0
  if [ ! -f "$work/initramfs.cpio.gz" ]; then
    _stale=1
  else
    for _in in "$work/init.bin" "$bdir/kasld" "$bdir/components" \
               "$CACHE/$name-vmlinuz" "$CACHE/kbuild-$name/.config" \
               "$CACHE/$name-kernel.release" "$CACHE/$name-modules"; do
      [ -e "$_in" ] || continue
      if [ -n "$(find "$_in" -newer "$work/initramfs.cpio.gz" -print -quit 2>/dev/null)" ]; then
        _stale=1
        break
      fi
    done
  fi
  if [ "$_stale" = 0 ]; then
    echo "  [*] reusing the staged initramfs (inputs unchanged)"
  else
    stage_image || return 2
  fi

  # Some boards need firmware the qemu binary does not bundle. Discover it next to
  # the resolved qemu (a from-source build keeps it in pc-bios/), in the usual
  # system share dirs, or in the distro's cross opensbi package — overridable per
  # arch. The firmware must match the qemu that loads it.
  #   loongarch64 — boots via UEFI; its kernel is an EFI PE needing an edk2 image.
  #   riscv32     — qemu ships only the riscv64 OpenSBI; supply the 32-bit one.
  bios=""
  if [ "${name%%-*}" = loongarch64 ]; then
    fw=${LOONGARCH_BIOS:-}
    if [ -z "$fw" ]; then
      for c in "$(dirname "$qemu")/pc-bios/edk2-loongarch64-code.fd" \
               /usr/share/qemu/edk2-loongarch64-code.fd \
               /usr/share/edk2/loongarch64/QEMU_EFI.fd; do
        [ -f "$c" ] && { fw=$c; break; }
      done
    fi
    [ -n "$fw" ] && bios="-bios $fw"
  elif [ "${name%%-*}" = riscv32 ]; then
    fw=${RISCV32_BIOS:-}
    if [ -z "$fw" ]; then
      for c in "$(dirname "$qemu")/pc-bios/opensbi-riscv32-generic-fw_dynamic.bin" \
               /usr/share/qemu/opensbi-riscv32-generic-fw_dynamic.bin \
               /usr/lib/riscv32-linux-gnu/opensbi/generic/fw_dynamic.bin; do
        [ -f "$c" ] && { fw=$c; break; }
      done
    fi
    [ -n "$fw" ] && bios="-bios $fw"
  fi

  # Opportunistic hardware acceleration: when the guest matches the host arch and
  # /dev/kvm is usable, KVM makes the boot near-native and immune to host load.
  # Foreign arches stay on TCG emulation (slow but correct). KVM is happy with
  # the table's `-cpu max`.
  accel=""
  if [ -w /dev/kvm ]; then
    case "$qsuf:$(uname -m)" in
      x86_64:x86_64 | i386:x86_64 | i386:i686 | aarch64:aarch64) accel="-enable-kvm" ;;
    esac
  fi

  # riscv text KASLR needs a boot-supplied seed. QEMU's `virt` DTB carries only
  # rng-seed, so a kernel built with RANDOMIZE_BASE finds no kaslr-seed and boots
  # at its link address. For the cells actually built with it (grep the staged
  # .config — Alpine ships no such config, and trees predating riscv KASLR never
  # gain the symbol), dump QEMU's generated DTB, splice a fresh per-boot
  # /chosen/kaslr-seed, and boot from the patched blob so the text base is
  # randomized. QEMU still applies its own bootargs/initrd fixups over a supplied
  # -dtb, so the cmdline and initramfs are unaffected. dtc is required; without it
  # the seed is skipped and the kernel boots unrandomized (still sound, KASLR-off).
  dtb=""
  cfg="$CACHE/kbuild-$name/.config"
  if [ "${name%%-*}" = riscv64 ] && [ -f "$cfg" ] &&
     grep -q '^CONFIG_RANDOMIZE_BASE=y' "$cfg"; then
    if command -v dtc >/dev/null 2>&1; then
      _raw="$work/qemu.dtb"; _seeded="$work/kaslr-seed.dtb"
      rm -f "$_raw" "$_seeded"
      # shellcheck disable=SC2086
      $qemu $machine -smp 1 -m "$mem" $bios -machine dumpdtb="$_raw" -nographic \
        >/dev/null 2>&1
      if [ -f "$_raw" ]; then
        _hi=$(od -An -N4 -tx4 /dev/urandom | tr -d ' ')
        _lo=$(od -An -N4 -tx4 /dev/urandom | tr -d ' ')
        dtc -I dtb -O dts "$_raw" 2>/dev/null |
          awk -v s="0x$_hi 0x$_lo" \
            '/chosen \{/{print; print "\t\tkaslr-seed = <" s ">;"; next} {print}' |
          dtc -I dts -O dtb -o "$_seeded" 2>/dev/null
        [ -f "$_seeded" ] && dtb="-dtb $_seeded"
      fi
    else
      echo "  !! dtc not found — riscv64 kaslr-seed skipped (boots unrandomized)" >&2
    fi
  fi

  append="console=$console panic=-1 quiet"
  case "$mode" in
    default)     ;;
    kptr-hidden) append="$append hidekptr" ;;
    perf-open)   append="$append perfopen" ;;
    dmesg-open)  append="$append dmesgopen" ;;
    bpf-open)    append="$append bpfopen" ;;
    tracefs-open) append="$append tracefsopen" ;;
    hardened)    append="$append hardened" ;;
    nokaslr)     append="$append nokaslr" ;;
    no5lvl)      append="$append no5lvl" ;;
    no4lvl)      append="$append no4lvl" ;;
    la57)        accel="-accel tcg" ;;
    capture)     append="$append capture" ;;
    *) echo "  unknown mode: $mode"; return 2 ;;
  esac

  # The second, human-readable analysis pass (the address-space map) doubles a
  # boot's analysis cost and nothing reads its output — the verdicts and the
  # matrix come from the -j document. What it covers is the layout renderer on an
  # architecture the host is not, which a cell exercises once: the `default`
  # profile draws it, the others do not. VM_MAP=1 draws it on every profile and
  # VM_MAP=0 on none.
  case "${VM_MAP:-$([ "$mode" = default ] && echo 1 || echo 0)}" in
    1) append="$append drawmap" ;;
  esac

  # Anything in KASLD_VM_APPEND is appended verbatim to the kernel command line.
  # The kernel hands unrecognised `key=value` tokens to init as ENVIRONMENT, and
  # init execv()s kasld, so this is how a diagnostic env var reaches the binary
  # inside the guest without touching init.c:
  #   KASLD_VM_APPEND=KASLD_DEBUG_CONSTRAINTS=1 tests/vm/run <cell> default
  [ -z "${KASLD_VM_APPEND:-}" ] || append="$append $KASLD_VM_APPEND"

  log="$work/boot-$mode.log"
  echo "  [*] booting $qemu ($machine) -> $log"
  # shellcheck disable=SC2086
  timeout "$TIMEOUT" $qemu $machine $accel -smp 1 -m "$mem" $bios $dtb \
    -kernel "$CACHE/$name-vmlinuz" -initrd "$work/initramfs.cpio.gz" \
    -nographic -no-reboot -append "$append" >"$log" 2>&1 || true
  # Strip CR and NUL bytes: early console output can contain binary noise that
  # makes grep treat the log as binary and skip matches.
  tr -d '\r\000' <"$log" >"$log.clean" && mv "$log.clean" "$log"
  # A verdict with no _text compares the window against _stext, which is a head
  # gap above the quantity kasld solves -- it reads PASS while the true base sits
  # outside the window. Say so: an unverifiable cell must not look like a clean
  # one, the same way a missing toolchain SKIPs loudly rather than passing.
  if append_text_truth "$log" "$CACHE/$name-vmlinuz" \
    "$CACHE/$name-System.map" "$CACHE/kbuild-$name/vmlinux"; then :; fi
  if ! grep -aq ' _text$' "$log" 2>/dev/null && grep -aq ' _stext$' "$log" 2>/dev/null; then
    echo "  !! $name: kernel exports no _text and no vmlinux to derive it from" >&2
    echo "     (build it: tests/vm/build-kernel $name) — the verdict below" >&2
    echo "     compares the window against _stext, a head gap too high" >&2
  fi

  if [ "$mode" = capture ]; then
    reconstruct_fixture "$name" "$flavor" "$prefix" "$log" "$CACHE/$name-vmlinuz"
    return $?
  fi

  printf '  %-11s ' "$name"
  verdict "$log" "$name" "$mode" "$SWEEP"
}

# Virtual-side KASLR residual entropy from a boot log's -j JSON, or empty.
# entropy_bits appears in both the virt and phys kaslr sub-objects; take the
# virt one (before the physical/memory markers).
bits_of() {
  _vbits=$(awk '/"kaslr": *\{/{ink=1}
       ink && /"(physical|inferred_physical|memory_kaslr)":/{ink=0}
       ink && /"entropy_bits":/{gsub(/[^0-9]/,""); print; exit}' "$1")
  # The kaslr object omits slots/entropy_bits when it cannot count -- a window
  # with an unstated edge. The figure is still reported alongside the posture,
  # so read it from there rather than treating the absence as an answer.
  [ -n "$_vbits" ] || _vbits=$(grep -am1 -oE '"virt_base_entropy_bits": *[0-9]+' "$1" |
    grep -oE '[0-9]+$')
  printf '%s' "$_vbits"
}

# Physical-side KASLR residual entropy: the entropy_bits inside the phys sub-tree
# ("physical" / "inferred_physical"), or empty when absent.
phys_bits_of() {
  _phbits=$(awk '/"(physical|inferred_physical)": *\{/{inp=1}
       inp && /"(likely_physical|memory_kaslr)":/{inp=0}
       inp && /"entropy_bits":/{gsub(/[^0-9]/,""); print; exit}' "$1")
  # Same fallback as bits_of, on the physical axis.
  [ -n "$_phbits" ] || _phbits=$(grep -am1 -oE '"phys_base_entropy_bits": *[0-9]+' "$1" |
    grep -oE '[0-9]+$')
  printf '%s' "$_phbits"
}

# Format an entropy-bit count as a residual cell: 0 -> exact, 1 -> "1 bit",
# n -> "n bits", empty -> em dash.
fmt_bits() {
  case "$1" in
    0)      echo exact ;;
    1)      echo '1 bit' ;;
    '' | —) echo '—' ;;
    *)      echo "$1 bits" ;;
  esac
}

# Virtual-side speculative-narrowing fields from a boot log, or nothing when the
# likely window does not diverge from guaranteed. The engine emits the `likely`
# object only when it is strictly tighter than guaranteed, so its presence IS the
# divergence. `via`/`method` are attributed to the `groups` entry whose consensus
# edge (lo/hi/consensus) coincides with a likely-window edge — the leak or timing
# signal that pinned the speculative base; for coupled arches with no text leak
# this resolves to the directmap/dram base whose image-size ceiling narrowed it.
# The trailing `ntouch` field is 1 when a group whose consensus_method is in
# `nonrepro` (the run-varying set, e.g. timing) coincides with ANY edge of the
# likely window (virtual OR physical) — i.e. a non-reproducible signal helped set
# the shown window, whether or not it is the one `method`/`via` attributes. The
# render filter drops such rows by default so the table does not depend on a
# per-run signal even when the displayed attribution landed on a reproducible one.
# Prints one pipe-delimited record: gbits|lbits|lmin|lmax|method|via|ntouch
likely_of() {
  awk -v nonrepro="$SPEC_NONREPRO_METHODS" '
    function val(s){ sub(/^[^:]*:[ \t]*/,"",s); gsub(/[",]/,"",s);
                     gsub(/^[ \t]+|[ \t]+$/,"",s); return s }
    function orig(s){ sub(/^[^:]*:[ \t]*\[/,"",s); sub(/\].*/,"",s);
                      gsub(/[" ]/,"",s); gsub(/,/," + ",s); return s }
    function match_edge(target,   i){
      for(i=1;i<=gi;i++) if(glo[i]==target||ghi[i]==target||gcons[i]==target){
        method=gcm[i]; via=gorg[i]; return 1 } return 0 }
    function in_set(m){ return index(" " nonrepro " ", " " m " ")>0 }
    function edge_of(i,t){ return (t!="" && (glo[i]==t||ghi[i]==t||gcons[i]==t)) }
    function nonrepro_touch(   i){
      for(i=1;i<=gi;i++) if(in_set(gcm[i]) &&
        (edge_of(i,lmax)||edge_of(i,lmin)||edge_of(i,lpmax)||edge_of(i,lpmin)))
        return 1
      return 0 }
    /"kaslr":[ \t]*\{/{ ink=1 }
    ink && /"inferred":[ \t]*\{/{ blk="inf" }
    ink && /"likely":[ \t]*\{/{ blk="lik" }
    ink && /"inferred_physical":/{ blk=""; ink=0 }
    blk=="inf" && /"entropy_bits":/{ gbits=val($0) }
    blk=="lik" && /"range_min":/{ lmin=val($0) }
    blk=="lik" && /"range_max":/{ lmax=val($0) }
    blk=="lik" && /"entropy_bits":/{ lbits=val($0); blk="" }
    /"likely_physical":[ \t]*\{/{ lpk=1 }
    lpk && /"range_min":/{ lpmin=val($0) }
    lpk && /"range_max":/{ lpmax=val($0); lpk=0 }
    # page_offset likely edge (single-line object): on a coupled arch the image
    # base rides the page-offset grid, so its likely low edge is the page_offset
    # config-default (e.g. VMSPLIT_3G 0xc0000000) rather than any observed group.
    /"virt_page_offset_base":/{ s=$0
      if(sub(/.*"likely":[ \t]*\{[ \t]*"min":[ \t]*"/,"",s)){ sub(/".*/,"",s); polik=s } }
    /"groups":[ \t]*\[/{ ing=1 }
    ing && /"type":/{ gi++; gorg[gi]=""; curorig="" }
    ing && gi>0 && /"consensus":/{ gcons[gi]=val($0) }
    ing && gi>0 && /"consensus_method":/{ gcm[gi]=val($0) }
    ing && gi>0 && /"lo":/{ glo[gi]=val($0) }
    ing && gi>0 && /"hi":/{ ghi[gi]=val($0) }
    # via credits the result whose method IS the group consensus method (the
    # reproducible source that set it), not merely the first-listed result: a
    # parsed leak corroborated by a timing signal must read as the parsed leak,
    # not the timing one that happens to agree. Fall back to the first result.
    ing && gi>0 && /"origins":/{ curorig=orig($0); if(gorg[gi]=="") gorg[gi]=curorig }
    ing && gi>0 && /"method":/{ if(val($0)==gcm[gi]) gorg[gi]=curorig }
    END{
      if(lmax==""){ exit }        # no likely block -> no divergence
      method="?"; via="?"
      if(!match_edge(lmax) && !match_edge(lmin) && lpmax!="")
        if(!match_edge(lpmax)) match_edge(lpmin)
      # Coupled-arch fallback: no observed group edge matched, but the likely
      # image-base low edge sits on the page_offset config-default grid — the
      # narrowing is the assumed page offset (a config-default guess), not a leak.
      if(method=="?" && polik!="" && lmin==polik){ method="config"; via="page_offset default" }
      printf "%s|%s|%s|%s|%s|%s|%s\n", gbits, lbits, lmin, lmax, method, via, nonrepro_touch()
    }' "$1"
}

# Render the speculative-narrowing table (markdown): the cells where the likely
# best-guess window is tighter than the guaranteed one, the signal that drove it,
# and whether that guess contained the truth. Unlike the matrix this is NOT gated
# — a likely miss is disclosed here, never withheld, because the soundness gate is
# on the guaranteed matrix. Emits nothing but a note when no cell diverges.
cmd_spec_table() {
  nl='
'
  body=
  excluded_timing=0
  for a in $arches; do
    arch_disp=${a%%-*}
    for scen in default kptr-hidden perf-open dmesg-open bpf-open hardened tracefs-open; do
      log="$HERE/$a/boot-$scen.log"
      [ -f "$log" ] || continue
      grep -aq 'KASLD VM DONE' "$log" || continue
      row=$(likely_of "$log"); [ -n "$row" ] || continue   # likely == guaranteed
      IFS='|' read -r gbits lbits lmin lmax method via ntouch <<EOF
$row
EOF
      # The engine emits a `likely` block whenever it trims the raw guaranteed
      # interval, but the matrix (and this table) score the window by entropy
      # bits. Where a sound leak already pins guaranteed to a single candidate
      # (entropy 0), a `likely` block that only shaves a non-grid interval edge
      # adds no bit — skip it, so the table lists real speculative narrowing.
      [ "$gbits" != "$lbits" ] || continue
      # Non-reproducible microarchitectural/timing narrowings are excluded by
      # default: their success depends on the host CPU and varies run to run.
      # ntouch=1 means a run-varying signal (SPEC_NONREPRO_METHODS, e.g. timing)
      # helped set an edge of this likely window — so the row would not reproduce,
      # regardless of which signal the `method`/`via` columns happen to name.
      # --with-timing / SPEC_INCLUDE_TIMING=1 lists them anyway.
      if [ "$SPEC_INCLUDE_TIMING" != 1 ] && [ "$ntouch" = 1 ]; then
        excluded_timing=$((excluded_timing + 1)); continue
      fi
      truth=$(awk '/ _text$/{print $1; exit}' "$log")
      [ -n "$truth" ] || truth=$(awk '/ _stext$/{print $1; exit}' "$log")
      t=$(norm "$truth"); lo=$(norm "$lmin"); hi=$(norm "$lmax")
      hit='—'
      if [ -n "$t" ] && [ -n "$lo" ] && [ -n "$hi" ]; then
        if hexle "$lo" "$t" && hexle "$t" "$hi"; then hit=yes; else hit='**NO**'; fi
      fi
      flavor=$(printf '%s' "$TABLE" | awk -F'|' -v a="$a" 'NF>1{gsub(/ /,"",$1); if ($1==a) {gsub(/ /,"",$3); print $3; exit}}')
      src=alpine; [ "$flavor" = local ] && src=mainline
      rel=$(grep -am1 'Linux version' "$log" | sed -E 's/.*Linux version ([^ ]+).*/\1/')
      [ -n "$rel" ] || rel='?'
      # Same variant disambiguation as the guaranteed matrix (see cmd_table).
      variant=$(printf '%s' "$a" | cut -d- -f4-)
      [ -n "$variant" ] && rel="$rel ($variant)"
      body="${body}| $arch_disp | $rel | $src | $scen | $(fmt_bits "$gbits") | $(fmt_bits "$lbits") | \`$via\` | $method | $hit |${nl}"
    done
  done

  if [ -z "$body" ]; then
    if [ "$excluded_timing" -gt 0 ]; then
      printf 'No reproducible speculative narrowing: the only cells where the likely window beat guaranteed were narrowed by a timing side channel, which is excluded by default (pass --with-timing to list them).\n'
    else
      printf 'No speculative narrowing: the likely window equals guaranteed on every cell.\n'
    fi
    return 0
  fi
  printf '| arch | release | source | scenario | guaranteed | likely | via | method | truth ∈ likely |\n'
  printf '|------|---------|--------|----------|------------|--------|-----|--------|:---:|\n'
  printf '%s' "$body"
  # shellcheck disable=SC2016  # backticks are literal markdown, not a subshell
  printf '\n`via`/`method` = the sub-floor signal that narrowed the base past the sound floor; `truth ∈ likely` = whether that best-guess window still contained the real base. A `**NO**` is disclosed, not withheld — the soundness gate is on the guaranteed matrix above, which contains the truth regardless. Every other KASLR-on cell: likely equals guaranteed.\n'
  if [ "$SPEC_INCLUDE_TIMING" = 1 ]; then
    # shellcheck disable=SC2016
    printf 'Timing side-channel narrowings (method:timing — e.g. `prefetch`, `entrybleed`) are listed here because --with-timing is set; they are hardware- and run-dependent, so they are omitted from the default (reproducible) table.\n'
  elif [ "$excluded_timing" -gt 0 ]; then
    printf 'Timing side-channel narrowings (method:timing) are excluded by default because their success is hardware- and run-dependent; %d such cell(s) were omitted. Pass --with-timing to list them.\n' "$excluded_timing"
  fi
}

# Select the records the matrix is rendered from: for each (cell, profile), the
# ones written by the most recent sweep that covered it.
#
# Not every record in the ledger. It is append-only across sweeps, so it holds a
# cell's history, and pooling that history would mix a figure from one tree with a
# figure from another -- which is how a published matrix came to show one arm64
# cell at 32 bits under one profile and 31 under another, nine hours and one tree
# apart, reading as though the profile had done it. Newest-sweep-per-pair keeps a
# pair internally coherent; the span the rows span is disclosed beneath the table,
# because the remaining incoherence is between pairs and a reader has to see it.
#
# Sweep ids are UTC stamps, so lexical order is chronological.
ledger_current() {
  awk -F'\t' -v want="$REC_FIELDS" '
    NF == want {
      key = $3 FS $4
      if ($1 > latest[key]) latest[key] = $1
      row[NR] = $0; k[NR] = key; sw[NR] = $1
    }
    END { for (i = 1; i <= NR; i++) if (i in row && sw[i] == latest[k[i]]) print row[i] }
  ' "$LEDGER"
}

# Aggregate the selected records into one line per (cell, profile):
#   cell  profile  release  source  kaslr  virt-residual  phys-residual  boots
#
# A residual is a SAMPLE, not a constant, wherever the evidence moved the window:
# the floor holds still between boots of one cell and the ceiling is read off an
# address the draw placed, so several boots of one cell legitimately disagree. The
# aggregate states the span they cover -- `11-14 bits` -- and a single figure only
# where every boot agreed, which is itself a result worth being able to read off
# the table.
#
# `exact` covers a byte-exact pin and a window narrower than the KASLR grain
# alike: both mean the randomized slot is known.
ledger_rows() { # reads selected records on stdin
  awk -F'\t' '
    function eff(lo, hi, bits) {
      if (lo != "-" && lo == hi) return 0
      if (bits == "-") return -1          # no figure at all
      return bits + 0
    }
    function note(key, v) {
      if (v < 0) { uncounted[key] = 1; return }
      if (!(key in lo_) || v < lo_[key]) lo_[key] = v
      if (!(key in hi_) || v > hi_[key]) hi_[key] = v
    }
    function residual(key) {
      if (uncounted[key]) return "uncounted"
      if (!(key in lo_)) return "—"
      l = lo_[key]; h = hi_[key]
      if (l == h) return l == 0 ? "exact" : (l == 1 ? "1 bit" : l " bits")
      return l "–" h " bits"
    }
    {
      cell = $3; prof = $4; key = cell FS prof
      if (!(key in seen)) { seen[key] = 1; order[++nkeys] = key }
      boots[key]++
      release[key] = $6; source[key] = $7
      # A cell booted with KASLR off in any boot of the sweep is an off cell: the
      # posture belongs to the kernel rather than to the draw, so the boots cannot
      # disagree about it, and a residual for one would be a residual of nothing.
      if ($8 == "off") off[key] = 1
      if ($16 == "yes") coupled[key] = 1
      if ($17 != "NA") physreal[key] = 1
      note(key "\tV", eff($10, $11, $12))
      note(key "\tP", eff($13, $14, $15))
    }
    END {
      for (i = 1; i <= nkeys; i++) {
        key = order[i]
        split(key, f, FS)
        v = off[key] ? "—" : residual(key "\tV")
        if (off[key])            p = "—"
        else if (coupled[key])   p = "coupled"
        else if (!physreal[key]) p = "—"
        else                     p = residual(key "\tP")
        printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", f[1], f[2], release[key],
          source[key], (off[key] ? "off" : "on"), v, p, boots[key]
      }
    }
  '
}

# Render the results matrix (markdown) from the ledger. One row per (cell,
# profile) the current sweep covered. Every column describes the GUARANTEED
# window -- the one resolved at the sound floor, which must contain the truth.
cmd_table() {
  nl='
'
  if [ ! -s "$LEDGER" ]; then
    # shellcheck disable=SC2016  # backticks are literal, not a subshell
    printf 'no boot records in %s — run `tests/vm/run all <profile>` first\n' "$LEDGER" >&2
    return 1
  fi

  sel=$(ledger_current)
  if [ -z "$sel" ]; then
    printf 'no usable records in %s (every line was the wrong width)\n' "$LEDGER" >&2
    return 1
  fi

  # SOUNDNESS GATE. Every selected record is judged by the same function that
  # judged it when it was booted, from the same numbers. A cell that is not
  # verified sound is a bug, never something to publish, so one failure withholds
  # the whole table rather than dropping a row out of it.
  bad=
  unverified=
  while IFS= read -r r; do
    rec_read "$r" || continue
    v=$(record_verdict) || true
    case "$v" in
      PASS*) ;;
      N/A*) ;;
      UNVERIFIED*) unverified="${unverified}  $R_cell/$R_profile boot $R_repeat: ${v#UNVERIFIED  }${nl}" ;;
      *) bad="${bad}  $R_cell/$R_profile boot $R_repeat: $v${nl}" ;;
    esac
  done <<EOF
$sel
EOF
  if [ -n "$bad" ]; then
    printf 'SOUNDNESS GATE FAILED — refusing to emit the matrix. Cells not verified sound:\n%s' "$bad" >&2
    return 1
  fi
  if [ -n "$unverified" ]; then
    printf 'REFUSING to emit the matrix — these boots verified nothing:\n%s' "$unverified" >&2
    return 1
  fi

  agg=$(printf '%s\n' "$sel" | ledger_rows)

  # A cell whose binary cannot execute under its own kernel yields no result by
  # construction, so it is evidence of nothing. It is listed beneath the matrix
  # instead, so the omission stays visible.
  unrunnable=
  for a in $arches; do
    if cb=$(cell_binary "$a") && arm_be32_binary "$cb"; then
      case " $unrunnable " in *" ${a%%-*} "*) ;; *) unrunnable="$unrunnable${a%%-*} " ;; esac
    fi
  done

  body=
  rows=0
  for a in $arches; do
    case " $unrunnable " in *" ${a%%-*} "*) continue ;; esac
    arch_disp=${a%%-*}
    variant=$(printf '%s' "$a" | cut -d- -f4-)
    for scen in default kptr-hidden perf-open dmesg-open bpf-open hardened tracefs-open nokaslr \
      no5lvl no4lvl la57; do
      line=$(printf '%s\n' "$agg" | awk -F'\t' -v c="$a" -v p="$scen" '$1==c && $2==p {print; exit}')
      [ -n "$line" ] || continue
      # Which scenarios earn a row. All of them are gate-checked above; this
      # decides only what the matrix shows. Filter by APPLICABILITY, never by
      # OUTCOME: whether a profile applies to a cell is a property of the cell,
      # while whether it changed the number is a RESULT, and suppressing a row for
      # that hides the negative finding the profile exists to report.
      #
      # nokaslr is a control (KASLR forced off → always "—") and carries no
      # per-arch signal. The paging-mode parameters carry signal on the two
      # architectures that act on them and are ignored everywhere else, where the
      # boot is a byte-for-byte repeat of `default`.
      case "$scen" in
      nokaslr) continue ;;
      no5lvl) case "$arch_disp" in x86_64 | riscv64) ;; *) continue ;; esac ;;
      no4lvl) [ "$arch_disp" = riscv64 ] || continue ;;
      la57) [ "$arch_disp" = x86_64 ] || continue ;;
      esac
      rel=$(printf '%s' "$line" | cut -f3)
      src=$(printf '%s' "$line" | cut -f4)
      kas=$(printf '%s' "$line" | cut -f5)
      vres=$(printf '%s' "$line" | cut -f6)
      pres=$(printf '%s' "$line" | cut -f7)
      [ -n "$variant" ] && rel="$rel ($variant)"
      body="${body}| $arch_disp | $rel | $src | $scen | $kas | $vres | $pres |${nl}"
      rows=$((rows + 1))
    done
  done

  if [ "$rows" = 0 ]; then
    printf 'no rows to render from %s\n' "$LEDGER" >&2
    return 1
  fi

  printf '| arch | release | source | scenario | KASLR | virt residual | phys residual |\n'
  printf '|------|---------|--------|----------|-------|---------------|---------------|\n'
  printf '%s' "$body"
  # shellcheck disable=SC2016  # backticks are literal markdown, not a subshell
  printf '\nEvery cell is sound: the true base lies inside the guaranteed window, on BOTH the virtual and (where independently resolved) the physical axis, in every boot. `source` = `alpine` (distro kernel) or `mainline` (mainline kernel.org build). `virt residual` / `phys residual` = how much KASLR entropy KASLD could not strip from the virtual text base / physical image base: `exact` = base recovered, KASLR defeated (a byte-exact pin and a below-granularity sub-slot window are the same outcome — the randomized slot is known); `<n> bits` = KASLR-randomized, n bits of the slot still unknown; `<lo>–<hi> bits` = the boots of that cell did not agree, and the span they covered; `—` = KASLR off (nothing randomized to strip). In the `phys residual` column, `coupled` marks an architecture whose physical image base is a fixed projection of the virtual text base (no independent physical axis — recovering the virtual base already determines it); only the decoupled arches (x86-64, arm64, riscv64, s390) carry an independent `exact` / `<n> bits` physical result.\n'

  # What the figures rest on: how many boots each cell got, and how far apart the
  # sweeps they came from were. A range is only as good as the number of draws
  # behind it, and a matrix assembled over weeks is a different claim from one
  # assembled in an hour -- neither can be read off the rows themselves.
  bmin=$(printf '%s\n' "$agg" | cut -f8 | sort -n | head -1)
  bmax=$(printf '%s\n' "$agg" | cut -f8 | sort -n | tail -1)
  smin=$(printf '%s\n' "$sel" | cut -f1 | sort | head -1)
  smax=$(printf '%s\n' "$sel" | cut -f1 | sort | tail -1)
  if [ "$bmin" = "$bmax" ]; then
    printf '\nEach cell was booted %s time(s).' "$bmin"
  else
    printf '\nCells were booted between %s and %s times.' "$bmin" "$bmax"
  fi
  if [ "$smin" = "$smax" ]; then
    printf ' Every row comes from one sweep, %s.\n' "$smin"
  else
    printf ' Rows come from sweeps between %s and %s: a figure that moved between them moved for a reason the profile column does not name.\n' "$smin" "$smax"
  fi

  # An arch that cannot run the payload is disclosed rather than dropped
  # silently, so the matrix cannot be read as having covered it.
  if [ -n "$unrunnable" ]; then
    printf '\nNot covered: %s— the big-endian arm toolchain available here emits BE32 binaries, while a big-endian arm kernel runs userspace BE8. kasld cannot execute under such a kernel, so no result is produced and no soundness claim is made either way. Those kernels build and boot; only the userspace side is missing.\n' "$unrunnable"
  fi

  # The matrix reports the guaranteed window; the speculative-narrowing table
  # discloses where the likely best-guess window beats it, and by what signal.
  printf '\n'
  cmd_spec_table
}

# Render the results matrix as an SVG bar chart (docs/diagrams/residual-entropy-by-arch.svg).
# Reads cmd_table's own rows rather than the boot logs, so the chart and the
# matrix cannot disagree: one extraction path, two renderings.
#
# One bar per architecture, all of them on a single kernel line and each on its
# own upstream defconfig, measured at the default vantage. Holding both fixed is
# the point. A cell differs from its neighbour along four axes at once -- the
# architecture, the kernel line, the configuration and the vantage -- so a
# figure that pools them attributes to the architecture whatever the other three
# did, and the width or the split moves the window further than the
# architecture does. Those axes have their own sections in the published
# document.
#
# Nothing here counts cells. The matrix is a convenience sample whose shape
# follows whatever was most recently investigated, so a total, a mean or a
# distribution over it would measure that attention rather than the subject.
# One machine per architecture, plotted on its own, is a claim the sample
# cannot distort.
cmd_chart() {
  # Which kernel line the published chart shows. More than one currently spans
  # every architecture, so this is an editorial choice and not something to
  # derive: selecting automatically would mean ordering release strings, which
  # is what the rest of the tool declines to do. Set CHART_BASELINE to publish
  # against a different line; an absent one is an error rather than an empty
  # chart.
  _chart_baseline=${CHART_BASELINE:-7.0.0}
  # Architectures whose upstream default leaves the kernel image unrandomised,
  # so the cell randomises only because build-kernel asks for RELOCATABLE and
  # RANDOMIZE_BASE. Verified against the kernel tree rather than inferred from
  # the overlay being applied, an overlay that sets an option already on being
  # indistinguishable from one that turns it on: riscv and mips carry no Kconfig
  # default and name the option in no defconfig, and the powerpc option is
  # absent from every fragment merged into the 85xx configuration. The
  # architectures plotted alongside them reach it from their own default --
  # arm64 and loongarch through the defconfig file, x86 and s390 through a
  # Kconfig default. build-kernel is the authority for what is applied; this
  # list says what the applying was needed for, and the two are kept in step.
  _chart_default_off=${CHART_DEFAULT_OFF-"mips mipsel mips64el ppc32 riscv64"}
  cmd_table | awk -F'|' -v BASELINE="$_chart_baseline" -v DEFOFF="$_chart_default_off" '
    BEGIN { L = 190; R = 872; AX = 168; TOP = 168; RH = 31; n = 0; noff = 0
            nd = split(DEFOFF, d, " "); for (i = 1; i <= nd; i++) defoff[d[i]] = 1 }
    # A residual cell as a pair of numbers: the lowest and the highest figure the
    # boots of that cell produced. "exact" is 0, "N bits" is N twice, and a span
    # "LO-HI bits" is both ends -- a cell whose boots disagreed, which is drawn as
    # a bar to the high end with the disputed part of it set apart. -1 for anything
    # else, which is not plotted.
    function bits_lo(s) { return bits_end(s, 1) }
    function bits_hi(s) { return bits_end(s, 2) }
    function bits_end(s, which,   parts) {
      gsub(/^ +| +$/, "", s)
      if (s == "exact") return 0
      if (s ~ /^[0-9]+ bits?$/) { sub(/ bits?$/, "", s); return s + 0 }
      if (s ~ /^[0-9]+–[0-9]+ bits$/) {
        sub(/ bits$/, "", s); split(s, parts, "–")
        return parts[which] + 0
      }
      return -1
    }
    NF > 6 {
      a = $2; rel = $3; src = $4; scen = $5; k = $6
      v = bits_hi($7); vlo = bits_lo($7)
      gsub(/^ +| +$/, "", a); gsub(/^ +| +$/, "", rel); gsub(/^ +| +$/, "", src)
      gsub(/^ +| +$/, "", scen); gsub(/^ +| +$/, "", k)
      # cmd_table prints the speculative-narrowing table after the matrix, and its
      # sixth column is a residual rather than the KASLR state. Anything that is
      # not the state belongs to that second table, or to a header.
      if (k != "on" && k != "off") next
      if (src != "mainline" || scen != "default") next
      if (rel != BASELINE) next
      # The release match above already excludes a configuration variant, whose
      # release carries a bracketed suffix; the test is repeated here so that a
      # baseline set to one of those variants is refused rather than charted,
      # which would put two configurations of a single architecture beside one
      # configuration of every other. The second test keeps the first row per
      # architecture where a release somehow appears twice.
      if (rel ~ /\(/ || a in seen) next
      seen[a] = 1
      if (k == "on" && v >= 0) { arch[n] = a; val[n] = v; low[n] = vlo; n++ }
      else { off[noff] = a; noff++ }
    }
    END {
      if (n == 0 && noff == 0) {
        printf "chart: no mainline rows at the default vantage for release %s\n", BASELINE > "/dev/stderr"
        exit 1
      }
      # Selection sort, widest window first. Every per-bar array moves together:
      # a bar carries its architecture, the highest figure its boots left and the
      # lowest, and sorting one array without the others pairs a bar with the
      # numbers belonging to a different one.
      for (i = 0; i < n; i++)
        for (j = i + 1; j < n; j++)
          if (val[j] > val[i] || (val[j] == val[i] && arch[j] < arch[i])) {
            t = val[i]; val[i] = val[j]; val[j] = t
            t = low[i]; low[i] = low[j]; low[j] = t
            s = arch[i]; arch[i] = arch[j]; arch[j] = s
          }
      for (i = 0; i < noff; i++)
        for (j = i + 1; j < noff; j++)
          if (off[j] < off[i]) { s = off[i]; off[i] = off[j]; off[j] = s }
      MAXB = 5
      for (i = 0; i < n; i++) if (val[i] > MAXB) MAXB = val[i]
      bandY = TOP + RH * n + 34
      ny = bandY + (noff ? 30 : 4)
      # A bar whose boots disagreed is the only reason to explain the faint part,
      # so the line saying what it means is drawn only when one is.
      anyspan = 0
      for (i = 0; i < n; i++) if (val[i] != low[i]) anyspan = 1
      a2_present = 0
      for (i = 0; i < n; i++) if (arch[i] in defoff) a2_present = 1
      # The canvas follows the footer rather than a fixed figure: the footer
      # grows and shrinks with the groups that have members and with whether a
      # span was drawn, and a height set independently of it either clips the
      # last line or leaves a band of white under the image.
      notes = 3   # one on the sample, two on what a long bar does not mean
      if (a2_present) notes++
      if (noff) notes++
      if (anyspan) notes += 2
      H = ny + notes * 17 + (anyspan ? 18 : 9) + 28
      printf "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"960\" height=\"%d\"", H
      printf " viewBox=\"0 0 960 %d\" font-family=\"sans-serif\">\n", H
      print "  <style>"
      print "      .title { font-size: 22px; font-weight: 700; fill: #263238; }"
      print "      .sub   { font-size: 13px; fill: #546e7a; }"
      print "      .arch  { font-family: monospace; font-size: 13px; fill: #37474f; }"
      print "      .val   { font-family: monospace; font-size: 11px; fill: #455a64; }"
      print "      .note  { font-size: 11.5px; fill: #607d8b; }"
      print "      .axis  { font-size: 11px; fill: #607d8b; }"
      print "      .guide { stroke: #cfd8dc; stroke-width: 1; stroke-dasharray: 3 3; }"
      print "  </style>"
      printf "  <rect width=\"960\" height=\"%d\" fill=\"#ffffff\"/>\n", H
      print "  <text class=\"title\" x=\"24\" y=\"34\">How much kernel address entropy survives, by architecture</text>"
      print "  <text class=\"sub\" x=\"24\" y=\"57\">One kernel line, each architecture built from its own upstream defconfig, one machine per architecture, read by an</text>"
      print "  <text class=\"sub\" x=\"24\" y=\"75\">unprivileged user at the default vantage. Each bar is what remains of the kernel image base, in bits, given only what</text>"
      print "  <text class=\"sub\" x=\"24\" y=\"93\">inference can prove without resting on unsound evidence.</text>"
      for (t = 0; t <= MAXB; t += 5) {
        printf "  <line class=\"guide\" x1=\"%.1f\" y1=\"%d\" x2=\"%.1f\" y2=\"%d\"/>\n", X(t), TOP-18, X(t), TOP+RH*n-14
        printf "  <text class=\"axis\" x=\"%.1f\" y=\"%d\" text-anchor=\"middle\">%d</text>\n", X(t), TOP-26, t
      }
      printf "  <text class=\"axis\" x=\"%d\" y=\"%d\" text-anchor=\"end\">bits remaining</text>\n", L-12, TOP-26
      for (i = 0; i < n; i++) {
        y = TOP + RH * i
        printf "  <text class=\"arch\" x=\"%d\" y=\"%d\" text-anchor=\"end\">%s</text>\n", AX, y+4, arch[i]
        w = X(val[i]) - L; if (w < 2) w = 2
        # Where the boots of a cell disagreed, the bar reaches the highest figure
        # any of them left and the disputed part of it -- between the lowest and
        # the highest -- is drawn faintly. Solid is what survived every boot;
        # faint is what survived some. A cell whose boots agreed has no faint part
        # and is the same bar it always was.
        wlo = X(low[i]) - L; if (wlo < 2) wlo = 2
        printf "  <rect x=\"%d\" y=\"%d\" width=\"%.1f\" height=\"18\" fill=\"#2e7d32\" opacity=\"0.85\" rx=\"2\"/>\n", L, y-9, wlo
        if (val[i] != low[i])
          printf "  <rect x=\"%.1f\" y=\"%d\" width=\"%.1f\" height=\"18\" fill=\"#2e7d32\" opacity=\"0.30\"/>\n", L + wlo, y-9, w - wlo
        if (val[i] != low[i])
          printf "  <text class=\"val\" x=\"%.1f\" y=\"%d\">%d&#8211;%d</text>\n", L + w + 10, y+4, low[i], val[i]
        else
          printf "  <text class=\"val\" x=\"%.1f\" y=\"%d\">%d</text>\n", L + w + 10, y+4, val[i]
      }
      printf "  <line x1=\"24\" y1=\"%d\" x2=\"936\" y2=\"%d\" stroke=\"#eceff1\" stroke-width=\"1\"/>\n", bandY-16, bandY-16
      offlist = ""
      for (i = 0; i < noff; i++) offlist = offlist (offlist ? ", " : "") off[i]
      a2 = ""
      for (i = 0; i < n; i++)
        if (arch[i] in defoff) a2 = a2 (a2 ? ", " : "") arch[i]
      # The footer carries what a reader needs with nothing else on the page,
      # since the file is committed and gets opened on its own. That is three
      # claims: a bar is one machine rather than a fleet average, a long bar is
      # not a strong kernel, and -- only where one is drawn -- what the faint
      # part of a bar means. The document around the image says all of this at
      # length; repeating the long form here only gave three copies to keep true.
      gy = ny
      printf "  <text class=\"note\" x=\"24\" y=\"%d\">Each bar is one machine on its own upstream defconfig, not an average: the bars compare architectures, not a fleet.</text>\n", gy
      gy += 17
      if (a2) {
        printf "  <text class=\"note\" x=\"24\" y=\"%d\">%s randomise only because this build asks for RELOCATABLE and RANDOMIZE_BASE, which their defaults leave off.</text>\n", gy, a2
        gy += 17
      }
      if (offlist) {
        printf "  <text class=\"note\" x=\"24\" y=\"%d\">%s cannot randomise the kernel image at all on this line, and are not plotted.</text>\n", gy, offlist
        gy += 17
      }
      gy += 9
      printf "  <text class=\"note\" x=\"24\" y=\"%d\">A long bar is not evidence of a strong kernel: it records that nothing reachable at this vantage narrowed the starting window,</text>\n", gy
      printf "  <text class=\"note\" x=\"24\" y=\"%d\">so it bounds what sound inference proves rather than what an attacker holding another route could reach.</text>\n", gy+17
      gy += 34
      if (anyspan) {
        gy += 9
        printf "  <text class=\"note\" x=\"24\" y=\"%d\">Where the boots of one machine disagreed, the bar reaches the highest figure any of them left and the disputed part is faint:</text>\n", gy
        printf "  <text class=\"note\" x=\"24\" y=\"%d\">solid is what survived every boot, faint what survived some.</text>\n", gy+17
      }
      print "</svg>"
    }
    function X(b) { return L + (R - L) * b / MAXB }
  '
}

# Online CPUs, read from sysfs where it is there. `nproc` reports the affinity
# mask rather than the machine, which is the wrong number inside a cpuset — and
# the harness is run in containers.
vm_cpus() {
  if [ -r /sys/devices/system/cpu/online ]; then
    awk -F, '{n=0; for (i=1;i<=NF;i++) {split($i,r,"-"); n += (r[2] ? r[2]-r[1]+1 : 1)} print n}' \
      /sys/devices/system/cpu/online
  elif command -v nproc >/dev/null 2>&1; then
    nproc
  else
    echo 1
  fi
}

# Build every triple the selected cells need, once, before any of them boots.
#
# An out-of-date binary runs, passes every check, and yields a matrix describing
# a tree nobody can identify, so the build has to happen — but once per triple,
# not once per cell per profile. Two concurrent `make` runs over one build tree
# also read each other's half-written objects and fail in ways that look like a
# cross-compilation error, so this is what lets the boots run in parallel at all:
# all the compiling is finished before the first guest starts.
#
# A cell whose triple cannot be named yet — nothing built for that prefix, so
# there is no directory to read it from — falls back to building the whole set,
# which is also the first-run case on a clean tree.
prepare_builds() { # cell...
  _pb_triples=
  _pb_all=0
  for _pb_cell in "$@"; do
    _pb_prefix=$(printf '%s' "$TABLE" | awk -F'|' -v a="$_pb_cell" \
      'NF>1{gsub(/ /,"",$1); if ($1==a) {gsub(/ /,"",$4); print $4; exit}}')
    [ -n "$_pb_prefix" ] || continue
    _pb_t=
    for _pb_d in "$BUILD_DIR/$_pb_prefix"-*; do
      [ -d "$_pb_d" ] || continue
      _pb_t=$(basename "$_pb_d")
      command -v "$_pb_t-gcc" >/dev/null 2>&1 && break
      _pb_t=
    done
    if [ -z "$_pb_t" ]; then _pb_all=1; continue; fi
    case " $_pb_triples " in *" $_pb_t "*) ;; *) _pb_triples="$_pb_triples$_pb_t " ;; esac
  done

  # One make at a time, each parallel within itself. Two concurrent makes over
  # one build tree is the failure this hoist exists to avoid; -j inside one is
  # what keeps a real rebuild — every object depends on the Makefile, so editing
  # it invalidates all of them — from being served one file at a time.
  _pb_j=-j$(vm_cpus)
  if [ "$_pb_all" = 1 ]; then
    echo "[*] building every cross target (a selected cell has none yet)"
    make -C "$ROOT" "$_pb_j" cross >/dev/null 2>&1 ||
      { echo "  !! make cross failed — run it directly to see why"; return 1; }
    return 0
  fi
  for _pb_t in $_pb_triples; do
    make -C "$ROOT" "$_pb_j" cross TRIPLE="$_pb_t" >/dev/null 2>&1 ||
      { echo "  !! make cross TRIPLE=$_pb_t failed — run it directly to see why"; return 1; }
  done
  echo "[*] built$(printf '%s' " $_pb_triples" | sed 's/ $//')"
}

# Boot every cell in $batch at once, then replay their output in list order and
# tally them. Each cell's output goes to a file inside its own directory rather
# than to the terminal, because several guests printing at once interleave into a
# transcript that cannot be read back per cell — and the verdict line is the one
# thing a reader looks for.
#
# `wait` with no argument is the whole batch: a slot pool would start the next
# cell the moment any one finished, but POSIX shell has no way to wait for the
# first of several, and the cells within a batch cost enough alike that waiting
# for the slowest is a smaller loss than the portability.
flush_batch() {
  [ -n "$batch" ] || return 0
  for _fb in $batch; do
    mkdir -p "$HERE/$_fb"
    ( run_cell "$_fb" "$mode" >"$HERE/$_fb/run.out" 2>&1
      echo $? >"$HERE/$_fb/run.rc" ) &
  done
  wait
  for _fb in $batch; do
    cat "$HERE/$_fb/run.out" 2>/dev/null
    tally "$(cat "$HERE/$_fb/run.rc" 2>/dev/null || echo 2)"
  done
  batch=
}

# ---- dispatch ----
# Cell list, ordered alphabetically by architecture (the rendered tables and the
# boot loop both consume this). A stable sort keyed on the arch prefix
# (<arch>-<distro>-<version>) keeps the alpine-then-mainline / ascending-version
# order within each arch while presenting arches A→Z.
arches=$(echo "$TABLE" | awk -F'|' 'NF>1{gsub(/ /,"",$1); print $1}' |
  awk -F- '{print $1"\t"$0}' | LC_ALL=C sort -s -k1,1 | cut -f2)

case "${1:-}" in
  table | --table)           cmd_table; exit $? ;;
  spec-table | --spec-table) cmd_spec_table; exit $? ;;
  chart | --chart)           cmd_chart; exit $? ;;
  fetch-modules)             shift; cmd_fetch_modules "$@"; exit $? ;;
esac

sel=${1:-all}; mode=${2:-default}
[ "$sel" = all ] || mode=${2:-default}

rc=0; pass=0; fail=0; skip=0
list=$arches
[ "$sel" != all ] && list=$sel

# shellcheck disable=SC2086  # $list is a deliberately split cell list
prepare_builds $list || exit 2

# How many cells boot at once. A guest is one vCPU in one qemu process and writes
# only inside its own cell directory, so cells are independent once the builds are
# hoisted out of the loop — which they are, above, because two concurrent `make`
# runs over one build tree read each other's half-written objects and fail as
# though the cross compiler were at fault.
#
# Capped rather than one per core: each guest holds up to 1 GiB, and a host that
# has to swap loses more than the concurrency gains. One core is left for the
# harness and the host. JOBS=1 restores a strictly sequential sweep, which is also
# what a capture takes: it reconstructs a fixture under tests/fixtures, where two
# cells can resolve to one destination.
JOBS=${JOBS:-}
if [ -z "$JOBS" ]; then
  JOBS=$(( $(vm_cpus) - 1 ))
  [ "$JOBS" -ge 1 ] || JOBS=1
  [ "$JOBS" -le 4 ] || JOBS=4
fi
[ "$mode" = capture ] && JOBS=1
# One named cell is someone watching one boot, where buffering its output until
# the end is the wrong trade however many cores are free.
[ "$sel" = all ] || JOBS=1

# Hold a cell for the duration of its run. Concurrent runs of the SAME cell share
# its boot log and its staging directory, and what comes out is not a harness
# error but a verdict: one run reads the other's half-written log and reports a
# guest that exported no symbols. A directory is the lock because creating one is
# atomic. A run killed outright leaves it behind, so the message says where it is.
run_cell() { # cell mode -> run_one's status
  _rc_w=$HERE/$1
  mkdir -p "$_rc_w"
  if ! mkdir "$_rc_w/.lock" 2>/dev/null; then
    echo "=================== $1 ($2) ==================="
    echo "  SKIP  another run holds $_rc_w/.lock (remove it if that run is gone)"
    return 3
  fi
  run_one "$1" "$2"
  _rc_st=$?
  rmdir "$_rc_w/.lock" 2>/dev/null
  return $_rc_st
}

batch=
# Interrupted mid-batch, the cells being held would keep their locks and refuse
# the next run. Only this invocation's own batch is released: another invocation's
# lock is not this one's to remove.
# shellcheck disable=SC2317  # reached from the trap below, which shellcheck reads
# as a string rather than as a call site
release_locks() {
  for _rl in $batch; do
    rmdir "$HERE/$_rl/.lock" 2>/dev/null || true
  done
}
trap 'release_locks; exit 130' INT TERM

tally() { # status
  case $1 in
    0) pass=$((pass+1)) ;;
    3) skip=$((skip+1)) ;;
    *) fail=$((fail+1)); rc=1 ;;
  esac
}

# Sequential and parallel are separate paths on purpose. A single cell run
# interactively should print its progress as it happens rather than after it
# finishes, and that is exactly what a parallel sweep cannot do: several guests
# writing to one terminal interleave into something no reader can follow. So the
# parallel path buffers each cell and replays them in list order, and the
# sequential path does not buffer at all.
# How many times each cell is booted. A residual is a property of the boot that
# produced it wherever the evidence moved the window at all: the floor holds still
# between boots and the ceiling is read off an address the draw itself placed, so
# one boot is one sample of that cell rather than a constant of it. More than one
# is what lets the rendered matrix state a spread instead of a figure.
#
# The passes are sequential and each covers the whole list: repeats of ONE cell
# cannot overlap, since they share its log and its staging, and spacing them apart
# also keeps a pass from sampling one moment of host load.
REPEATS=${REPEATS:-1}
case $REPEATS in
  ''|*[!0-9]*|0) echo "REPEATS must be a positive integer: $REPEATS" >&2; exit 2 ;;
esac
[ "$REPEATS" = 1 ] || echo "[*] $REPEATS boots per cell (sweep $SWEEP)"

pass_n=1
while [ "$pass_n" -le "$REPEATS" ]; do
  [ "$REPEATS" = 1 ] || echo "=== boot $pass_n of $REPEATS ==="
  if [ "$JOBS" -le 1 ]; then
    for a in $list; do
      batch=$a
      run_cell "$a" "$mode"
      tally $?
    done
    batch=
  else
    [ "$pass_n" = 1 ] && echo "[*] $JOBS cells at a time"
    n=0
    for a in $list; do
      batch="$batch $a"
      n=$((n + 1))
      [ "$n" -lt "$JOBS" ] && continue
      flush_batch
      n=0
    done
    flush_batch
  fi
  pass_n=$((pass_n + 1))
done

echo "----------------------------------------------------------------------"
echo "vm: $pass ok, $fail fail, $skip skip  (mode=$mode, jobs=$JOBS, boots=$REPEATS, sweep=$SWEEP)"
exit $rc
