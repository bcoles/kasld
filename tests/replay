#!/bin/sh
# This file is part of KASLD - https://github.com/bcoles/kasld
#
# replay — end-to-end smoke harness: run the real kasld binary over captured
# fixtures.
#
# For each fixture under tests/fixtures/<arch>/<host>/, reconstruct a scratch
# sysroot from its captured filesystem state and run `kasld -v` over it, then
# sweep the remaining output modes (-1 oneline; -H / -H -m / -H -j for the
# hardening detail toggle, which also exercises the json and markdown analysis
# renderers, so bare -j / -m are covered via -H; and -v -m for the markdown
# document). The check is that kasld RUNS to
# completion in EVERY output mode — parses the fixture, resolves the engine, and
# renders that mode — without crashing. The sweep is per-arch crash coverage of
# every renderer (codegen / relocation / calling-convention faults the host-only
# render unit tests cannot reach), not a hardening-specific check. There is no in-process oracle to
# diff against and no stored golden master: the committed fixture is just
# sysroot/ + meta.txt + sizes.txt, and nothing depends on the volatile verbose
# output. Truth-containment / soundness is covered elsewhere: by the pure unit
# tests (make check / test_engine / test_engine_integration), offline against a
# captured bundle by extra/validate-bundle, and on live kernels by tests/vm/run.
# This harness is purely the end-to-end "does the real binary run on real
# captured layouts" check across architectures.
#
# Two modes:
#   - Native (KASLD_NATIVE=1): run host-arch fixtures directly, no qemu. CI runs
#     this (x86_64 + x86_32 on an x86_64 runner); foreign-arch fixtures skip.
#   - Default: run every fixture, using qemu-user for foreign arches. Needs the
#     cross binaries from `make cross` and qemu-user in QEMU_DIR.
#
# A failure is a crash (death by signal) in any output mode, or an output-mode
# assertion failing (a mode that emits no marker, or a document mode that leaks
# the plain-text run narration). A run yielding no results or no summary is not
# itself a failure: foreign-arch component children DO exec under nested
# qemu-user (the harness points KASLD_EXEC_WRAPPER at the host qemu binary), and
# whether a leak/probe component fires is environment-dependent.
# Live probes (source:live in .kasld_meta — perf, timing side-channels, mmap VA
# sweeps, ioctl/socket leaks, /proc/self) are skipped by the binary itself
# because KASLD_SYSROOT is set: their result would describe the analysis host,
# not the captured target. So this harness exercises the orchestrator, engine
# and renderers over the captured facts, not the live-probe binaries.
#
# Usage:  tests/replay [FIXTURE_DIR ...]      (default: all under tests/fixtures)
# Env:    QEMU_DIR      (default: resolve qemu-<arch> from PATH)
#         BUILD_DIR     (default ./build)
#         KASLD_NATIVE=1  run host-arch fixtures directly, no qemu (CI mode).
#                       Foreign-arch fixtures are skipped; the binary is taken
#                       from build/<arch>-*/ (any triple, gnu or musl).
#         KEEP=1        keep the scratch sysroot of the last fixture for inspection
# ---
# <bcoles@gmail.com>

set -u

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
# shellcheck source=tests/lib/qemu-target.sh
. "$ROOT/tests/lib/qemu-target.sh"
# shellcheck source=tests/lib/host-build.sh
. "$ROOT/tests/lib/host-build.sh"
QEMU_DIR=${QEMU_DIR:-}   # empty: resolve qemu-<arch> from PATH
BUILD_DIR=${BUILD_DIR:-$ROOT/build}
FIXROOT=$ROOT/tests/fixtures


# Native (KASLD_NATIVE=1) helpers: run host-runnable fixtures with no qemu.
# Echo a build/<arch>-*/ dir holding a host-runnable kasld for uname_m_raw $1,
# or nothing. Globs the arch prefix so any triple matches (x86_64-linux-gnu from
# `make`, x86_64-linux-musl from `make cross`, i686-linux-gnu, ...).
native_bindir() {
  case "$1" in
  x86_64)    set -- "$BUILD_DIR"/x86_64-* ;;
  i686 | i386) set -- "$BUILD_DIR"/i686-* "$BUILD_DIR"/i386-* ;;
  *)         set -- "$BUILD_DIR/$1"-* ;;
  esac
  for dd in "$@"; do
    [ -x "$dd/kasld" ] && { echo "$dd"; return; }
  done
}

# Pull "key:value" out of a fixture meta.txt (collect's format).
meta() { grep -E "^$2:" "$1/meta.txt" 2>/dev/null | head -1 | sed -E 's/^[^:]*:[[:space:]]*//'; }

pass=0; fail=0; skip=0

# Fixtures are independent (each gets its own mktemp scratch sysroot), so they
# can replay JOBS at a time. The work is qemu-startup/I-O bound, not CPU bound,
# so concurrency well above the core count still pays off. KEEP=1 (inspect the
# scratch dir) forces serial so the kept path is unambiguous.
JOBS=${JOBS:-$(nproc 2>/dev/null || echo 1)}
[ "${KEEP:-0}" = 1 ] && JOBS=1

# run_fixture writes its human-readable line to stdout (the caller redirects it
# to a per-fixture .res) and a pass/fail/skip token to $st, so invocations can
# run concurrently without sharing shell state. Uses `return` (not `continue`)
# since it runs as a backgrounded function.
run_fixture() {
  d=$1 st=$2
  name=$(echo "$d" | sed "s#$FIXROOT/##")

  if [ ! -f "$d/meta.txt" ] || [ ! -f "$d/sizes.txt" ]; then
    printf 'SKIP  %-44s (no meta.txt/sizes.txt)\n' "$name"; echo skip >"$st"; return
  fi

  machine=$(effective_machine "$(meta "$d" uname_m_raw)" "$(meta "$d" endianness)")

  if [ "${KASLD_NATIVE:-0}" = 1 ]; then
    # No qemu: only fixtures the host can run directly; binary from build/.
    if ! host_runs_machine "$machine"; then
      printf 'SKIP  %-44s (native mode: non-host arch %s)\n' "$name" "$machine"; echo skip >"$st"; return
    fi
    bindir=$(native_bindir "$machine")
    if [ -z "$bindir" ]; then
      printf 'SKIP  %-44s (native mode: no host binary for %s — run make)\n' "$name" "$machine"; echo skip >"$st"; return
    fi
    kasld="$bindir/kasld"; comps="$bindir/components"; runner=""
  else
    subdir=$(target_triple_for "$machine")
    if [ -z "$subdir" ]; then
      printf 'SKIP  %-44s (no target mapping for uname_m=%s)\n' "$name" "$machine"; echo skip >"$st"; return
    fi
    qbin=$(qemu_for "$subdir")
    # Resolve the build dir by arch glob, not the exact triple: `make cross`
    # (dev) and the cross-tools/musl-cross CI toolchains spell the triple
    # differently (e.g. aarch64-linux-musl vs aarch64-unknown-linux-musl) but
    # share the leading arch component, so glob build/<arch>-* for the binary.
    kasld=""; comps=""
    for bd in "$BUILD_DIR/${subdir%%-*}"-*; do
      [ -x "$bd/kasld" ] && { kasld="$bd/kasld"; comps="$bd/components"; break; }
    done
    if [ -z "$kasld" ]; then
      printf 'SKIP  %-44s (no binary: %s-*/kasld — run make cross)\n' "$name" "${subdir%%-*}"; echo skip >"$st"; return
    fi
    runner=$(resolve_qemu "$qbin")
    if [ -z "$runner" ]; then
      # An empty name is a target qemu has no linux-user binary for at all, so
      # the triple is what identifies it; otherwise name the binary not found.
      printf 'SKIP  %-44s (no qemu: %s)\n' "$name" "${qbin:-none for $subdir}"
      echo skip >"$st"; return
    fi
  fi

  # Reconstruct a scratch sysroot. extra/prepare-bundle owns what that takes --
  # restoring each captured file's true length from sizes.txt and expanding the
  # flattened device tree -- so this harness and an operator preparing the same
  # bundle by hand read the same tree.
  sc=$(mktemp -d)
  if ! "$ROOT/extra/prepare-bundle" "$d" "$sc/r"; then
    printf 'FAIL  %-44s (bundle could not be prepared)\n' "$name"
    echo fail >"$st"; rm -rf "$sc"; return
  fi

  # Release handling: nothing is set, deliberately. Each process reads the
  # fixture's release and version from the captured /proc/version through the
  # sysroot it already inherits, so KASLD_SYSROOT alone gives every component
  # the identity it needs to build a /boot path or a build fingerprint. This
  # is also the recipe the documentation gives, so the sweep exercises what a
  # user runs.
  #
  # KASLD_UNAME_RELEASE would override the release and cover a fixture whose
  # capture states none, which is exactly why it is absent here: setting it
  # would keep the sweep green if the /proc/version read ever broke. QEMU_UNAME
  # is not a substitute either way — qemu does not honor it after the
  # self-re-exec it performs for a foreign-arch component child.
  #
  # KASLD_EXEC_WRAPPER lets the orchestrator's component children execve
  # through the host-arch qemu wrapper instead of trying to execve a guest-
  # arch ELF directly (which the host kernel refuses with ENOEXEC unless
  # binfmt_misc is registered). When $runner is non-empty (foreign-arch
  # fixture) we point KASLD_EXEC_WRAPPER at it; for native-arch fixtures
  # $runner is empty and KASLD_EXEC_WRAPPER stays unset, so the orchestrator
  # takes the production direct-execve path.
  KASLD_SYSROOT="$sc/r" \
    KASLD_COMPONENT_DIR="$comps" KASLD_EXEC_WRAPPER="$runner" \
    $runner "$kasld" -v > "$sc/replay.txt" 2>/dev/null
  rc=$?

  # Smoke verdict: the run must complete without an emulation crash. kasld
  # exits 0 with results, 1 with no tagged results (a valid empty run);
  # anything killed by a signal exits >= 128. A crash on any arch's calling
  # convention is the failure this harness exists to catch.
  #
  # With KASLD_EXEC_WRAPPER pointed at the host qemu binary, foreign-arch
  # component children do exec successfully under nested qemu-user — so
  # both x86 (native) and foreign-arch fixtures should produce results and
  # render a summary.
  has_summary=$(grep -cE '^(========|  KASLR analysis:|Virtual memory layout)' \
    "$sc/replay.txt" 2>/dev/null || true)
  n_results=$(grep -cE '^[VPD] ' "$sc/replay.txt" 2>/dev/null || true)

  # Output-mode sweep: re-run the binary in each remaining output mode and
  # confirm it renders without an emulation crash (signal) and emits that mode's
  # marker. This is per-arch crash coverage of every renderer, which the
  # host-only render unit tests cannot reach. The five renderers are covered by
  # four sweep runs plus the -v main run above: -1 (oneline), and -H / -H -m /
  # -H -j (the hardening detail toggle, which renders the FULL analysis in
  # text / markdown / json *plus* the hardening section — so it also exercises
  # the json and markdown analysis renderers). Bare -j / -m are therefore
  # redundant and omitted, saving two pipeline runs per fixture. -v -m is swept
  # explicitly: it must emit the markdown document AND must NOT leak the plain-
  # text run narration (component banners / wire records), which only text mode
  # streams. Each line is "flags<TAB>marker"; a marker beginning "!" is a
  # negative assertion (the mode must NOT emit it). Skipped if the main run
  # already crashed; read in-shell (heredoc, not a pipe) so the flag survives.
  mode_fail=""
  if [ "$rc" -lt 128 ]; then
    while IFS="$(printf '\t')" read -r mflags marker; do
      [ -n "$mflags" ] || continue
      # shellcheck disable=SC2086  # $runner (may be empty) and $mflags (flag list) split intentionally
      KASLD_SYSROOT="$sc/r" \
        KASLD_COMPONENT_DIR="$comps" KASLD_EXEC_WRAPPER="$runner" \
        $runner "$kasld" $mflags > "$sc/mode.txt" 2>/dev/null
      mrc=$?
      if [ "$mrc" -ge 128 ]; then
        mode_fail="'$mflags' signal $((mrc - 128))"
        break
      fi
      # A marker beginning "!" is a NEGATIVE assertion: the mode must NOT emit
      # it (e.g. a document format must not leak the plain-text run narration).
      case "$marker" in
      "!"*)
        if grep -qE "${marker#!}" "$sc/mode.txt"; then
          mode_fail="'$mflags' leaked disallowed output (${marker#!})"
          break
        fi
        ;;
      *)
        if ! grep -qE "$marker" "$sc/mode.txt"; then
          mode_fail="'$mflags' rendered no output ($marker)"
          break
        fi
        ;;
      esac
    done <<EOF
-1	arch=
-H	Hardening Assessment
-H -m	Hardening Assessment|"hardening"
-H -j	"hardening"
-v -m	# KASLD Results
-v -m	!^(── |\[[.+-]\]|[VPS] )
EOF
  fi

  if [ "$rc" -ge 128 ]; then
    printf 'FAIL  %-44s (crashed under emulation: signal %d)\n' \
      "$name" "$((rc - 128))"
    echo fail >"$st"
  elif [ -n "$mode_fail" ]; then
    printf 'FAIL  %-44s (output mode %s)\n' "$name" "$mode_fail"
    echo fail >"$st"
  elif [ "$has_summary" -gt 0 ]; then
    printf 'PASS  %-44s rc=%d, %d results, all output modes ok\n' \
      "$name" "$rc" "$n_results"
    echo pass >"$st"
  else
    printf 'PASS  %-44s rc=%d, no results, all output modes ok\n' "$name" "$rc"
    echo pass >"$st"
  fi

  if [ "${KEEP:-0}" = 1 ]; then echo "      kept scratch sysroot: $sc"; else rm -rf "$sc"; fi
}

# Launch up to JOBS fixtures concurrently, keyed by a launch index so the
# summary prints in a stable order regardless of finish order. Barrier every
# JOBS launches (POSIX sh has no `wait -n`).
RESDIR=$(mktemp -d)
n=0; running=0
for fx in "${@:-$FIXROOT/*/*}"; do
  # Expand the default glob; skip non-dirs.
  for d in $fx; do
    [ -d "$d" ] || continue
    n=$((n + 1))
    run_fixture "$d" "$RESDIR/$n.st" >"$RESDIR/$n.res" 2>&1 &
    running=$((running + 1))
    if [ "$running" -ge "$JOBS" ]; then wait; running=0; fi
  done
done
wait

# Aggregate in launch order; a missing token (job died) counts as a failure.
i=1
while [ "$i" -le "$n" ]; do
  [ -f "$RESDIR/$i.res" ] && cat "$RESDIR/$i.res"
  case $(cat "$RESDIR/$i.st" 2>/dev/null) in
    pass) pass=$((pass + 1)) ;;
    skip) skip=$((skip + 1)) ;;
    *)    fail=$((fail + 1)) ;;
  esac
  i=$((i + 1))
done
rm -rf "$RESDIR"

echo "----------------------------------------------------------------------"
printf 'replay: %d pass, %d fail, %d skip (JOBS=%s)\n' "$pass" "$fail" "$skip" "$JOBS"
[ "$fail" -eq 0 ]
