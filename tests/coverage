#!/bin/sh
# This file is part of KASLD - https://github.com/bcoles/kasld
#
# coverage — optional line-coverage report from the host unit tests.
#
# Builds the engine core (estimate/quantities/evidence/engine/engine_rules),
# every rules/*.c, and the orchestrator internals + render + region_info (via
# test_kasld and test_render) instrumented with --coverage, runs every test
# driver (accumulating .gcda), and prints a per-file + total line-coverage
# summary via gcov. All artifacts stay under build/coverage/.
#
# Scope note: the orchestrator's engine bridge and main() are compiled out under
# -DKASLD_TESTING, so they read as uncovered here whatever the unit tests do.
# Those are exercised end-to-end by tests/coverage-e2e (the real binary), and
# the two reports are complementary rather than comparable: a file low here may
# be well covered there, and the reverse.
#
# OPTIONAL by design — the normal build/test never use --coverage, so this adds
# no dependency to them. Even here the only requirement is the compiler's own
# gcov (bundled with gcc; for clang run: make coverage GCOV="llvm-cov gcov").
# An HTML report is produced only if lcov+genhtml are installed; otherwise the
# gcov text summary IS the report.
#
# ARCHITECTURE. The figure describes the toolchain that built it, and the total
# says which. A large share of the rule set is arch-gated: off its own
# architecture a rule compiles to a stub of a couple of lines, which the report
# then scores as fully covered — so the host measures neither the real body nor
# admits the omission, and a rule reading "100.00% of 2 lines" is one whose
# architecture this run did not build. Building with a cross toolchain measures
# that architecture's bodies instead, with the drivers run under qemu-user,
# resolved from the compiler's triple.
#
# No single architecture shows everything: each stubs out the others' rules, so
# these are per-architecture reports rather than one number, and nothing merges
# them — gcda from two architectures describes two different sets of lines.
#
# Exact counts are deliberately not quoted here. They move with every rule added
# or gated, and nothing checks a number written in a comment.
#
# Usage:  tests/coverage            (or: make coverage)
# Env:    CC (default cc), GCOV (default gcov), CFLAGS_EXTRA, QEMU_DIR
#   clang:                make coverage CC=clang GCOV="llvm-cov gcov"
#   a musl cross gcc on a glibc host (binary needs its own loader):
#                         make coverage CC=<triple>-gcc GCOV=<triple>-gcov \
#                              CFLAGS_EXTRA=-static
#   another architecture (adds qemu-user; same form, foreign triple):
#                         make coverage CC=aarch64-linux-musl-gcc \
#                              GCOV=aarch64-linux-musl-gcov CFLAGS_EXTRA=-static
# ---
# <bcoles@gmail.com>

# This is a build script: $CC/$CFLAGS/$OBJS/$PTH_* hold a command and flag/file
# lists that must word-split into argv on every compile and link line.
# shellcheck disable=SC2086
set -u
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
# shellcheck source=tests/lib/qemu-target.sh
. "$ROOT/tests/lib/qemu-target.sh"
CC=${CC:-cc}
GCOV=${GCOV:-gcov}
COV=$ROOT/build/coverage
CFLAGS="-std=c99 -g -O0 --coverage -I$ROOT/src ${CFLAGS_EXTRA:-}"

command -v "$CC" >/dev/null 2>&1 || { echo "coverage: CC '$CC' not found" >&2; exit 1; }
if ! $GCOV --version >/dev/null 2>&1; then
  echo "coverage: '$GCOV' not found. gcov ships with gcc; for clang run:" >&2
  echo "          make coverage GCOV=\"llvm-cov gcov\"" >&2
  exit 1
fi

rm -rf "$COV"; mkdir -p "$COV"

# A foreign-arch toolchain builds drivers this host cannot exec, so they run
# through qemu-user. Whether that is needed is settled by BUILDING the smallest
# possible program and trying it, not by matching the triple against uname: a
# 32-bit x86 driver runs natively on an x86_64 host while its triple says
# otherwise, and a same-arch musl toolchain is native too once -static drops the
# loader. Same shape as the pthread probe below.
RUNNER=""
if echo 'int main(void){return 0;}' |
     $CC ${CFLAGS_EXTRA:-} -xc - -o "$COV/.exe" 2>/dev/null; then
  if ! "$COV/.exe" >/dev/null 2>&1; then
    RUNNER=$(resolve_qemu "$(qemu_for "${CC##*/}")") || RUNNER=""
    if [ -z "$RUNNER" ]; then
      echo "coverage: $CC builds binaries this host cannot run, and no qemu-user" >&2
      echo "          binary was found for it. Set QEMU_DIR, or use a native CC." >&2
      rm -f "$COV/.exe"; exit 1
    fi
  fi
  rm -f "$COV/.exe"
fi

# Which architecture's bodies this report describes. An arch-gated rule compiles
# to a two-line stub off its own architecture, so the same command under a cross
# toolchain measures a different set of lines; labelling every run "host" would
# hide that.
if [ -n "$RUNNER" ]; then
  COV_LABEL=${CC##*/}; COV_LABEL=${COV_LABEL%%-*}
else
  COV_LABEL=host
fi

# Instrumented objects under report (engine core + every rule). Absolute source
# paths so gcov resolves them; .gcno/.gcda stay beside each .o in $COV.
SRC="$ROOT/src/estimate.c $ROOT/src/quantities.c $ROOT/src/evidence.c \
     $ROOT/src/engine.c $ROOT/src/engine_rules.c $(echo "$ROOT"/src/rules/*.c)"
OBJS=""; GCNO=""
for s in $SRC; do
  b=$(basename "${s%.c}")
  $CC $CFLAGS -c "$s" -o "$COV/$b.o" || { echo "coverage: compile failed: $s" >&2; exit 1; }
  OBJS="$OBJS $COV/$b.o"; GCNO="$GCNO $b.gcno"
done

# Driver compiled to its own object too, so test_*.c .gcno never pollutes the
# tree; then linked against the shared instrumented objects and run. .gcda from
# every run accumulates onto the shared objects.
drive() { # <out> <driver.c> <objs...>
  out=$1; drv=$2; shift 2
  $CC $CFLAGS -c "$ROOT/tests/$drv" -o "$COV/$out.drv.o" \
    || { echo "coverage: compile failed: $drv" >&2; exit 1; }
  $CC $CFLAGS "$COV/$out.drv.o" "$@" -o "$COV/$out" \
    || { echo "coverage: link failed: $out" >&2; exit 1; }
  $RUNNER "$COV/$out" >/dev/null 2>&1 || { echo "coverage: $out FAILED (tests must pass first)" >&2; exit 1; }
}
drive engine      test_engine.c             $OBJS
drive integration test_engine_integration.c $OBJS
drive estimate    test_estimate.c           "$COV/estimate.o" "$COV/quantities.o"
drive evidence    test_evidence.c           "$COV/evidence.o"

# Orchestrator internals + environment + render + region_info: test_kasld.c is
# ONE TU that #includes the sources under test directly, under -DKASLD_TESTING
# (which compiles out main() + the engine bridge — those lines are only covered
# by the end-to-end run, tests/coverage-e2e). pthread is added when available,
# matching what `make test` builds.
PTH_C=""; PTH_L=""
if echo 'int main(void){return 0;}' | $CC -xc - -lpthread -o "$COV/.pthr" 2>/dev/null; then
  PTH_C="-DHAVE_PTHREAD"; PTH_L="-lpthread"; rm -f "$COV/.pthr"
fi
# test_render.c is a second such TU over the SAME sources: it holds the renderer
# tests that were split out of test_kasld, and without it every renderer reads
# 0% here while a passing driver exercises it. Two translation units compiling
# one source is why the report below unions executed line numbers rather than
# averaging each unit's percentage — the same line covered by both is one line
# covered, and a file compiled twice is not twice as much code.
for drv in test_kasld test_render; do
  $CC $CFLAGS -DKASLD_TESTING $PTH_C -c "$ROOT/tests/$drv.c" -o "$COV/$drv.drv.o" \
    || { echo "coverage: compile failed: $drv.c" >&2; exit 1; }
  $CC $CFLAGS "$COV/$drv.drv.o" $PTH_L -o "$COV/$drv" \
    || { echo "coverage: link failed: $drv" >&2; exit 1; }
  $RUNNER "$COV/$drv" >/dev/null 2>&1 \
    || { echo "coverage: $drv FAILED (tests must pass first)" >&2; exit 1; }
done

# Per-file + weighted-total line coverage, over every .gcno. Report only our
# src/*.c sources — gcov also emits an entry per included header
# (observation.h, api.h, ...) and per test driver, which we drop; header-inline
# coverage is folded into each TU's .c.
#
# Read per-line (gcov -t, to stdout) and UNIONED by source line number, not
# averaged from each unit's percentage. Two drivers compile the same sources
# into separate translation units, so a source appears in more than one .gcno:
# a line either driver executed is covered, and the file's line count is its
# own, not the sum of the units that included it. Averaging percentages would
# report a file compiled twice as twice the code and halve a line only one
# driver reaches.
#
# A line arrives as "<count>:<lineno>:<text>", where <count> is ##### for never
# executed, - for a line carrying no code, and a number otherwise.
echo "----------------------------------------------------------------------"
( cd "$COV" && for g in ./*.gcno; do $GCOV -t "$g" 2>/dev/null; done ) |
  awk -v label="$COV_LABEL" '
  /^ *-: *0:Source:/ { f=$0; sub(/.*Source:/,"",f)
                       keep = (f ~ /(^|\/)src\/.*\.c$/); next }
  !keep { next }
  {
    split($0, p, ":")
    cnt=p[1]; ln=p[2]+0
    gsub(/[ \t]/,"",cnt)
    if (ln == 0 || cnt == "-") next
    key = f SUBSEP ln
    if (!(key in seen)) { seen[key]=1; total[f]++ }
    if (cnt != "#####" && !(key in hit)) { hit[key]=1; done[f]++ }
  }
  END {
    for (f in total) {
      bn=f; sub(/.*\//,"",bn)
      printf "  %-34s %6.2f%%  of %4d lines\n", bn, 100*done[f]/total[f], total[f]
      ex += done[f]; all += total[f]
    }
    if (all>0) printf "~TOTAL~  %-34s %6.2f%%  of %4d lines\n",
                      "TOTAL (" label " unit tests)", 100*ex/all, all
  }' | sort -k1,1 | sed 's/^~TOTAL~//'
echo "----------------------------------------------------------------------"
echo "coverage: built with $CC, reported via $GCOV; artifacts in $COV"

# Optional HTML — only if the tools are present (never a hard dependency).
if command -v lcov >/dev/null 2>&1 && command -v genhtml >/dev/null 2>&1; then
  lcov --quiet --capture --directory "$COV" --output-file "$COV/coverage.info" 2>/dev/null \
    && genhtml --quiet --output-directory "$COV/html" "$COV/coverage.info" 2>/dev/null \
    && echo "coverage: HTML report -> $COV/html/index.html"
else
  echo "coverage: (install lcov+genhtml for an optional HTML report)"
fi
