#!/bin/sh
# This file is part of KASLD - https://github.com/bcoles/kasld
#
# check-readout-docs — keep documented sample output honest.
#
# The README and docs carry hand-maintained copies of rendered output. Nothing
# ties them to the renderer, so a column or vocabulary change silently leaves
# them describing a version of the tool that no longer exists. That has now
# happened repeatedly, and each time it was caught by grep rather than a gate.
#
# Four checks. The first three are pure text and run everywhere; the fourth
# replays a capture and skips where the host binary is not built:
#
#   1. Retired vocabulary. Any string the renderer no longer emits must not
#      survive in a sample. Add a row when you rename something.
#   2. Sample width. The readout is designed to fit 100 columns; a documented
#      sample wider than that is either stale or documents a regression.
#   3. Sample counts. The component tally in a captured run has to hold
#      together. It cannot be derived from the tree in full -- how many
#      components produce a runnable binary depends on which are arch-gated for
#      the host that captured the sample, which no amount of text tells us -- so
#      what is checked is what a partial edit breaks: the arithmetic inside a
#      sample, agreement between samples, the progress line beneath it, and the
#      one term the source does fix.
#
#      That last term is the experimental count: a component declares itself
#      with `status:experimental` in its KASLD_META, so promoting one out of
#      experimental changes a number in the README and nothing says so. The
#      drift this file exists for was that shape -- a count fourteen behind,
#      found by eye rather than by a gate.
#   4. Replayed blocks. A block a document presents AS output must be output.
#      The three checks above police vocabulary and arithmetic, which a sample
#      composed from several runs passes while describing a run that never
#      happened -- one held a bare "-" candidate count beside an entropy line
#      that prints only when the count is above zero, and two region rows whose
#      stated counts were each one short of what their own windows imply. So a
#      block marked `<!-- replay: <fixture> <flags> -->` is re-derived: the run
#      is repeated and the block must appear in it as a CONTIGUOUS run of lines.
#      Contiguity is the load-bearing part -- it is what a composite fails.
#
#      This one needs the host binary and skips without it, unlike the three
#      above.
# ---
# <bcoles@gmail.com>

set -u
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

if [ -t 1 ] || [ -n "${KASLD_COLOR:-}" ]; then
  RED=$(printf '\033[31m')
  GREEN=$(printf '\033[32m')
  RESET=$(printf '\033[0m')
else
  RED=
  GREEN=
  RESET=
fi

fail=0
# `while read` runs in a subshell here (it is fed by a pipe), so a failure it
# finds cannot set `fail` directly; it appends to this file instead.
countfail=$(mktemp) || exit 1
trap 'rm -f "$countfail"' EXIT
DOCS="$ROOT/README.md $ROOT/docs/usage.md $ROOT/docs/architecture.md"
DOCS="$DOCS $ROOT/docs/exploitation.md"

# 1. Retired strings: "what it used to say" per line. Tab-separated so the
#    replacement text can contain spaces.
retired_check() {
  old=$1
  new=$2
  # Word splitting is intended: DOCS is a space-separated file list.
  # shellcheck disable=SC2086
  hits=$(grep -Fn -- "$old" $DOCS 2>/dev/null || true)
  if [ -n "$hits" ]; then
    printf '%scheck-readout-docs: FAIL%s (retired %s -- now %s)\n' \
      "$RED" "$RESET" "$old" "$new"
    printf '%s\n' "$hits" | sed 's/^/  /'
    fail=1
  fi
}

retired_check 'Leaks (' 'Evidence ('
retired_check '## Leak Results' '## Evidence'
retired_check 'not derandomized' 'a Candidates count'
retired_check 'Virtual memory layout' 'Virtual address space'
retired_check 'Physical memory layout' 'Physical address space'
retired_check '## Memory layout' '## Address space'
retired_check 'virt_page_offset_base 0x' 'Direct Map Base (prose label)'
retired_check '(base; extent unknown)' '(base proven; extent unknown)'
retired_check '(base proven; extent unknown)' '(base proven) / (base is a lower bound)'
retired_check 'Virtual address space (coupled):' 'Virtual address space (coupled, not to scale):'
retired_check 'Virtual address space (decoupled):' 'Virtual address space (decoupled, not to scale):'
retired_check 'Physical address space:' 'Physical address space (not to scale):'
retired_check ' candidates,' ' a Candidates count'
# The compile-time default is not a value row and no posture names a base after
# it: it is the origin a slide is measured from, and elsewhere a remark.
retired_check 'Default image base' 'from compile-time default 0x...'
retired_check 'Default phys base' 'from compile-time default 0x...'
retired_check 'arch default, no randomization' 'the engine-resolved base'
retired_check 'compile-time default, no slide' 'the engine-resolved base'
retired_check 'base not pinned to a single default' 'the engine-resolved range'
retired_check 'assumes default config' 'the engine-resolved base'
retired_check '(default for arch)' 'the engine-resolved base'
# The readout is a table: one row per (quantity, basis), the candidate count in
# its own headed column. The two grades are one word each.
retired_check 'narrowed to ~' 'a Candidates count on the row'
retired_check 'likely (speculative)' 'likely'
retired_check 'best guess' 'likely'
retired_check 'Inferred text range' 'Guaranteed text range'
retired_check 'Inferred phys text range' 'Guaranteed phys text range'
retired_check 'Likely text range' 'the Layout table'

# 2. Width of the readout sample blocks. Only lines inside a fenced block that
#    contains the readout's own headings are measured -- other fenced blocks
#    hold JSON, shell transcripts and tables with their own conventions.
# Word splitting is intended: DOCS is a space-separated file list.
# shellcheck disable=SC2086
too_wide=$(awk '
  /^```/       { infence = !infence; if (!infence) { readout = 0 } ; next }
  !infence     { next }
  /^(Layout|Evidence  \()/ { readout = 1 }
  readout && length($0) > 100 {
    printf "%s:%d: %d cols: %s\n", FILENAME, FNR, length($0), $0
  }
' $DOCS)

if [ -n "$too_wide" ]; then
  printf '%scheck-readout-docs: FAIL%s (sample lines over 100 columns)\n' \
    "$RED" "$RESET"
  printf '%s\n' "$too_wide" | sed 's/^/  /'
  fail=1
fi

# ---- 3. Sample counts ------------------------------------------------------
# "Running <ran> of <total> components (<exp> experimental skipped; ...)", and
# the "100%  <ran>/<ran>" progress line that follows it.
exp_declared=$(grep -l 'status:experimental' "$ROOT"/src/components/*.c 2>/dev/null |
               wc -l | tr -d ' ')
# Intentional word-split of the doc list into grep's argv, as above.
# shellcheck disable=SC2086
tally=$(grep -Hn 'Running [0-9]* of [0-9]* components' $DOCS 2>/dev/null || true)

if [ -z "$tally" ]; then
  printf '%scheck-readout-docs: FAIL%s (no sample carries a component tally --\n' \
    "$RED" "$RESET"
  printf '  the count check is asserting nothing; a sample was renamed or removed)\n'
  fail=1
fi

seen=
printf '%s\n' "$tally" | while IFS= read -r hit; do
  [ -n "$hit" ] || continue
  file=${hit%%:*}
  rest=${hit#*:}
  lno=${rest%%:*}
  ran=$(printf '%s' "$rest" | sed -n 's/.*Running \([0-9]*\) of .*/\1/p')
  total=$(printf '%s' "$rest" | sed -n 's/.*Running [0-9]* of \([0-9]*\) components.*/\1/p')
  exp=$(printf '%s' "$rest" | sed -n 's/.*(\([0-9]*\) experimental skipped.*/\1/p')

  if [ -z "$exp" ]; then
    printf '  %s:%s tallies components but does not say how many were skipped\n' \
      "$file" "$lno"
    echo BAD >>"$countfail"
    continue
  fi
  if [ "$((ran + exp))" -ne "$total" ]; then
    printf '  %s:%s does not add up: %s ran + %s skipped != %s total\n' \
      "$file" "$lno" "$ran" "$exp" "$total"
    echo BAD >>"$countfail"
  fi
  if [ "$exp" -ne "$exp_declared" ]; then
    printf '  %s:%s says %s experimental skipped, but %s components declare status:experimental\n' \
      "$file" "$lno" "$exp" "$exp_declared"
    echo BAD >>"$countfail"
  fi
  bar=$(sed -n "$((lno + 1)),$((lno + 3))p" "$file" |
        sed -n 's/.*100%  *\([0-9]*\)\/\([0-9]*\).*/\1 \2/p' | head -1)
  if [ -n "$bar" ]; then
    if [ "${bar%% *}" != "$ran" ] || [ "${bar##* }" != "$ran" ]; then
      printf '  %s:%s runs %s components but its progress line reports %s\n' \
        "$file" "$lno" "$ran" "$bar"
      echo BAD >>"$countfail"
    fi
  fi
  if [ -n "$seen" ] && [ "$seen" != "$ran/$total" ]; then
    printf '  samples disagree: %s vs %s (%s:%s)\n' "$seen" "$ran/$total" "$file" "$lno"
    echo BAD >>"$countfail"
  fi
  seen="$ran/$total"
done

if [ -s "$countfail" ]; then
  printf '%scheck-readout-docs: FAIL%s (sample component tallies)\n' "$RED" "$RESET"
  fail=1
fi

# ---- 4. Replayed sample blocks --------------------------------------------
# Marker syntax, on the line before the fence:  <!-- replay: <fixture> <flags> -->
# The fixture is a directory holding a sysroot/; the flags are passed to kasld.
HOST_TRIPLE=$(cc -dumpmachine 2>/dev/null || echo unknown)
BIN="$ROOT/build/$HOST_TRIPLE/kasld"
replayed=0
# Which capture this host can replay. The layout windows are compiled in, so an
# aarch64 build reading an x86_64 capture renders a different table -- correct
# for that build, and nothing like what the document shows. The fixture tree
# names each capture's architecture in its directory; this is the same name for
# the binary. Ordered longest-first: mips64 is not mips32, and aarch64 is not
# arm. `unknown` matches no fixture, which is the safe answer.
case ${HOST_TRIPLE%%-*} in
x86_64 | amd64) host_arch=x86_64 ;;
i?86) host_arch=x86_32 ;;
aarch64) host_arch=arm64 ;;
arm*) host_arch=arm32 ;;
mips64*) host_arch=mips64 ;;
mips*) host_arch=mips32 ;;
powerpc64* | ppc64*) host_arch=ppc64 ;;
powerpc* | ppc*) host_arch=ppc32 ;;
riscv64) host_arch=riscv64 ;;
riscv32) host_arch=riscv32 ;;
s390*) host_arch=s390 ;;
loongarch64) host_arch=loongarch64 ;;
*) host_arch=unknown ;;
esac
# As with the tally loop above, this one is fed by a pipe and runs in a
# subshell, so a failure it finds is recorded in a file rather than in `fail`.
blockfail=$(mktemp) || exit 1
skipped=$(mktemp) || exit 1
trap 'rm -f "$countfail" "$blockfail" "$skipped"' EXIT
if [ ! -x "$BIN" ]; then
  printf '  (replayed blocks not checked: no host binary at %s)\n' "$BIN"
else
  run_f=$(mktemp) || exit 1
  blk_f=$(mktemp) || exit 1
  trap 'rm -f "$countfail" "$blockfail" "$skipped" "$run_f" "$blk_f"' EXIT
  # Word splitting is intended: DOCS is a space-separated file list.
  # shellcheck disable=SC2086
  markers=$(grep -Hn -- '<!-- replay: ' $DOCS 2>/dev/null || true)
  printf '%s\n' "$markers" | while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    file=${hit%%:*}
    rest=${hit#*:}
    lno=${rest%%:*}
    spec=$(printf '%s' "${rest#*:}" | sed -n 's/.*<!-- replay: \(.*\) -->.*/\1/p')
    fixture=${spec%% *}
    # No space means no flags, and ${spec#* } would leave the fixture itself
    # there -- passed to kasld as an argument.
    case $spec in
    *' '*) flags=${spec#* } ;;
    *) flags= ;;
    esac
    if [ ! -d "$ROOT/$fixture/sysroot" ]; then
      printf '  %s:%s names no fixture: %s\n' "$file" "$lno" "$fixture"
      echo BAD >>"$blockfail"
      continue
    fi
    # Skipped rather than failed where the host cannot render this capture: the
    # block is still checked wherever a matching build exists, and a host that
    # cannot check it must not report it wrong.
    if [ "$(printf '%s' "$fixture" | sed -n 's#^tests/fixtures/\([^/]*\)/.*#\1#p')" \
      != "$host_arch" ]; then
      printf '  (skipped %s:%s: this %s build cannot render that capture)\n' \
        "$file" "$lno" "$host_arch"
      echo SKIP >>"$skipped"
      continue
    fi
    # The command printed for the reader has to be the one that was run, or the
    # block is reproducible only by someone who reads this guard. Searched from
    # the top of the document rather than a fixed window above the block: a
    # second excerpt of the same run is introduced as such rather than by
    # restating the command, and a window wide enough for that is a number with
    # nothing behind it. The marker's own line is excluded, or the marker would
    # satisfy the check by naming the fixture itself.
    if ! sed -n "1,$((lno - 1))p" "$file" | grep -Fq -- "$fixture"; then
      printf '  %s:%s replays %s, which no command in the document names\n' \
        "$file" "$lno" "$fixture"
      echo BAD >>"$blockfail"
      continue
    fi
    # The fence has to open on the very next line. Anything between the two --
    # a blank line is enough -- makes the extraction below stop at the OPENING
    # fence and keep what preceded it, and a block of one blank line matches
    # any run that contains a blank line. A vacuous pass is the failure this
    # check exists to prevent, so the layout is required rather than assumed.
    if [ "$(sed -n "$((lno + 1))p" "$file")" != '```' ]; then
      printf '  %s:%s is not immediately followed by a fenced block\n' \
        "$file" "$lno"
      echo BAD >>"$blockfail"
      continue
    fi
    # The block: the fence opening on the next line, to its closing fence.
    sed -n "$((lno + 2)),\$p" "$file" |
      awk '/^```/ { exit } { sub(/[[:space:]]+$/, ""); print }' >"$blk_f"
    if [ ! -s "$blk_f" ]; then
      printf '  %s:%s marks no fenced block\n' "$file" "$lno"
      echo BAD >>"$blockfail"
      continue
    fi
    # Word splitting is intended: the flags are a command line.
    # shellcheck disable=SC2086
    KASLD_SYSROOT="$ROOT/$fixture/sysroot" "$BIN" $flags 2>/dev/null |
      sed 's/[[:space:]]*$//' >"$run_f"
    # Contiguous-substring test: every block line must match the run, in order,
    # from one starting offset. Trailing whitespace is stripped from both --
    # the Layout header pads its last column, and the documents carry none.
    if ! awk '
      NR == FNR { blk[FNR] = $0; n = FNR; next }
      { run[FNR] = $0; m = FNR }
      END {
        for (s = 1; s + n - 1 <= m; s++) {
          for (i = 1; i <= n; i++)
            if (run[s + i - 1] != blk[i]) break
          if (i > n) exit 0
        }
        exit 1
      }' "$blk_f" "$run_f"; then
      printf '  %s:%s is not a contiguous excerpt of: KASLD_SYSROOT=%s/sysroot kasld %s\n' \
        "$file" "$lno" "$fixture" "$flags"
      echo BAD >>"$blockfail"
    fi
  done
  # Word splitting is intended, as above. Counted with grep and wc rather than
  # summed per file, so the check needs no `bc` -- a host without it would
  # otherwise reach the zero test below and fail for having no calculator.
  # SC2126: `grep -c` over several files prints one count per file, which is
  # what needed summing in the first place.
  # shellcheck disable=SC2086,SC2126
  replayed=$(grep -h -- '<!-- replay: ' $DOCS 2>/dev/null | wc -l)
  replayed=$((replayed - $(wc -l <"$skipped")))
  if [ "${replayed:-0}" -eq 0 ]; then
    printf '%scheck-readout-docs: FAIL%s (no document marks a replayed block --\n' \
      "$RED" "$RESET"
    printf '  the excerpt check is asserting nothing; a marker was renamed or removed)\n'
    fail=1
  fi
fi

if [ -s "$blockfail" ]; then
  printf '%scheck-readout-docs: FAIL%s (replayed sample blocks)\n' "$RED" "$RESET"
  fail=1
fi

if [ "$fail" -eq 0 ]; then
  # The block count is stated only where blocks were actually re-derived, so a
  # run that checked none cannot read as having checked them and found nothing.
  if [ "$replayed" -gt 0 ]; then
    verdict="tallies consistent, $replayed replayed block(s) verbatim"
  else
    verdict="tallies consistent"
  fi
  printf '%scheck-readout-docs: OK%s (samples use current vocabulary, within 100 cols, %s)\n' \
    "$GREEN" "$RESET" "$verdict"
fi
exit "$fail"
