#!/bin/sh
# This file is part of KASLD - https://github.com/bcoles/kasld
#
# check-readout-docs — keep documented sample output honest.
#
# The README and docs carry hand-maintained copies of rendered output. Nothing
# ties them to the renderer, so a column or vocabulary change silently leaves
# them describing a version of the tool that no longer exists. That has now
# happened repeatedly, and each time it was caught by grep rather than a gate.
#
# Two checks, both pure text (no binary needed, so this runs everywhere):
#
#   1. Retired vocabulary. Any string the renderer no longer emits must not
#      survive in a sample. Add a row when you rename something.
#   2. Sample width. The readout is designed to fit 100 columns; a documented
#      sample wider than that is either stale or documents a regression.
#   3. Sample counts. The component tally in a captured run has to hold
#      together. It cannot be derived from the tree in full -- how many
#      components produce a runnable binary depends on which are arch-gated for
#      the host that captured the sample, which no amount of text tells us -- so
#      what is checked is what a partial edit breaks: the arithmetic inside a
#      sample, agreement between samples, the progress line beneath it, and the
#      one term the source does fix.
#
#      That last term is the experimental count: a component declares itself
#      with `status:experimental` in its KASLD_META, so promoting one out of
#      experimental changes a number in the README and nothing says so. The
#      drift this file exists for was that shape -- a count fourteen behind,
#      found by eye rather than by a gate.
# ---
# <bcoles@gmail.com>

set -u
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

if [ -t 1 ] || [ -n "${KASLD_COLOR:-}" ]; then
  RED=$(printf '\033[31m')
  GREEN=$(printf '\033[32m')
  RESET=$(printf '\033[0m')
else
  RED=
  GREEN=
  RESET=
fi

fail=0
# `while read` runs in a subshell here (it is fed by a pipe), so a failure it
# finds cannot set `fail` directly; it appends to this file instead.
countfail=$(mktemp) || exit 1
trap 'rm -f "$countfail"' EXIT
DOCS="$ROOT/README.md $ROOT/docs/usage.md $ROOT/docs/architecture.md"
DOCS="$DOCS $ROOT/docs/exploitation.md"

# 1. Retired strings: "what it used to say" per line. Tab-separated so the
#    replacement text can contain spaces.
retired_check() {
  old=$1
  new=$2
  # Word splitting is intended: DOCS is a space-separated file list.
  # shellcheck disable=SC2086
  hits=$(grep -Fn -- "$old" $DOCS 2>/dev/null || true)
  if [ -n "$hits" ]; then
    printf '%scheck-readout-docs: FAIL%s (retired %s -- now %s)\n' \
      "$RED" "$RESET" "$old" "$new"
    printf '%s\n' "$hits" | sed 's/^/  /'
    fail=1
  fi
}

retired_check 'Leaks (' 'Evidence ('
retired_check '## Leak Results' '## Evidence'
retired_check 'not derandomized' 'a Candidates count'
retired_check 'Virtual memory layout' 'Virtual address space'
retired_check 'Physical memory layout' 'Physical address space'
retired_check '## Memory layout' '## Address space'
retired_check 'virt_page_offset_base 0x' 'Direct Map Base (prose label)'
retired_check '(base; extent unknown)' '(base proven; extent unknown)'
retired_check '(base proven; extent unknown)' '(base proven) / (base is a lower bound)'
retired_check 'Virtual address space (coupled):' 'Virtual address space (coupled, not to scale):'
retired_check 'Virtual address space (decoupled):' 'Virtual address space (decoupled, not to scale):'
retired_check 'Physical address space:' 'Physical address space (not to scale):'
retired_check ' candidates,' ' a Candidates count'
# The compile-time default is not a value row and no posture names a base after
# it: it is the origin a slide is measured from, and elsewhere a remark.
retired_check 'Default image base' 'from compile-time default 0x...'
retired_check 'Default phys base' 'from compile-time default 0x...'
retired_check 'arch default, no randomization' 'the engine-resolved base'
retired_check 'compile-time default, no slide' 'the engine-resolved base'
retired_check 'base not pinned to a single default' 'the engine-resolved range'
retired_check 'assumes default config' 'the engine-resolved base'
retired_check '(default for arch)' 'the engine-resolved base'
# The readout is a table: one row per (quantity, basis), the candidate count in
# its own headed column. The two grades are one word each.
retired_check 'narrowed to ~' 'a Candidates count on the row'
retired_check 'likely (speculative)' 'likely'
retired_check 'best guess' 'likely'
retired_check 'Inferred text range' 'Guaranteed text range'
retired_check 'Inferred phys text range' 'Guaranteed phys text range'
retired_check 'Likely text range' 'the Layout table'

# 2. Width of the readout sample blocks. Only lines inside a fenced block that
#    contains the readout's own headings are measured -- other fenced blocks
#    hold JSON, shell transcripts and tables with their own conventions.
# Word splitting is intended: DOCS is a space-separated file list.
# shellcheck disable=SC2086
too_wide=$(awk '
  /^```/       { infence = !infence; if (!infence) { readout = 0 } ; next }
  !infence     { next }
  /^(Layout|Evidence  \()/ { readout = 1 }
  readout && length($0) > 100 {
    printf "%s:%d: %d cols: %s\n", FILENAME, FNR, length($0), $0
  }
' $DOCS)

if [ -n "$too_wide" ]; then
  printf '%scheck-readout-docs: FAIL%s (sample lines over 100 columns)\n' \
    "$RED" "$RESET"
  printf '%s\n' "$too_wide" | sed 's/^/  /'
  fail=1
fi

# ---- 3. Sample counts ------------------------------------------------------
# "Running <ran> of <total> components (<exp> experimental skipped; ...)", and
# the "100%  <ran>/<ran>" progress line that follows it.
exp_declared=$(grep -l 'status:experimental' "$ROOT"/src/components/*.c 2>/dev/null |
               wc -l | tr -d ' ')
# Intentional word-split of the doc list into grep's argv, as above.
# shellcheck disable=SC2086
tally=$(grep -Hn 'Running [0-9]* of [0-9]* components' $DOCS 2>/dev/null || true)

if [ -z "$tally" ]; then
  printf '%scheck-readout-docs: FAIL%s (no sample carries a component tally --\n' \
    "$RED" "$RESET"
  printf '  the count check is asserting nothing; a sample was renamed or removed)\n'
  fail=1
fi

seen=
printf '%s\n' "$tally" | while IFS= read -r hit; do
  [ -n "$hit" ] || continue
  file=${hit%%:*}
  rest=${hit#*:}
  lno=${rest%%:*}
  ran=$(printf '%s' "$rest" | sed -n 's/.*Running \([0-9]*\) of .*/\1/p')
  total=$(printf '%s' "$rest" | sed -n 's/.*Running [0-9]* of \([0-9]*\) components.*/\1/p')
  exp=$(printf '%s' "$rest" | sed -n 's/.*(\([0-9]*\) experimental skipped.*/\1/p')

  if [ -z "$exp" ]; then
    printf '  %s:%s tallies components but does not say how many were skipped\n' \
      "$file" "$lno"
    echo BAD >>"$countfail"
    continue
  fi
  if [ "$((ran + exp))" -ne "$total" ]; then
    printf '  %s:%s does not add up: %s ran + %s skipped != %s total\n' \
      "$file" "$lno" "$ran" "$exp" "$total"
    echo BAD >>"$countfail"
  fi
  if [ "$exp" -ne "$exp_declared" ]; then
    printf '  %s:%s says %s experimental skipped, but %s components declare status:experimental\n' \
      "$file" "$lno" "$exp" "$exp_declared"
    echo BAD >>"$countfail"
  fi
  bar=$(sed -n "$((lno + 1)),$((lno + 3))p" "$file" |
        sed -n 's/.*100%  *\([0-9]*\)\/\([0-9]*\).*/\1 \2/p' | head -1)
  if [ -n "$bar" ]; then
    if [ "${bar%% *}" != "$ran" ] || [ "${bar##* }" != "$ran" ]; then
      printf '  %s:%s runs %s components but its progress line reports %s\n' \
        "$file" "$lno" "$ran" "$bar"
      echo BAD >>"$countfail"
    fi
  fi
  if [ -n "$seen" ] && [ "$seen" != "$ran/$total" ]; then
    printf '  samples disagree: %s vs %s (%s:%s)\n' "$seen" "$ran/$total" "$file" "$lno"
    echo BAD >>"$countfail"
  fi
  seen="$ran/$total"
done

if [ -s "$countfail" ]; then
  printf '%scheck-readout-docs: FAIL%s (sample component tallies)\n' "$RED" "$RESET"
  fail=1
fi

if [ "$fail" -eq 0 ]; then
  printf '%scheck-readout-docs: OK%s (samples use current vocabulary, within 100 cols, tallies consistent)\n' \
    "$GREEN" "$RESET"
fi
exit "$fail"
