#!/bin/sh
# This file is part of KASLD - https://github.com/bcoles/kasld
#
# check-image-size — enforce the kernel image-size access contract.
#
# The kernel image footprint is a two-ended interval. A rule reads it ONLY
# through the two accessors in kasld/evidence.h:
#   evidence_image_size_min()  — proven LOWER bound (ceiling / exclusion / match)
#   evidence_image_size_max()  — proven UPPER bound on the in-image extent
#                                (the image-base floor rule)
# A rule that scans the raw SF_IMAGE_SIZE_MIN / SF_IMAGE_SIZE_MAX facts itself
# re-derives "which end is sound here" per-rule — exactly how the size logic
# drifted before. Fail if any rule references those facts directly; route it
# through an accessor instead. The emitters (src/components) and the accessors
# (src/include) legitimately name the facts and are out of scope here.
#
# Usage: tests/check-image-size   (also run by `make test`)
# ---
# <bcoles@gmail.com>

set -u
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
RULES=$ROOT/src/rules

if [ -t 2 ] || [ -n "${KASLD_COLOR:-}" ]; then
  RED=$(printf '\033[31m'); GREEN=$(printf '\033[32m'); RESET=$(printf '\033[0m')
else
  RED=; GREEN=; RESET=
fi

# Direct fact references in rule code. Drop comment lines (//, /* ..., and block
# continuation * ...) so a comment naming the fact does not trip the guard.
bad=$(grep -rnE 'SF_IMAGE_SIZE_(MIN|MAX)' "$RULES" 2>/dev/null \
      | grep -vE ':[0-9]+:[[:space:]]*(//|/?\*)')

if [ -n "$bad" ]; then
  printf '%scheck-image-size: FAIL%s — rule(s) read a raw SF_IMAGE_SIZE_* fact\n' \
    "$RED" "$RESET" >&2
  echo "directly. Read size via evidence_image_size_min() (ceiling/exclusion/" >&2
  echo "match) or evidence_image_size_max() (image-base floor) instead:" >&2
  printf '%s\n' "$bad" | sed 's/^/  /' >&2
  exit 1
fi

# The other half of the contract, on the emitting side: a reader must not band
# its own return value. Each one that did stated the band itself, and one of
# them stated only the lower half -- an x86 bzImage init_size was returned
# unclamped, so a corrupted field became a multi-gigabyte footprint, emitted as
# the lower bound that the ceiling rules subtract from a window top. The band
# belongs in one place, so KIMG_MIN_BYTES / KIMG_MAX_BYTES may be named only by
# their own definitions and by kasld_image_size_plausible(); every reader
# returns through that. A new reader adding its own comparison trips this.
KIMG=$ROOT/src/include/kasld/kernel_image.h
# One file, so grep -n prefixes "<line>:" with no leading colon.
band=$(grep -nE 'KIMG_(MIN|MAX)_BYTES' "$KIMG" 2>/dev/null \
       | grep -vE '^[0-9]+:[[:space:]]*(//|/?\*)' \
       | grep -vE '^[0-9]+:#define KIMG_(MIN|MAX)_BYTES ' \
       | grep -vF 'if (v < KIMG_MIN_BYTES || v > KIMG_MAX_BYTES)')

if [ -n "$band" ]; then
  printf '%scheck-image-size: FAIL%s — a size reader bands its own return\n' \
    "$RED" "$RESET" >&2
  echo "value. Return through kasld_image_size_plausible() so the plausible" >&2
  echo "footprint band is stated once and holds for every source:" >&2
  printf '%s\n' "$band" | sed 's/^/  /' >&2
  exit 1
fi

printf '%scheck-image-size: OK%s (size read only via the evidence accessors; ' \
  "$GREEN" "$RESET"
printf 'banded in one place)\n'
