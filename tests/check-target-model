#!/bin/sh
# This file is part of KASLD - https://github.com/bcoles/kasld
#
# check-target-model — the analysis is declined when this build does not model
# the captured kernel, and is NOT declined when it does.
#
# Every other fixture harness pairs a capture with its matching binary:
# tests/replay and extra/validate-bundle both read the arch out of the capture
# and run the build for it, so between them they prove a great deal about
# correct pairings and nothing at all about wrong ones. The wrong pairing is the
# one that produces a guaranteed window which cannot contain the base — the
# model comes from the analysing binary's own architecture — so it needs a
# harness that deliberately constructs it.
#
# Every committed fixture is prepared the way an operator prepares one -- through
# extra/prepare-bundle, which is what carries the bundle's provenance record into
# the tree -- and the host's native binary is then pointed at it. Fixtures for the
# host's own architecture must run; the rest must be refused with exit 3, but
# only where the prepared tree carries something that PROVES the mismatch. That
# expectation is computed per fixture rather than assumed, so "cannot tell" is a
# documented outcome and not a silent pass:
#
#   a kallsyms address column of a different width, or
#   a capture record naming a different architecture.
#
# A tree carrying neither is counted and reported. That count is the guard's real
# coverage, and printing it is the point: it moves with the corpus.
#
# Usage: tests/check-target-model   (also run by `make test`)
# ---
# <bcoles@gmail.com>

set -u
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
# shellcheck source=tests/lib/host-build.sh
. "$ROOT/tests/lib/host-build.sh"

if [ -t 1 ] || [ -n "${KASLD_COLOR:-}" ]; then
  RED=$(printf '\033[31m')
  GREEN=$(printf '\033[32m')
  RESET=$(printf '\033[0m')
else
  RED=
  GREEN=
  RESET=
fi

BIN=$(host_kasld)
if [ -z "$BIN" ] || [ ! -x "$BIN" ]; then
  printf '%scheck-target-model: SKIP%s (no native kasld under build/; run make first)\n' \
    "$GREEN" "$RESET"
  exit 0
fi

# The architecture the native binary models, asked of the binary rather than
# assembled from the host triple: it is the build's own answer that decides
# every verdict below.
HOST_FIXTURE_ARCH=$(basename "$(dirname "$BIN")")
HOST_FIXTURE_ARCH=${HOST_FIXTURE_ARCH%%-*}
case "$HOST_FIXTURE_ARCH" in
x86_64) HOST_FIXTURE_ARCH=x86_64 ;;
i686 | i586) HOST_FIXTURE_ARCH=x86_32 ;;
aarch64) HOST_FIXTURE_ARCH=arm64 ;;
arm | armv7 | armeb) HOST_FIXTURE_ARCH=arm32 ;;
riscv64) HOST_FIXTURE_ARCH=riscv64 ;;
riscv32) HOST_FIXTURE_ARCH=riscv32 ;;
s390x) HOST_FIXTURE_ARCH=s390 ;;
loongarch64) HOST_FIXTURE_ARCH=loongarch64 ;;
powerpc64 | powerpc64le) HOST_FIXTURE_ARCH=ppc64 ;;
powerpc | powerpcle) HOST_FIXTURE_ARCH=ppc32 ;;
mips64 | mips64el) HOST_FIXTURE_ARCH=mips64 ;;
mips | mipsel) HOST_FIXTURE_ARCH=mips32 ;;
*)
  printf '%scheck-target-model: SKIP%s (no fixture arch for build dir %s)\n' \
    "$GREEN" "$RESET" "$(basename "$(dirname "$BIN")")"
  exit 0
  ;;
esac

# The width this build models, in kallsyms hex-column digits.
case "$HOST_FIXTURE_ARCH" in
x86_32 | arm32 | mips32 | ppc32 | riscv32) HOST_DIGITS=8 ;;
*) HOST_DIGITS=16 ;;
esac

fails=0
matched=0
refused=0
undetectable=0

TMP=$(mktemp -d) || exit 1
trap 'rm -rf "$TMP"' EXIT

for bundle in "$ROOT"/tests/fixtures/*/*; do
  [ -d "$bundle/sysroot" ] || continue
  arch=$(basename "$(dirname "$bundle")")
  name=$arch/$(basename "$bundle")

  sysroot=$TMP/r
  rm -rf "$sysroot"
  "$ROOT/extra/prepare-bundle" "$bundle" "$sysroot" >/dev/null 2>&1 || {
    printf '%scheck-target-model: FAIL%s — %s: prepare-bundle failed\n' \
      "$RED" "$RESET" "$name" >&2
    fails=$((fails + 1))
    continue
  }

  rc=0
  KASLD_SYSROOT=$sysroot "$BIN" -j >/dev/null 2>&1 || rc=$?

  if [ "$arch" = "$HOST_FIXTURE_ARCH" ]; then
    # The capture this build does model: whatever else happens, it is analysed.
    matched=$((matched + 1))
    if [ "$rc" -eq 3 ]; then
      printf '%scheck-target-model: FAIL%s — %s: refused a capture of its own architecture\n' \
        "$RED" "$RESET" "$name" >&2
      fails=$((fails + 1))
    fi
    continue
  fi

  # A foreign capture. Does it carry proof of that, and did the guard use it?
  provable=no
  if [ -f "$sysroot/proc/kallsyms" ]; then
    d=$(head -1 "$sysroot/proc/kallsyms" | grep -oE '^[0-9a-fA-F]+' | tr -d '\n' | wc -c)
    [ "$d" -ne 0 ] && [ "$d" -ne "$HOST_DIGITS" ] && provable=yes
  fi
  if [ "$provable" = no ] && [ -f "$sysroot/.kasld-capture" ]; then
    rec=$(awk -F: '/^arch_canonical:/ { gsub(/[ \t]/, "", $2); print $2 }' \
      "$sysroot/.kasld-capture" | head -1)
    # Read exactly as the guard reads it, or the expectation computed here and
    # the verdict under test are answering two different questions: the earliest
    # bundle layout carried byte order in this field, and "unknown" is the
    # answer for a machine collect did not recognise, not the name of one.
    case "$rec" in *el | *eb) rec=${rec%??} ;; esac
    [ "$rec" = unknown ] && rec=
    [ -n "$rec" ] && [ "$rec" != "$HOST_FIXTURE_ARCH" ] && provable=yes
  fi

  if [ "$provable" = yes ]; then
    refused=$((refused + 1))
    if [ "$rc" -ne 3 ]; then
      printf '%scheck-target-model: FAIL%s — %s: exit %s, want 3 (the prepared tree proves the mismatch)\n' \
        "$RED" "$RESET" "$name" "$rc" >&2
      fails=$((fails + 1))
    fi
  else
    # Neither signal is present. Declining here would mean declining on
    # absence, which would refuse captures that were never wrong.
    undetectable=$((undetectable + 1))
    if [ "$rc" -eq 3 ]; then
      printf '%scheck-target-model: FAIL%s — %s: refused on a tree that proves nothing\n' \
        "$RED" "$RESET" "$name" >&2
      fails=$((fails + 1))
    fi
  fi
done

# An inert guard passes every assertion above. One real refusal is the floor.
if [ "$refused" -eq 0 ]; then
  printf '%scheck-target-model: FAIL%s (no foreign capture was refused — the guard is inert)\n' \
    "$RED" "$RESET" >&2
  fails=$((fails + 1))
fi

if [ "$fails" -ne 0 ]; then
  printf '%scheck-target-model: FAIL%s (%d case(s))\n' "$RED" "$RESET" "$fails" >&2
  exit 1
fi

printf '%scheck-target-model: OK%s (%s build: %d own-arch analysed, %d foreign refused, %d state nothing)\n' \
  "$GREEN" "$RESET" "$HOST_FIXTURE_ARCH" "$matched" "$refused" "$undetectable"
