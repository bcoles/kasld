#!/bin/sh
# This file is part of KASLD - https://github.com/bcoles/kasld
#
# check-guard-docs — keep the documented guard list in step with the guards that
# actually run.
#
# docs/testing.md carries a table of the static guards `make lint` runs. Nothing
# tied the two together, and the table silently fell ten guards behind before
# anyone noticed. This is the same parity check check-manpages applies to flags,
# applied to the guard list: the set of `check-*` scripts the Makefile invokes
# must equal the set the table documents.
#
# Pure text, so it needs no build.
# ---
# <bcoles@gmail.com>

set -u
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
DOC=$ROOT/docs/testing.md
MK=$ROOT/Makefile
# shellcheck source=tests/lib/md-table.sh
. "$ROOT/tests/lib/md-table.sh"

if [ -t 1 ] || [ -n "${KASLD_COLOR:-}" ]; then
  RED=$(printf '\033[31m')
  GREEN=$(printf '\033[32m')
  RESET=$(printf '\033[0m')
else
  RED=
  GREEN=
  RESET=
fi

# Guards the `lint` target actually invokes. Matching on the $(TEST_DIR)/ prefix
# deliberately excludes Makefile targets that merely share the check- prefix
# (check-headers is a build prerequisite, not a lint guard), and the recipe is
# read from the lint block alone: a check invoked by another target is not a
# static guard and does not belong in the static-guard table, so scanning the
# whole file would demand a row for something that table does not describe.
run_f=$(mktemp)
doc_f=$(mktemp)
awk '/^lint[[:space:]]*:/ { inblock = 1; next }
     inblock && /^\t/    { print; next }
     inblock             { exit }' "$MK" |
  grep -oE '\$\(TEST_DIR\)/[a-z0-9-]+' | sed 's|.*/||' | sort -u >"$run_f"
# The documented set, read from the guard table itself rather than by asking
# which of the run guards appear in it. Deriving it from the run list made the
# two sets equal by construction: `doc_f` was a subset of `run_f`, so the
# "documented but not run" comparison below could never find anything, and a row
# for a guard `lint` had stopped invoking sat in the table indefinitely. Half a
# parity check reads exactly like a whole one from its output.
#
# md_table_select finds the table by the names in its header and returns 3 when
# no table matches, so renaming a column fails here rather than silently
# reporting an empty documented set.
md_table_select "$DOC" 'Guard,Asserts' 'Guard' | sort -u >"$doc_f" || :
if [ ! -s "$doc_f" ]; then
  printf '%scheck-guard-docs: FAIL%s (no guard table found in %s — has its header changed?)\n' \
    "$RED" "$RESET" "$DOC" >&2
  exit 1
fi

nrun=$(grep -c . "$run_f")
missing=$(comm -13 "$doc_f" "$run_f")
extra=$(comm -23 "$doc_f" "$run_f")
fail=0
# A guard must also ANNOUNCE itself by the name the table and the lint list use.
# Seventeen of them did not: the table documented check-self-edges while the run
# printed "self-edge guard", so a reader who had one name could not find the
# other, and neither comparison above could notice — both read the filename.
# Guards that take their line from tests/lib/guard-output.sh cannot drift, since
# it takes the name from $0; this catches one that prints its own.
while read -r g; do
  [ -f "$ROOT/tests/$g" ] || continue
  lbl=$(grep -ohE '%s[a-z0-9 -]+: (OK|FAIL|SKIP)' "$ROOT/tests/$g" 2>/dev/null |
        head -1 | sed 's/%s//; s/: \(OK\|FAIL\|SKIP\)//')
  [ -n "$lbl" ] || continue
  [ "$lbl" = "$g" ] && continue
  if [ "$fail" -eq 0 ]; then
    printf '%scheck-guard-docs: FAIL%s (a guard announces a name the docs do not use)\n' \
      "$RED" "$RESET" >&2
  fi
  printf '  %s prints "%s" — say %s, or take the line from guard-output.sh\n' \
    "$g" "$lbl" "$g" >&2
  fail=1
done <"$run_f"

# And it must SAY it in green. Three guards printed a plain OK on a terminal
# while every other one coloured: two defined no GREEN at all despite reading
# KASLD_COLOR, and one still used the bare `[ -t 1 ]` that predates it. Nothing
# noticed, because a guard's own output is the one thing the guard set does not
# check. The colour is carried either by guard_ok or by a GREEN the printf
# emitting the OK line refers to; the two-line window is because that printf
# usually wraps its arguments onto the next line.
while read -r g; do
  f=$ROOT/tests/$g
  [ -f "$f" ] || continue
  grep -q 'guard_ok' "$f" && continue
  grep -q ': OK' "$f" || continue
  grep -A1 ': OK' "$f" | grep -q 'GREEN' && continue
  if [ "$fail" -eq 0 ]; then
    printf '%scheck-guard-docs: FAIL%s (a guard reports success without colour)\n' \
      "$RED" "$RESET" >&2
  fi
  printf '  %s prints OK with no GREEN — use guard_ok from guard-output.sh\n' \
    "$g" >&2
  fail=1
done <"$run_f"

rm -f "$run_f" "$doc_f"

if [ -n "$missing" ]; then
  printf '%scheck-guard-docs: FAIL%s (run by lint, absent from docs/testing.md)\n' \
    "$RED" "$RESET"
  printf '%s\n' "$missing" | sed 's/^/  /'
  fail=1
fi
if [ -n "$extra" ]; then
  printf '%scheck-guard-docs: FAIL%s (in docs/testing.md, not run by lint)\n' \
    "$RED" "$RESET"
  printf '%s\n' "$extra" | sed 's/^/  /'
  fail=1
fi

if [ "$fail" -eq 0 ]; then
  # Count what was VERIFIED — every entry lint invokes — not just the rows that
  # happen to be named check-*. Two of them (hardening-fixtures, cli-flags) are
  # not, and counting by name reported 29 while checking 31.
  n=$nrun
  printf '%scheck-guard-docs: OK%s (%s guards, docs match lint)\n' \
    "$GREEN" "$RESET" "$n"
fi
exit "$fail"
