#!/bin/sh
# This file is part of KASLD - https://github.com/bcoles/kasld
#
# check-component-meta — every component must declare KASLD_META.
#
# KASLD_META(...) emits the .kasld_meta ELF section the orchestrator reads in
# classify_components(): the method/phase keys classify the component, discloses:
# names what the technique leaks, and
# the sysctl/config/bypass/cve/... keys drive the -H hardening assessment. A
# component without it still runs, but is invisible to classification and the
# hardening report — so the metadata block is mandatory.
#
# This check FAILS if any src/components/*.c lacks a KASLD_META(...) declaration,
# or carries one with no method: key (the field that classifies the component),
# no discloses: key naming what it leaks, or no source: key naming where its
# inputs come from.
#
# source: is mandatory for a reason the other two are not: the orchestrator
# schedules on it. An absent value reads as "live" and the component is kept away
# from a captured tree -- safe, but a component that meant "files" and forgot to
# say so silently stops running offline, and one that IS live and forgot to say
# so would have run there had the default gone the other way. Neither is a state
# worth having, and requiring the key removes both.
#
# It also holds the method:/discloses:/source: VOCABULARY together. Each list is
# written in three places -- the allowed sets below, the KASLD_META key reference
# in src/include/kasld/api.h, and the metadata table in CONTRIBUTING.md -- and it
# discriminates only while all three agree. Both failure directions have been
# seen: a value carried by shipped components that neither document named, and a
# name borrowed from the confidence ladder documented as a method, where it means
# nothing (the ladder grades a RECORD's trust, this names a TECHNIQUE, and the one
# component emitting CONF_DERIVED records parses a file). Neither is visible at
# runtime, because only "detection" is ever branched on and every other value is
# printed verbatim.
#
# So the sets below are the source of truth, and three things are asserted about
# each: every component carries a value from it, both documents name exactly it,
# and every value in it is carried by at least one component.
#
# That last one is what catches a name imported from a neighbouring vocabulary:
# such a value has no component to point at, so it cannot be added to the list and
# then documented. The cost is that retiring the last component of a category
# means dropping the value in the same change, which is the correct prompt.
#
# The documents are read as text, so their present shape is load-bearing: the
# api.h method entry lists its values after "Values:" and closes the sentence with
# a period, its discloses and source entries quote each value, and
# CONTRIBUTING.md carries one table row per key with the values in the last
# column. Rewriting either away from that shape fails this check rather than
# passing silently.
#
# A quoted-values entry is read from its own lines only: the range runs to the
# NEXT key and that delimiter line is dropped, so a value quoted in the
# neighbouring entry cannot be counted as this one's.
# ---
# <bcoles@gmail.com>

set -u
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
COMP="$ROOT/src/components"
# shellcheck source=tests/lib/guard-scope.sh
. "$ROOT/tests/lib/guard-scope.sh"

if [ -t 2 ] || [ -n "${KASLD_COLOR:-}" ]; then
  RED=$(printf '\033[31m'); GREEN=$(printf '\033[32m'); RESET=$(printf '\033[0m')
else
  RED=; GREEN=; RESET=
fi

# The two closed vocabularies. Source of truth for the documents and for the
# per-component checks alike; see the note above before adding a value.
METHOD_VALUES='parsed heuristic inferred timing brute detection'
DISCLOSES_VALUES='virtual physical both facts'
SOURCE_VALUES='files live hybrid'

meth_alt=$(printf '%s' "$METHOD_VALUES" | tr ' ' '|')
disc_alt=$(printf '%s' "$DISCLOSES_VALUES" | tr ' ' '|')
src_alt=$(printf '%s' "$SOURCE_VALUES" | tr ' ' '|')

# Space- or comma-separated words -> sorted and space-separated, so two
# vocabularies can be compared as sets regardless of how either was written.
norm() {
  printf '%s' "$1" | tr ',' ' ' | tr -s ' ' '\n' | grep -v '^$' | sort -u |
    tr '\n' ' '
}

rc=0
missing=""
badmethod=""
nomethod=""
badhw=""
nodisc=""
baddisc=""
nosrc=""
badsrc=""
n=0
for f in "$COMP"/*.c; do
  n=$((n + 1))
  base=$(basename "$f")
  if ! grep -qE 'KASLD_META[[:space:]]*\(' "$f"; then
    missing="$missing $base"
    rc=1
  elif ! grep -qE 'method:' "$f"; then
    nomethod="$nomethod $base"
    rc=1
  elif ! grep -qE '"method:('"$meth_alt"')\\n"' "$f"; then
    badmethod="$badmethod $base"
    rc=1
  fi

  # discloses: names what the TECHNIQUE discloses -- a static property, distinct
  # from what a given run observed. Required of every component, for two
  # readers:
  #
  #   the JSON publishes each component's whole KASLD_META block, so this is a
  #   documented per-component field an external consumer reads; present on
  #   some components and absent on others, its absence would encode nothing
  #   but which sections of the hardening renderer happen to consult it.
  #
  #   the hardening report falls back to it in the compile-time surface and
  #   hardware side-channel sections, which list a component whether or not it
  #   produced anything -- there being nothing to observe in that case.
  #
  # Mandatory rather than optional because an absent value is indistinguishable
  # from an unconsidered omission, and the optional version had drifted: several
  # components named a kind they do not emit.
  if ! grep -qE '"discloses:' "$f"; then
    nodisc="$nodisc $base"
    rc=1
  elif ! grep -qE '"discloses:('"$disc_alt"')\\n"' "$f"; then
    baddisc="$baddisc $base"
    rc=1
  fi
  # source: names where the technique's own inputs come from -- fact files, live
  # runtime state, or both -- and is what the orchestrator schedules on against a
  # captured tree. Required of every component because the alternative to a
  # declaration is a default, and either default is wrong for half the tree: a
  # live probe silently reporting the analysing host, or a file parser silently
  # dropped from every replay.
  if ! grep -qE '"source:' "$f"; then
    nosrc="$nosrc $base"
    rc=1
  elif ! grep -qE '"source:('"$src_alt"')\\n"' "$f"; then
    badsrc="$badsrc $base"
    rc=1
  fi

  # The hardware: field names the requirement; a feature that DISABLES the leak
  # belongs in a trailing "(mitigated by X)", never as the bare value. The flagged
  # tokens name mitigations, not requirements: KPTI is a kernel config, not
  # hardware (a KPTI dependency belongs in config:); UMIP is a CPU feature but one
  # that blocks user-mode instructions. A bare KPTI/UMIP where the requirement
  # goes is the inverted meaning this catches.
  hw=$(grep -E '"hardware:' "$f" | head -1 | sed -E 's/.*"hardware:([^"]*)".*/\1/')
  req=$(printf '%s' "${hw%\\n}" | sed -E 's/\(mitigated by [^)]*\)//g')
  if printf '%s' "$req" | grep -qwE 'KPTI|UMIP'; then
    badhw="$badhw $base"
    rc=1
  fi
done

# ---- Vocabulary parity: the sets above against the tree and the documents ---
API="$ROOT/src/include/kasld/api.h"
MD="$ROOT/CONTRIBUTING.md"

used_method=$(grep -ho '"method:[a-z]*' "$COMP"/*.c | sed 's/"method://')
used_disc=$(grep -ho '"discloses:[a-z]*' "$COMP"/*.c | sed 's/"discloses://')
used_src=$(grep -ho '"source:[a-z]*' "$COMP"/*.c | sed 's/"source://')

want_method=$(norm "$METHOD_VALUES")
want_disc=$(norm "$DISCLOSES_VALUES")
want_src=$(norm "$SOURCE_VALUES")

# The quoted values of one api.h key entry: from its own line to the line
# starting the NEXT key, with that delimiter dropped so a neighbour's values
# cannot leak in. $1 = key, $2 = the key that follows it.
api_quoted() {
  sed -n "/^ \\*   $1:/,/^ \\*   $2:/p" "$API" | sed '$d' |
    grep -o '"[a-z]*"' | tr -d '"' | tr '\n' ' '
}

api_method=$(norm "$(sed -n '/^ \*   method:/,/^ \*   phase:/p' "$API" |
                     tr '\n' ' ' | sed -E 's/.*Values:([^.]*)\..*/\1/' | tr -d '*')")
api_disc=$(norm "$(api_quoted discloses source)")
api_src=$(norm "$(api_quoted source status)")
# The backticks are literal table markup, not command substitution, so both
# patterns must stay single-quoted.
# shellcheck disable=SC2016
md_method=$(norm "$(grep -E '^\| `method` \|' "$MD" |
                    awk -F'|' '{ print $(NF - 1) }' | tr -d '` ')")
# shellcheck disable=SC2016
md_disc=$(norm "$(grep -E '^\| `discloses` \|' "$MD" |
                  awk -F'|' '{ print $(NF - 1) }' | tr -d '` ')")
# shellcheck disable=SC2016
md_src=$(norm "$(grep -E '^\| `source` \|' "$MD" |
                 awk -F'|' '{ print $(NF - 1) }' | tr -d '` ')")

# <key> <document> <documented set> <expected set>
vocab_cmp() {
  [ "$3" = "$4" ] && return 0
  printf '%scheck-component-meta: FAIL%s — %s: vocabulary in %s is not the one this check allows:\n' \
    "$RED" "$RESET" "$1" "$2"
  printf '  documented: %s\n' "$3"
  printf '  allowed:    %s\n' "$4"
  return 1
}

vocab_cmp method    "src/include/kasld/api.h" "$api_method" "$want_method" || rc=1
vocab_cmp discloses "src/include/kasld/api.h" "$api_disc" "$want_disc" || rc=1
vocab_cmp source    "src/include/kasld/api.h" "$api_src" "$want_src" || rc=1
vocab_cmp method    "CONTRIBUTING.md" "$md_method" "$want_method" || rc=1
vocab_cmp discloses "CONTRIBUTING.md" "$md_disc" "$want_disc" || rc=1
vocab_cmp source    "CONTRIBUTING.md" "$md_src" "$want_src" || rc=1

# A value no component carries names a category the tree does not have.
unused=""
for v in $METHOD_VALUES; do
  printf '%s\n' "$used_method" | grep -qx "$v" || unused="$unused method:$v"
done
for v in $DISCLOSES_VALUES; do
  printf '%s\n' "$used_disc" | grep -qx "$v" || unused="$unused discloses:$v"
done
for v in $SOURCE_VALUES; do
  printf '%s\n' "$used_src" | grep -qx "$v" || unused="$unused source:$v"
done
if [ -n "$unused" ]; then
  printf '%scheck-component-meta: FAIL%s — allowed value no component carries:\n' "$RED" "$RESET"
  for c in $unused; do printf '  %s\n' "$c"; done
  printf '  either a component should declare it, or drop it here and from both\n'
  printf '  api.h and CONTRIBUTING.md\n'
  rc=1
fi

if [ -n "$missing" ]; then
  printf '%scheck-component-meta: FAIL%s — missing KASLD_META:\n' "$RED" "$RESET"
  for c in $missing; do printf '  %s\n' "$c"; done
fi
if [ -n "$nomethod" ]; then
  printf '%scheck-component-meta: FAIL%s — KASLD_META without a method: key:\n' "$RED" "$RESET"
  for c in $nomethod; do printf '  %s\n' "$c"; done
fi
if [ -n "$badmethod" ]; then
  printf '%scheck-component-meta: FAIL%s — method: must be one of %s:\n' "$RED" "$RESET" "$METHOD_VALUES"
  for c in $badmethod; do printf '  %s\n' "$c"; done
fi
if [ -n "$nodisc" ]; then
  printf '%scheck-component-meta: FAIL%s — KASLD_META without a discloses: key:\n' "$RED" "$RESET"
  for c in $nodisc; do printf '  %s\n' "$c"; done
fi
if [ -n "$baddisc" ]; then
  printf '%scheck-component-meta: FAIL%s — discloses: must be virtual/physical/both/facts:\n' "$RED" "$RESET"
  for c in $baddisc; do printf '  %s\n' "$c"; done
fi
if [ -n "$nosrc" ]; then
  printf '%scheck-component-meta: FAIL%s — KASLD_META without a source: key:\n' "$RED" "$RESET"
  for c in $nosrc; do printf '  %s\n' "$c"; done
  printf '  name where the inputs come from: files (fact files only), live\n'
  printf '  (live runtime state of the executing kernel/CPU) or hybrid (both)\n'
fi
if [ -n "$badsrc" ]; then
  printf '%scheck-component-meta: FAIL%s — source: must be one of %s:\n' "$RED" "$RESET" "$SOURCE_VALUES"
  for c in $badsrc; do printf '  %s\n' "$c"; done
fi
if [ -n "$badhw" ]; then
  printf '%scheck-component-meta: FAIL%s — hardware: names a mitigation as the requirement (move it into "(mitigated by X)"):\n' "$RED" "$RESET"
  for c in $badhw; do printf '  %s\n' "$c"; done
fi
if [ "$rc" -eq 0 ]; then
guard_scope "check-component-meta" "$n" 80

  printf '%scheck-component-meta: OK%s (%d components, all declare KASLD_META with method:, discloses: and source:; vocabulary matches api.h and CONTRIBUTING.md)\n' "$GREEN" "$RESET" "$n"
fi
exit $rc
