#!/bin/sh
# This file is part of KASLD - https://github.com/bcoles/kasld
#
# test-cross — run the engine per-rule + integration tests under qemu-user for
# each cross target, so ARCH-GATED rules actually execute their active path.
#
# `make test` runs the suite on the host (x86_64) only, where every
# `#if defined(__aarch64__)` / riscv64 / s390 / mips / ppc rule body compiles to
# a no-op — so those rules' real logic is never exercised. The engine tests are
# pure, syscall-free C over synthetic in-memory evidence (addresses anchored to
# the arch's quantity tops / PHYS_OFFSET, so portable across 64-bit arches), so
# cross-compiling and running under qemu-user is sound and turns each arch-gated
# assertion into genuine coverage on its own architecture.
#
# Self-contained: compiles directly with the cross toolchain (engine core +
# rules/*.c wildcard, matching the Makefile) — no sysroot/fixtures needed.
# Skips any target whose toolchain or qemu binary is absent. Like tests/replay,
# this is a local/CI-with-qemu aid, not part of the host `make test`.
# Exit status is non-zero if any present target fails (CI-friendly).
#
# Compilation, not the qemu runs, dominates the cost: the eight binaries per
# target come to ~105 translation units against a couple of seconds of emulated
# execution. Two properties hold that down. The engine core and rule objects are
# built once per target and linked into both engine binaries, so the rule set
# costs one compile rather than one per binary. And every compile is a
# single-source `-c`, the only form ccache can serve; handed several sources at
# once it declines and forwards to the compiler, caching nothing.
#
# Usage:  tests/test-cross [triple...]   (default: the local cross set; CI passes
#         one triple per matrix job)
# Env:    QEMU_DIR (default: resolve qemu-<arch> from PATH), CFLAGS, KEEP=1,
#         JOBS (default: one per core), USE_CCACHE=0 to compile without ccache
# ---
# <bcoles@gmail.com>

set -u
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
QEMU_DIR=${QEMU_DIR:-}   # empty: resolve qemu-<arch> from PATH
TESTS_BASE=$ROOT/build/tests

# qemu-user binary for $1: from QEMU_DIR if set, else PATH. Empty if not found.
resolve_qemu() {
  if [ -n "$QEMU_DIR" ]; then
    [ -x "$QEMU_DIR/$1" ] && echo "$QEMU_DIR/$1"
  else
    command -v "$1" 2>/dev/null
  fi
}
# -Werror on the overflow/shift classes: these only manifest on a given word
# size, so the cross (esp. 32-bit) compile is where a `1ul << 40` shift or a
# constant overflow gets caught. Kept targeted (not full -Werror) so the test
# TUs' pre-existing unused-static warnings don't turn fatal. Both are front-end
# diagnostics and fire at any optimisation level.
# The same warning set the native build carries, so a diagnostic is not a
# function of which build happened to compile the file. This is the only build
# that compiles a test's arch-gated bodies on their own arch, so a warning
# reachable nowhere else is reachable here.
#
# Three exclusions, each because the diagnostic describes this harness rather
# than the code. -Wno-type-limits: the property generators clamp against per-arch
# bounds, and a bound that is 0 on one arch makes its comparison tautological
# there while remaining load-bearing on the other sixteen. -Wno-unused-function
# and -Wno-unused-variable: a test binary links whole shipped translation units
# and calls part of each, so most of what it pulls in is legitimately unreached
# -- silencing that in the source would mean annotating shipped code to suit a
# test link. -Wredundant-decls is left out for the same reason.
KASLD_TEST_WARN="-Wall -Wextra -Wno-type-limits -Wno-unused-function\
 -Wno-unused-variable -Wshadow -Wcast-align -Wcast-qual -Wpointer-arith -Wundef\
 -Wvla -Wnull-dereference -Wlogical-op -Wduplicated-cond -Wduplicated-branches\
 -Wwrite-strings -Wbad-function-cast"
CFLAGS=${CFLAGS:--std=c99 -O2 -static -I$ROOT/src -Werror=shift-count-overflow -Werror=overflow $KASLD_TEST_WARN}
# Every binary this script builds is a test, so the hermeticity probe applies to
# all of them: a test that reads a kernel fact from the machine running it is
# asserting against that machine, on any architecture. Appended rather than put
# in the default, so overriding CFLAGS cannot drop it.
CFLAGS="$CFLAGS -DKASLD_HERMETIC_PROBE"
# Targets are independent (separate build dir + binaries each), so build/run
# them JOBS at a time. Default to one per core; JOBS=1 restores serial order.
JOBS=${JOBS:-$(nproc 2>/dev/null || echo 1)}

# ccache when it is installed, nothing when it is not — a compiler cache is an
# optimisation, never a requirement, and a host without one must still run the
# suite. USE_CCACHE=0 forces the direct compiler. The cache lives wherever
# ccache itself is configured to put it, so its size limit and eviction stay
# under the operator's control rather than this script's.
CCPREFIX=""
if [ "${USE_CCACHE:-1}" != 0 ]; then
  CCPREFIX=$(command -v ccache 2>/dev/null) || CCPREFIX=""
fi

# A UNIQUE build dir per invocation. Two overlapping runs -- or an orphaned
# run_target subshell whose parent `make` was killed but which lives on and
# still runs its `rm -rf "$d"` cleanup -- must not share `build/tests/<triple>`,
# or one deletes the other's tree mid-compile. That surfaces as a fabricated
# compile failure whose cc.log the cleanup has already removed (see
# show_cc_log). mktemp keeps each run's path distinct; the trap removes it on
# exit unless KEEP=1.
mkdir -p "$TESTS_BASE"
OUT=$(mktemp -d "$TESTS_BASE/run.XXXXXX") || { echo "test-cross: mktemp failed" >&2; exit 1; }
trap '[ "${KEEP:-0}" = 1 ] || rm -rf "$OUT"' EXIT

# The compile log, or an honest note when it is absent. A missing log means the
# build dir vanished mid-compile, NOT that the compiler printed nothing -- the
# old code sed'd a removed file and reported an empty failure, inviting a hunt
# for a source bug that is not there.
show_cc_log() {
  if [ -s "$1" ]; then
    sed 's/^/      /' "$1" | head -5
  else
    printf '      (no compile log at %s -- build dir vanished mid-compile)\n' "$1"
  fi
}

# A compile that SUCCEEDS still has something to say. The log was written either
# way and read only on failure, so a warning on a passing build was captured to a
# file and dropped -- including one from the -Werror= classes above, which are
# fatal only when they fire as errors. A cross build is where a word-size
# diagnostic appears at all, so silence there is the one place it costs most.
#
# Reported without failing the target: the exit status is the compiler's verdict
# and is not overridden here. run_target's output is collected per target and
# printed whole, so one header carries the attribution and the diagnostic keeps
# the compiler's own layout -- the caret lines are the useful half.
show_cc_diagnostics() {
  [ -s "$1" ] || return 0
  printf 'WARN  %-30s (%s)\n' "$triple" "$2"
  sed 's/^/      /' "$1"
}

CORE="$ROOT/src/estimate.c $ROOT/src/quantities.c $ROOT/src/evidence.c $ROOT/src/engine.c"
RULES=$(echo "$ROOT"/src/rules/*.c)

pass=0; fail=0; skip=0

# compile_obj <src> <out.o> [extra cflags...] — one source, one object, so the
# result is cacheable. Reads $cc / $triple / $d from the calling run_target.
compile_obj() {
  co_src=$1; co_out=$2; shift 2
  # shellcheck disable=SC2086  # $CCPREFIX/$cc/$CFLAGS are command + flag lists, split intentionally
  if ! $CCPREFIX $cc $CFLAGS "$@" -c "$co_src" -o "$co_out" 2>"$d/cc.log"; then
    printf 'FAIL  %-30s (compile %s)\n' "$triple" "${co_src##*/}"
    show_cc_log "$d/cc.log"
    return 1
  fi
  show_cc_diagnostics "$d/cc.log" "compile ${co_src##*/}"
}

# link_bin <out> <object...> [-l...] — link step; libraries follow the objects.
link_bin() {
  lb_out=$1; shift
  # shellcheck disable=SC2086  # $cc/$CFLAGS are command + flag list, split intentionally
  if ! $cc $CFLAGS "$@" -o "$lb_out" 2>"$d/cc.log"; then
    printf 'FAIL  %-30s (link %s)\n' "$triple" "${lb_out##*/}"
    show_cc_log "$d/cc.log"
    return 1
  fi
  show_cc_diagnostics "$d/cc.log" "link ${lb_out##*/}"
}

# run_target writes its human-readable line(s) to stdout (the caller redirects
# this to a per-target .res file) and a single pass/fail/skip token to its .st
# file, so invocations can run concurrently without sharing shell state.
run_target() {
  triple=$1 qbin=$2
  cc="${triple}-gcc"; qemu=$(resolve_qemu "$qbin")
  st="$OUT/$triple.st"
  if ! command -v "$cc" >/dev/null 2>&1; then
    printf 'SKIP  %-30s (no toolchain: %s)\n' "$triple" "$cc"; echo skip >"$st"; return
  fi
  if [ -z "$qemu" ]; then
    printf 'SKIP  %-30s (no qemu: %s)\n' "$triple" "$qbin"; echo skip >"$st"; return
  fi
  d="$OUT/$triple"; obj="$d/obj"; sh_obj="$obj/shared"; mkdir -p "$sh_obj"
  # The engine core and every rule, one object each, shared by the two engine
  # binaries below so the rule set is built once per target. engine_rules.c is
  # the registry and belongs only to the integration binary, so it stays out of
  # the shared set.
  for src in $CORE $RULES; do
    compile_obj "$src" "$sh_obj/$(basename "$src" .c).o" || { echo fail >"$st"; return; }
  done
  compile_obj "$ROOT/src/engine_rules.c" "$obj/engine_rules.o" || { echo fail >"$st"; return; }
  # Per-rule engine test (every rule via the wildcard) AND the full-registry
  # integration test, both under qemu so each arch-gated rule body executes its
  # active path on its own arch. The tests anchor addresses to the arch's
  # quantity tops / PHYS_OFFSET, so they are portable across 64-bit arches.
  # (This harness has caught real arch bugs this way: a 64-bit shift overflow
  # and PHYS_OFFSET-relative assertion errors.)
  # The two engine TUs carry only test code, so the unused-* checks mean here
  # what they mean natively: a test body no arch reaches. Everything else this
  # script builds links whole shipped translation units and uses part of each,
  # where the same check would only describe the link.
  compile_obj "$ROOT/tests/test_engine.c" "$obj/test_engine.o" \
    -Wunused-function -Wunused-variable || { echo fail >"$st"; return; }
  compile_obj "$ROOT/tests/test_engine_integration.c" "$obj/test_integration.o" \
    -Wunused-function -Wunused-variable || { echo fail >"$st"; return; }
  # The parser / result-model / merge / engine-sync unit suite (its renderer
  # half is now test_render, below). It includes the orchestrator + render
  # translation units directly (hence -DKASLD_TESTING and -lpthread) and derives
  # every fixture address from the arch's own layout constants, so it runs on
  # every width and endianness.
  compile_obj "$ROOT/tests/test_kasld.c" "$obj/test_kasld.o" -DKASLD_TESTING || { echo fail >"$st"; return; }
  # The renderer unit suite (split from test_kasld); same single-TU model.
  compile_obj "$ROOT/tests/test_render.c" "$obj/test_render.o" -DKASLD_TESTING || { echo fail >"$st"; return; }
  # The estimate-algebra + honest-top soundness suite (links only estimate.c +
  # quantities.c). Its arch-gated interval_admits() asserts validate each arch's
  # honest-top floor/ceiling on its own arch — dormant on the x86_64 host, live
  # here, so a phys/virt floor that excludes a valid base fails on the arch it
  # affects.
  compile_obj "$ROOT/tests/test_estimate.c" "$obj/test_estimate.o" || { echo fail >"$st"; return; }
  # The width-sensitive suites. These are the reason the 32-bit targets matter:
  # kasld_addr_t is the build's word, so on a 64-bit host the too-wide branch of
  # kasld_addr_parse is unreachable and the refusal that the parser exists for
  # never executes. Here it does.
  for t in test_addr_parse test_target_width test_proc_kallsyms; do
    compile_obj "$ROOT/tests/$t.c" "$obj/$t.o" || { echo fail >"$st"; return; }
  done

  # shellcheck disable=SC2086  # the shared-object glob is a file list, split intentionally
  link_bin "$d/test_engine" "$obj/test_engine.o" $sh_obj/*.o || { echo fail >"$st"; return; }
  # shellcheck disable=SC2086  # the shared-object glob is a file list, split intentionally
  link_bin "$d/test_integration" "$obj/test_integration.o" "$obj/engine_rules.o" $sh_obj/*.o || { echo fail >"$st"; return; }
  link_bin "$d/test_kasld" "$obj/test_kasld.o" -lpthread || { echo fail >"$st"; return; }
  link_bin "$d/test_render" "$obj/test_render.o" -lpthread || { echo fail >"$st"; return; }
  link_bin "$d/test_estimate" "$obj/test_estimate.o" "$sh_obj/estimate.o" "$sh_obj/quantities.o" || { echo fail >"$st"; return; }
  for t in test_addr_parse test_target_width test_proc_kallsyms; do
    link_bin "$d/$t" "$obj/$t.o" || { echo fail >"$st"; return; }
  done
  ok=1
  for t in test_engine test_integration test_estimate test_kasld test_render \
           test_addr_parse test_target_width test_proc_kallsyms; do
    if ! "$qemu" "$d/$t" >/dev/null 2>"$d/$t.run"; then
      printf 'FAIL  %-30s (%s under qemu)\n' "$triple" "$t"; tail -3 "$d/$t.run" | sed 's/^/      /'; ok=0
    fi
  done
  if [ "$ok" = 1 ]; then
    printf 'PASS  %-30s engine + integration + estimate + kasld + render + addr_parse + target_width + proc_kallsyms\n' "$triple"; echo pass >"$st"
  else
    echo fail >"$st"
  fi
  [ "${KEEP:-0}" = 1 ] || rm -rf "$d"
}

# qemu-user binary for a toolchain triple, keyed on the leading arch component
# so both `make cross` names (aarch64-linux-musl) and the cross-tools/musl-cross
# CI names (aarch64-unknown-linux-musl) resolve. Empty for arches with no
# qemu-user binary (32-bit little-endian ppc, powerpcle) — those skip.
qemu_for() {
  case "${1%%-*}" in
  x86_64)      echo qemu-x86_64 ;;
  i686 | i586) echo qemu-i386 ;;
  aarch64)     echo qemu-aarch64 ;;
  arm | armv7) echo qemu-arm ;;
  armeb)       echo qemu-armeb ;;
  mips)        echo qemu-mips ;;
  mipsel)      echo qemu-mipsel ;;
  mips64)      echo qemu-mips64 ;;
  mips64el)    echo qemu-mips64el ;;
  powerpc)     echo qemu-ppc ;;
  powerpc64)   echo qemu-ppc64 ;;
  powerpc64le) echo qemu-ppc64le ;;
  riscv32)     echo qemu-riscv32 ;;
  riscv64)     echo qemu-riscv64 ;;
  s390x)       echo qemu-s390x ;;
  loongarch64) echo qemu-loongarch64 ;;
  *)           echo "" ;;
  esac
}

# Targets: toolchain triples from argv if given (CI passes one arch per matrix
# job), else the built-in local set `make cross` builds. qemu is derived per
# triple via qemu_for, so dev and CI triple spellings both work.
#
# Both 64-bit and 32-bit targets run; 64-bit-only tests (x86_64 RANDOMIZE_MEMORY
# vmalloc/vmemmap, LA57/arm64 VA-bits, TiB-scale direct maps, wide PA widths) are
# `#if __SIZEOF_LONG__ >= 8`-guarded and skip on 32-bit. This executes each
# arch-gated rule body on its own arch: i686 -> x86_32 vmsplit ceiling, armv7 ->
# arm32 highmem_32bit_bound, mips -> mips32 min_offset_from_image_size, powerpc
# -> ppc32 phys_ceiling (BE), riscv32 -> page_offset_invariant_pin +
# text_base_coupling_synth. ppc32 little-endian (powerpcle) has no 32-bit-LE
# qemu-user, so it stays live-test-only.
default_triples='aarch64-linux-musl arm-unknown-linux-musleabi
armeb-linux-musleabi armv7-unknown-linux-musleabi i686-unknown-linux-musl
mips64-unknown-linux-musl mips64el-unknown-linux-musl powerpc-linux-musl
powerpc64-unknown-linux-musl powerpc64le-unknown-linux-musl
loongarch64-unknown-linux-musl mips-unknown-linux-musl mipsel-unknown-linux-musl
riscv32-linux-musl riscv64-linux-musl s390x-ibm-linux-musl x86_64-linux-musl'

# No argv -> use the built-in set (intentional word-split into $@).
if [ "$#" -eq 0 ]; then
  # shellcheck disable=SC2086
  set -- $default_triples
fi

# Launch up to JOBS targets concurrently, each writing to its own .res/.st.
# At capacity, wait for the OLDEST target still running and launch the next as
# soon as it ends, rather than draining all JOBS of them first: one slow arch
# then delays at most the targets ahead of it in the queue, not a whole batch.
# `wait <pid>` returns however that child ended — including killed by a signal —
# so a target that dies without cleaning up after itself cannot stall the run.
# Order is recorded so the summary prints deterministically regardless of finish
# order.
order=""
running=""   # PIDs of live targets, oldest first
inflight=0

for triple in "$@"; do
  order="$order $triple"
  qbin=$(qemu_for "$triple")
  if [ -z "$qbin" ]; then
    printf 'SKIP  %-30s (no qemu-user binary for this arch)\n' "$triple" >"$OUT/$triple.res"
    echo skip >"$OUT/$triple.st"
    continue
  fi
  run_target "$triple" "$qbin" >"$OUT/$triple.res" 2>&1 &
  running="${running:+$running }$!"
  inflight=$((inflight + 1))
  if [ "$inflight" -ge "$JOBS" ]; then
    oldest=${running%% *}
    if [ "$oldest" = "$running" ]; then running=""; else running=${running#* }; fi
    wait "$oldest" 2>/dev/null
    inflight=$((inflight - 1))
  fi
done
wait

# Aggregate in launch order: print each target's captured output, tally its
# status token. A missing token (a job that died before writing) counts as a
# failure rather than vanishing.
for triple in $order; do
  [ -f "$OUT/$triple.res" ] && cat "$OUT/$triple.res"
  case $(cat "$OUT/$triple.st" 2>/dev/null) in
    pass) pass=$((pass + 1)) ;;
    skip) skip=$((skip + 1)) ;;
    *)    fail=$((fail + 1)) ;;
  esac
  rm -f "$OUT/$triple.res" "$OUT/$triple.st"
done

echo "----------------------------------------------------------------------"
printf 'test-cross: %d pass, %d fail, %d skip (JOBS=%s)\n' "$pass" "$fail" "$skip" "$JOBS"
[ "$fail" -eq 0 ]
