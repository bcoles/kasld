#!/bin/sh
# This file is part of KASLD - https://github.com/bcoles/kasld
#
# check-ksymoff — known-answer tests for extra/ksymoff.
#
# ksymoff is pure address arithmetic (KASLR-slide application and
# physical<->virtual / direct-map translation), so it is testable offline with
# fixed inputs. check-shellcheck guards its syntax; this guards its ARITHMETIC —
# the class of bug shellcheck cannot see, e.g. a signed-64 comparison that
# miscomputes kernel addresses whose top bit is set.
#
# Soft dependency: ksymoff needs bash; if bash is absent this SKIPs (exit 0).
#
# Usage: tests/check-ksymoff   (also run by `make lint` / `make test`)
# ---
# <bcoles@gmail.com>

set -u
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
KSYMOFF=$ROOT/extra/ksymoff

if [ -t 1 ] || [ -n "${KASLD_COLOR:-}" ]; then
  RED=$(printf '\033[31m'); GREEN=$(printf '\033[32m')
  YELLOW=$(printf '\033[33m'); RESET=$(printf '\033[0m')
else
  RED=; GREEN=; YELLOW=; RESET=
fi

if ! command -v bash >/dev/null 2>&1; then
  printf '%scheck-ksymoff: SKIP%s (bash not installed)\n' "$YELLOW" "$RESET"
  exit 0
fi

pass=0; fail=0
eq() {  # desc  want  got
  if [ "$2" = "$3" ]; then
    pass=$((pass + 1))
  else
    fail=$((fail + 1))
    printf '  %sFAIL%s %s\n         want: [%s]\n         got:  [%s]\n' \
      "$RED" "$RESET" "$1" "$2" "$3" >&2
  fi
}
errs() {  # desc  cmd...   (must exit non-zero and print nothing to stdout)
  desc=$1; shift
  if out=$("$@" 2>/dev/null) && [ -n "$out" ]; then
    fail=$((fail + 1))
    printf '  %sFAIL%s %s (expected error, got: [%s])\n' "$RED" "$RESET" "$desc" "$out" >&2
  else
    pass=$((pass + 1))
  fi
}
noexec() {  # desc  cmd...   (must NOT create $MARK — no arithmetic injection)
  desc=$1; shift
  rm -f "$MARK"
  "$@" >/dev/null 2>&1 || true
  if [ -f "$MARK" ]; then
    fail=$((fail + 1))
    printf '  %sFAIL%s %s (arithmetic injection EXECUTED)\n' "$RED" "$RESET" "$desc" >&2
  else
    pass=$((pass + 1))
  fi
}
ESC=$(printf '\033')
noesc() {  # desc  output   (output must contain no terminal ESC byte)
  case "$2" in
    *"$ESC"*) fail=$((fail + 1))
              printf '  %sFAIL%s %s (escape reached output)\n' "$RED" "$RESET" "$1" >&2 ;;
    *)        pass=$((pass + 1)) ;;
  esac
}

# A minimal System.map: _text plus two symbols at known offsets.
MAP=$(mktemp)  || { printf 'ksymoff guard: SKIP (mktemp failed)\n'; exit 0; }
EVIL=$(mktemp) || { printf 'ksymoff guard: SKIP (mktemp failed)\n'; exit 0; }
MARK=$(mktemp -u) || MARK="${TMPDIR:-/tmp}/ksymoff_inj_marker.$$"
trap 'rm -f "$MAP" "$EVIL" "$MARK"' EXIT
printf '%s\n' \
  'ffffffff81000000 T _text' \
  'ffffffff81276cb0 T commit_creds' \
  'ffffffff81280000 T prepare_kernel_cred' > "$MAP"

# ---- symbol modes (slide = 0x82200000 - 0x81000000 = 0x1200000) ----
eq 'forward: symbol + base'       'ffffffff82476cb0 T commit_creds' \
   "$("$KSYMOFF" -b 0xffffffff82200000 -s "$MAP" commit_creds 2>/dev/null)"
eq 'forward: stdin text= field'   'ffffffff82476cb0 T commit_creds' \
   "$(printf 'arch=x86_64 text=0xffffffff82200000 dmap=na\n' | "$KSYMOFF" -s "$MAP" commit_creds 2>/dev/null)"
eq 'slide only'                   '+0x1200000' \
   "$("$KSYMOFF" -b 0xffffffff82200000 -s "$MAP" --slide 2>/dev/null)"
eq 'inverse: symbol addr -> base' '0xffffffff82200000' \
   "$("$KSYMOFF" --from commit_creds=0xffffffff82476cb0 -s "$MAP" 2>/dev/null)"
eq 'inverse + forward chaining'   'ffffffff82480000 T prepare_kernel_cred' \
   "$("$KSYMOFF" --from commit_creds=0xffffffff82476cb0 -s "$MAP" prepare_kernel_cred 2>/dev/null)"

# ---- physical translation (page_offset_base = 0xffff9e8000000000) ----
PO=0xffff9e8000000000
VM=0xffffea0000000000
eq 'phys2virt'                    'ffff9e8034600000' \
   "$("$KSYMOFF" --page-offset "$PO" --phys2virt 0x34600000 2>/dev/null)"
eq 'virt2phys'                    '0x34600000' \
   "$("$KSYMOFF" --page-offset "$PO" --virt2phys 0xffff9e8034600000 2>/dev/null)"
eq 'virt2phys at base -> 0x0'     '0x0' \
   "$("$KSYMOFF" --page-offset "$PO" --virt2phys "$PO" 2>/dev/null)"
eq 'phys2virt: stdin dmap= field' 'ffff9e8034600000' \
   "$(printf 'arch=x86_64 text=na dmap=%s dram=na\n' "$PO" | "$KSYMOFF" --phys2virt 0x34600000 2>/dev/null)"
# struct page = vmemmap + (pfn * sizeof(struct page)); pfn = phys >> page-shift
eq 'phys2page: 4KiB / 64B'        'ffffea0000d18000' \
   "$("$KSYMOFF" --vmemmap "$VM" --phys2page 0x34600000 2>/dev/null)"
eq 'phys2page: 64KiB / 56B'       'ffffea00000b7500' \
   "$("$KSYMOFF" --vmemmap "$VM" --page-shift 16 --page-size 56 --phys2page 0x34600000 2>/dev/null)"
eq 'phys2page: stdin vmemmap='    'ffffea0000d18000' \
   "$(printf 'arch=x86_64 text=na vmemmap=%s pagesize=4096 dram=na\n' "$VM" | "$KSYMOFF" --phys2page 0x34600000 2>/dev/null)"

# ---- page2phys is the exact inverse of phys2page ----
eq 'page2phys: 4KiB / 64B'        '0x34600000' \
   "$("$KSYMOFF" --vmemmap "$VM" --page2phys 0xffffea0000d18000 2>/dev/null)"
eq 'page2phys: 64KiB / 56B'       '0x34600000' \
   "$("$KSYMOFF" --vmemmap "$VM" --page-shift 16 --struct-page-size 56 --page2phys 0xffffea00000b7500 2>/dev/null)"
eq 'page2phys: at vmemmap -> 0x0' '0x0' \
   "$("$KSYMOFF" --vmemmap "$VM" --page2phys "$VM" 2>/dev/null)"
eq 'struct-page-size == page-size' \
   "$("$KSYMOFF" --vmemmap "$VM" --page-size 56 --phys2page 0x34600000 2>/dev/null)" \
   "$("$KSYMOFF" --vmemmap "$VM" --struct-page-size 56 --phys2page 0x34600000 2>/dev/null)"

# ---- the linear-map anchor ----
# virt = (phys - phys_offset) + page_offset. The anchor is 0 only where the
# kernel maps physical 0 at the direct-map base; a board whose RAM starts at
# 0x80000000 is misplaced by 2 GiB if it is assumed anyway.
RPO=0xff60000000000000
eq 'phys2virt: anchored at 0x80000000' 'ff60000000200000' \
   "$("$KSYMOFF" --page-offset "$RPO" --phys-offset 0x80000000 --phys2virt 0x80200000 2>/dev/null)"
eq 'virt2phys: anchored round trip'    '0x80200000' \
   "$("$KSYMOFF" --page-offset "$RPO" --phys-offset 0x80000000 --virt2phys 0xff60000000200000 2>/dev/null)"
eq 'phys2page: anchor indexes vmemmap' 'ffffea0000008000' \
   "$("$KSYMOFF" --vmemmap "$VM" --phys-offset 0x80000000 --phys2page 0x80200000 2>/dev/null)"
eq 'page2phys: anchored round trip'    '0x80200000' \
   "$("$KSYMOFF" --vmemmap "$VM" --phys-offset 0x80000000 --page2phys 0xffffea0000008000 2>/dev/null)"
# An explicit zero anchor is the x86 case, and must not change any answer.
eq 'phys-offset 0 is the x86 default'  'ffff9e8034600000' \
   "$("$KSYMOFF" --page-offset "$PO" --phys-offset 0 --phys2virt 0x34600000 2>/dev/null)"
# --vmemmap-offset defaults to --phys-offset, so the two name the same anchor
# wherever the kernel uses one number (x86, arm64, an aligned riscv board).
eq 'vmemmap-offset defaults to phys-offset' \
   "$("$KSYMOFF" --vmemmap "$VM" --phys-offset 0x80000000 --phys2page 0x80200000 2>/dev/null)" \
   "$("$KSYMOFF" --vmemmap "$VM" --vmemmap-offset 0x80000000 --phys2page 0x80200000 2>/dev/null)"
# riscv rounds the array's anchor down to the section size while the linear map
# keeps the DRAM base, so a board starting at 0x80200000 indexes the array from
# 0x80000000. Stating the array's anchor separately is what gets the entry right.
eq 'vmemmap anchor distinct from linear'  'ffffea0000010000' \
   "$("$KSYMOFF" --vmemmap "$VM" --vmemmap-offset 0x80000000 --phys2page 0x80400000 2>/dev/null)"
eq 'page2phys inverts the array anchor'   '0x80400000' \
   "$("$KSYMOFF" --vmemmap "$VM" --vmemmap-offset 0x80000000 --page2phys 0xffffea0000010000 2>/dev/null)"
# A page mode is satisfied by the array's anchor alone -- it never consults the
# linear map's, so no default has to be defended for it.
eq 'vmemmap-offset alone answers on riscv' 'ffffea0000008000' \
   "$(printf 'arch=riscv64 vmemmap=%s pagesize=4096\n' "$VM" | "$KSYMOFF" --vmemmap-offset 0x80000000 --phys2page 0x80200000 2>/dev/null)"

# The page shift comes off the line's `pagesize=`, not from the machine. These
# are the four states: the line states a size, the line states none, no line at
# all, and an explicit override.
eq 'pagesize= drives the shift (64 KiB)' 'ffffea00000d1800' \
   "$(printf 'arch=aarch64 vmemmap=%s pagesize=65536 structpage=64\n' "$VM" | "$KSYMOFF" --vmemmap-offset 0 --phys2page 0x34600000 2>/dev/null)"
eq 'pagesize= drives the shift (4 KiB)'  'ffffea0000d18000' \
   "$(printf 'arch=x86_64 vmemmap=%s pagesize=4096 structpage=64\n' "$VM" | "$KSYMOFF" --vmemmap-offset 0 --phys2page 0x34600000 2>/dev/null)"
eq 'structpage= drives the entry size'   'ffffea00000b7500' \
   "$(printf 'arch=x86_64 vmemmap=%s pagesize=65536 structpage=56\n' "$VM" | "$KSYMOFF" --vmemmap-offset 0 --phys2page 0x34600000 2>/dev/null)"
eq '--page-shift overrides the line'     'ffffea0000d18000' \
   "$(printf 'arch=aarch64 vmemmap=%s pagesize=65536 structpage=64\n' "$VM" | "$KSYMOFF" --vmemmap-offset 0 --page-shift 12 --phys2page 0x34600000 2>/dev/null)"
# A line that states no size is the tool saying it does not know; assuming 4 KiB
# there is the bug the key exists to remove, so the page modes refuse.
errs 'pagesize=na refuses' \
   sh -c "printf 'arch=aarch64 vmemmap=$VM pagesize=na structpage=na\n' | '$KSYMOFF' --vmemmap-offset 0 --phys2page 0x34600000"
errs 'a line predating the key refuses' \
   sh -c "printf 'arch=aarch64 vmemmap=$VM\n' | '$KSYMOFF' --vmemmap-offset 0 --phys2page 0x34600000"
errs 'a non-power-of-two pagesize refuses' \
   sh -c "printf 'arch=x86_64 vmemmap=$VM pagesize=5000\n' | '$KSYMOFF' --vmemmap-offset 0 --phys2page 0x1000"
# The page size never enters a direct-map translation, so that stays answerable
# on a line that states none.
eq 'phys2virt needs no page size'  'c000000034600000' \
   "$(printf 'arch=ppc64le dmap=0xc000000000000000 pagesize=na\n' | "$KSYMOFF" --phys2virt 0x34600000 2>/dev/null)"

# A machine that does not anchor at 0 must refuse, not answer.
errs 'riscv64 refuses without an anchor' \
   sh -c "printf 'arch=riscv64 dmap=$RPO\n' | '$KSYMOFF' --phys2virt 0x80200000"
errs 'unrecognised arch refuses' \
   sh -c "printf 'arch=futurearch dmap=$RPO\n' | '$KSYMOFF' --phys2virt 0x80200000"
errs 'page2phys off an entry boundary' \
   "$KSYMOFF" --vmemmap "$VM" --page2phys 0xffffea0000d18020
errs 'riscv64 page mode refuses unanchored' \
   sh -c "printf 'arch=riscv64 vmemmap=$VM\n' | '$KSYMOFF' --phys2page 0x80200000"
errs 'struct-page-size absurd value' \
   "$KSYMOFF" --vmemmap "$VM" --struct-page-size 999999 --phys2page 0x1000
# An arch= the list does not recognise must not be reached by a prefix of one
# it does: the allowlist may only fail in the refusing direction.
errs 'arch prefix does not satisfy the list' \
   sh -c "printf 'arch=x86_64-nonesuch dmap=$PO\n' | '$KSYMOFF' --phys2virt 0x1000"

# ---- regression / error guards ----
# The signed-64 bug: a below-base virtual address must ERROR, not print a bogus
# physical address (kernel addresses have the top bit set).
errs 'virt2phys below base errors' "$KSYMOFF" --page-offset "$PO" --virt2phys 0x1000
errs 'two phys actions rejected'   "$KSYMOFF" --page-offset "$PO" --phys2virt 0x1000 --virt2phys 0x2000
errs 'bad hex rejected'            "$KSYMOFF" --page-offset "$PO" --phys2virt zz
errs 'phys2page needs vmemmap'     "$KSYMOFF" --phys2page 0x1000
errs 'symbol mode needs source'    "$KSYMOFF" -b 0xffffffff82200000 commit_creds

# ---- security: bash-arithmetic code-execution from a hostile symbol source ----
# A non-hex address field must be rejected, never fed to `$(( 0x$value ))` — an
# embedded array-subscript command substitution would otherwise run. Regression
# guard for the arithmetic-eval injection class (all three source-derived
# addresses: _text, the --from lookup, and a specific-symbol lookup).
PAY="0+a[\$(:>$MARK)]"   # bash arithmetic injection payload; no spaces
# The physical modes take numbers from the command line and from a piped
# `kasld -1` line, and every one of them reaches `$(( ... ))`. Each must be
# refused by a validator first; an unvalidated one would execute the payload.
noexec 'no exec: --phys-offset'      "$KSYMOFF" --page-offset "$PO" --phys-offset "$PAY" --phys2virt 0x1000
noexec 'no exec: --vmemmap-offset'   "$KSYMOFF" --vmemmap "$VM" --vmemmap-offset "$PAY" --phys2page 0x1000
noexec 'no exec: --vmemmap'          "$KSYMOFF" --vmemmap "$PAY" --phys2page 0x1000
noexec 'no exec: --page2phys'        "$KSYMOFF" --vmemmap "$VM" --page2phys "$PAY"
noexec 'no exec: --phys2page'        "$KSYMOFF" --vmemmap "$VM" --phys2page "$PAY"
noexec 'no exec: --struct-page-size' "$KSYMOFF" --vmemmap "$VM" --struct-page-size "$PAY" --phys2page 0x1000
noexec 'no exec: --page-shift'       "$KSYMOFF" --vmemmap "$VM" --page-shift "$PAY" --phys2page 0x1000
noexec 'no exec: hostile dmap= field' \
  sh -c "printf 'arch=x86_64 dmap=0x$PAY\n' | '$KSYMOFF' --phys2virt 0x1000"
noexec 'no exec: hostile vmemmap= field' \
  sh -c "printf 'arch=x86_64 vmemmap=0x$PAY\n' | '$KSYMOFF' --phys2page 0x1000"
# A hostile `arch=` reaches a refusal message; a terminal escape in it must not.
noesc 'no escape: arch= in a refusal' \
  "$(printf 'arch=%sevil dmap=%s\n' "${ESC}[2J" "$PO" | "$KSYMOFF" --phys2virt 0x1000 2>&1)"
printf '%s\n' "$PAY T _text" 'ffffffff81276cb0 T commit_creds' > "$EVIL"
noexec 'no exec: hostile _text address'  "$KSYMOFF" -b 0xffffffff82200000 -s "$EVIL" --slide
printf '%s\n' 'ffffffff81000000 T _text' "$PAY T commit_creds" > "$EVIL"
noexec 'no exec: hostile --from address' "$KSYMOFF" --from commit_creds=0xffffffff82476cb0 -s "$EVIL"
printf '%s\n' 'ffffffff81000000 T _text' "$PAY T commit_creds" > "$EVIL"
noexec 'no exec: hostile symbol address' "$KSYMOFF" -b 0xffffffff82200000 -s "$EVIL" commit_creds

# Terminal-escape injection: control chars in file-derived type/name fields must
# be stripped, never printed (CWE-150). Covers the per-symbol and dump paths.
printf '%s\n' 'ffffffff81000000 T _text' "ffffffff81276cb0 ${ESC}[31mT commit_creds" > "$EVIL"
noesc 'no escape: per-symbol type field' \
  "$("$KSYMOFF" -b 0xffffffff82200000 -s "$EVIL" commit_creds 2>/dev/null)"
printf '%s\n' 'ffffffff81000000 T _text' "ffffffff81276cb0 T ${ESC}evilname" > "$EVIL"
noesc 'no escape: dump-all name field' \
  "$("$KSYMOFF" -b 0xffffffff82200000 -s "$EVIL" 2>/dev/null)"

total=$((pass + fail))
if [ "$fail" -eq 0 ]; then
  printf '%scheck-ksymoff: OK%s (%s known-answer cases)\n' "$GREEN" "$RESET" "$total"
  exit 0
else
  printf '%scheck-ksymoff: %s/%s FAILED%s\n' "$RED" "$fail" "$total" "$RESET" >&2
  exit 1
fi
