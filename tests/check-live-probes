#!/bin/sh
# This file is part of KASLD - https://github.com/bcoles/kasld
#
# check-live-probes — hold each component's source: declaration to its code.
#
# source: (KASLD_META, required by check-component-meta) names where a
# component's own inputs come from, and the orchestrator schedules on it when
# the run reads a captured tree rather than the running kernel:
#
#   files   every input is a fact file the sysroot wrappers redirect, so the
#           technique replays unchanged
#   live    the result derives from live runtime state of the executing
#           kernel/CPU -- a perf syscall, a CPU instruction, a timing
#           side-channel, a set-uid helper, a self-referential /proc/self
#           pseudo-file -- which no capture carries
#   hybrid  a live step AND a captured-file read, so it runs in either mode
#           with the live step suppressed
#
# The DECLARATION is the truth. This guard does not decide which value a
# component should carry -- a source scan cannot: liveness has no single
# spelling, and the arm64 TLB fault timer measures the running kernel with
# nothing in its text but clock_gettime(). What a scan CAN do is contradict a
# declaration, and each check below is a contradiction:
#
#   - declares files, yet its source carries a live primitive (SIG). Either the
#     declaration is wrong, or the primitive is a false hit and belongs in
#     SIG_EXEMPT after review.
#   - declares files or hybrid, yet calls kasld_skip_live_probe(): that call
#     abandons the run against a capture, which is what live means.
#   - declares live, yet has no kasld_skip_live_probe(): the orchestrator drops
#     it, but a direct standalone invocation would still read the analysis host.
#   - declares hybrid, yet never asks kasld_fact_source(): nothing suppresses
#     the live step, so against a capture it runs anyway.
#   - declares files, yet asks kasld_fact_source(): a technique that replays
#     unchanged has no mode to branch on. It is hybrid, or the branch is dead.
#
# What no scan catches is a genuinely live component that declares files with a
# primitive SIG does not know. The declaration being MANDATORY is what bounds
# that: every component states a value, so the case is a wrong answer to a
# question that was asked, not a question nobody was made to answer.
#
# Usage: tests/check-live-probes   (also run by `make lint`)
# ---
# <bcoles@gmail.com>

set -u
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
COMP=$ROOT/src/components
# shellcheck source=tests/lib/guard-scope.sh
. "$ROOT/tests/lib/guard-scope.sh"

# Live primitive signatures: a source hit means the component reads live
# executing-kernel/CPU state. Kept deliberately specific to avoid false hits.
#   perf_event_open / SYS_/__NR_  — perf ksymbol/LBR/event leaks
#   rdtsc                          — timing side-channels (matches rdtsc/rdtscp)
#   sidechannel.h                  — the shared Flush+Reload / timing helpers
#   mincore(                       — mincore() residency oracle
#   sidt                           — SIDT instruction (IDT register)
#   /proc/self/syscall, getppid(   — self/parent pseudo-files (host-live)
#   PF_CAN / AF_CAN                — CAN BCM socket leak
#   NILFS_IOCTL                    — nilfs2 ioctl uninitialised-page leak
#   FBIOGET_FSCREENINFO/TIOCGSERIAL— fb / serial device-MMIO ioctl leaks
#   pppd                           — set-uid pppd helper leak
#   SYS_bpf / BPF_PROG_LOAD        — bpf verifier-log pointer leak (loads a
#                                    program into the running kernel)
#   KBASE_IOCTL / /dev/mali        — Mali GPU timeline stream pointer leak
#                                    (ioctls the running kernel's GPU device)
#   /dev/snd/seq                   — ALSA sequencer data.ext.ptr leak (drives
#                                    the running kernel's sequencer)
#   SYS_getdents64                 — kernfs seek-cookie leak (reads the running
#                                    kernel's live /sys/class/net directory)
SIG='perf_event_open|SYS_perf_event_open|__NR_perf_event_open|rdtsc|sidechannel\.h|mincore[[:space:]]*\(|sidt|/proc/self/syscall|getppid[[:space:]]*\(|PF_CAN|AF_CAN|NILFS_IOCTL|FBIOGET_FSCREENINFO|TIOCGSERIAL|pppd|SYS_bpf|BPF_PROG_LOAD|KBASE_IOCTL|/dev/mali|/dev/snd/seq|SYS_getdents64'

# Components that legitimately declare source:files while their text matches
# SIG -- a primitive named in a comment saying what the file does NOT do, say.
# Empty, and adding to it is a review decision: the usual reading of a SIG hit
# under source:files is that the declaration is wrong. Keep alphabetical.
SIG_EXEMPT=""

if [ -t 2 ] || [ -n "${KASLD_COLOR:-}" ]; then
  RED=$(printf '\033[31m'); GREEN=$(printf '\033[32m'); RESET=$(printf '\033[0m')
else
  RED=; GREEN=; RESET=
fi

contains() { # $1=needle $2=list
  for _x in $2; do [ "$_x" = "$1" ] && return 0; done
  return 1
}

fail=0
emit_fail() { # $1 = message header (printed once per kind)
  printf '%slive-probe guard: %s%s\n' "$RED" "$1" "$RESET" >&2
  fail=1
}

n=0
nlive=0
nhybrid=0
for f in "$COMP"/*.c; do
  b=$(basename "$f" .c)
  n=$((n + 1))

  src=$(grep -ho '"source:[a-z]*' "$f" | head -1 | sed 's/"source://')
  case "$src" in
  files | live | hybrid) ;;
  *)
    emit_fail 'component with no usable source: declaration:'
    printf '  %s (see check-component-meta)\n' "$b" >&2
    continue
    ;;
  esac

  detected=0
  grep -qE "$SIG" "$f" && ! contains "$b" "$SIG_EXEMPT" && detected=1
  guarded=0
  grep -q 'kasld_skip_live_probe(' "$f" && guarded=1
  branches=0
  grep -q 'kasld_fact_source(' "$f" && branches=1

  case "$src" in
  files)
    if [ "$detected" = 1 ]; then
      emit_fail 'declares source:files, but its source carries a live primitive:'
      printf '  %s\n' "$b" >&2
    fi
    if [ "$guarded" = 1 ]; then
      emit_fail 'declares source:files, but calls kasld_skip_live_probe():'
      printf '  %s\n' "$b" >&2
    fi
    if [ "$branches" = 1 ]; then
      emit_fail 'declares source:files, but branches on kasld_fact_source():'
      printf '  %s\n' "$b" >&2
    fi
    ;;
  live)
    nlive=$((nlive + 1))
    if [ "$guarded" = 0 ]; then
      emit_fail 'declares source:live, but has no kasld_skip_live_probe():'
      printf '  %s\n' "$b" >&2
    fi
    ;;
  hybrid)
    nhybrid=$((nhybrid + 1))
    if [ "$branches" = 0 ]; then
      emit_fail 'declares source:hybrid, but never asks kasld_fact_source():'
      printf '  %s\n' "$b" >&2
    fi
    if [ "$guarded" = 1 ]; then
      emit_fail 'declares source:hybrid, but calls kasld_skip_live_probe():'
      printf '  %s\n' "$b" >&2
    fi
    ;;
  esac
done

if [ "$fail" = 1 ]; then
  printf 'source: names where a component'"'"'s own inputs come from. A live probe\n' >&2
  printf 'declares source:live and calls kasld_skip_live_probe() at the top of\n' >&2
  printf 'main(), so a standalone run skips itself as the orchestrator already\n' >&2
  printf 'does. One that has something to say from a capture too declares\n' >&2
  printf 'source:hybrid and brackets the live step with kasld_fact_source().\n' >&2
  printf 'A SIG hit that is genuinely not a live primitive goes in SIG_EXEMPT,\n' >&2
  printf 'in tests/check-live-probes, after review.\n' >&2
  exit 1
fi

guard_scope "check-live-probes" "$n" 80

printf '%slive-probe guard: OK%s (%d components: %d live, %d hybrid, %d files; every declaration agrees with its code)\n' \
  "$GREEN" "$RESET" "$n" "$nlive" "$nhybrid" "$((n - nlive - nhybrid))"
