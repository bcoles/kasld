#!/bin/sh
# This file is part of KASLD - https://github.com/bcoles/kasld
#
# check-vm-ledger — the boot ledger's record shape holds, and the matrix rendered
# from it still refuses what it must.
#
# tests/vm/run writes one record per boot and renders the published results matrix
# from those records. Two things about that can rot without any boot noticing.
#
# The RECORD SHAPE is stated in three places: the REC_FIELDS count, the printf
# that writes a record, and the read that splits one. A disagreement means every
# record is refused as the wrong width, which is loud — but only to whoever next
# runs a sweep, and a sweep is an hour. Cheaper to catch here.
#
# The GATE is the reason the matrix can be published at all: a cell whose window
# does not contain the true base is a bug, and one such cell withholds the whole
# table. A gate is only worth having if it can fail, and nothing else in the suite
# exercises it — the committed boot logs are all sound, which is exactly why a
# broken gate would look identical to a working one. So this feeds the renderer
# records that must be refused, and fails if any of them renders.
#
# Synthetic records against a real cell name, with LEDGER pointed at a scratch
# file, so no guest is booted and nothing on the host is consulted: the ledger is
# the whole input. `table` also appends the speculative-narrowing table, which
# reads boot logs and prints a note when there are none; only the matrix half is
# examined here.
#
# Usage: tests/check-vm-ledger   (also run by `make lint`)
# ---
# <bcoles@gmail.com>

set -u
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
# shellcheck source=tests/lib/guard-output.sh
. "$ROOT/tests/lib/guard-output.sh"

RUN=$ROOT/tests/vm/run
TMP=$(mktemp -d "${TMPDIR:-/tmp}/kasld-vmledger.XXXXXX") || exit 1
trap 'rm -rf "$TMP"' EXIT INT TERM

fail=0

# --- 1. the three statements of the record shape agree ---------------------
declared=$(sed -n 's/^REC_FIELDS=\([0-9]*\)$/\1/p' "$RUN")
# the writer: %s specifiers in the printf that emits a record -- the only one
# whose format is tab-separated, which is what distinguishes it from the printfs
# extract_record uses to read single values
written=$(sed -n '/^extract_record()/,/^}/p' "$RUN" |
  grep -oE "printf '(%s\\\\t)+%s\\\\n'" | tr -cd '%' | wc -c)
# the reader: names on the `read` that splits a record
readback=$(sed -n '/^rec_read()/,/^}/p' "$RUN" |
  sed -n '/read -r R_/,/^$/p' | tr ' ' '\n' | grep -c '^R_')

if [ -z "$declared" ]; then
  guard_fail "no REC_FIELDS in tests/vm/run — the record shape is no longer declared"
  fail=1
elif [ "$written" != "$declared" ] || [ "$readback" != "$declared" ]; then
  guard_fail "record shape disagrees: REC_FIELDS=$declared, written=$written, read=$readback"
  printf 'Every record would be refused as the wrong width, and the matrix would\n' >&2
  printf 'render nothing, the next time anyone spent an hour on a sweep.\n' >&2
  fail=1
fi

# --- 2. a sound record renders; a violation withholds the table ------------
CELL=ppc32-mainline-7.0
# sweep rep cell profile done release source kaslr truth vlo vhi vbits
#   plo phi pbits coupled pverdict rverdict
sound="20260101T000000Z	1	$CELL	default	yes	7.0.0	mainline	on	0xc1000000	0x00000000c0000000	0x00000000c2000000	12	-	-	-	yes	NA	NA"
# the same boot with the truth moved outside its own window
violation=$(printf '%s' "$sound" | awk -F'\t' 'BEGIN{OFS="\t"} {$9="0x00000000ffffffff"; print}')
# a second boot of the same cell, disagreeing by two bits
wider=$(printf '%s' "$sound" | awk -F'\t' 'BEGIN{OFS="\t"} {$2=2; $11="0x00000000ce000000"; $12=14; print}')

render() { # ledger-contents -> stdout, status in $?
  printf '%s\n' "$1" >"$TMP/ledger"
  LEDGER="$TMP/ledger" "$RUN" table 2>"$TMP/err"
}

out=$(render "$sound") || {
  guard_fail "a sound record did not render"
  sed 's/^/    /' "$TMP/err" >&2
  fail=1
}
case $out in
*"| ppc32 |"*"12 bits"*) ;;
*)
  guard_fail "a sound record rendered no row for $CELL at 12 bits"
  fail=1 ;;
esac

if render "$violation" >/dev/null 2>&1; then
  guard_fail "a record whose truth lies OUTSIDE its window was published"
  printf 'The soundness gate is the reason this matrix can be published at all.\n' >&2
  fail=1
elif ! grep -q 'SOUNDNESS GATE FAILED' "$TMP/err"; then
  guard_fail "a violation was refused, but not as a soundness failure"
  fail=1
fi

# --- 3. boots that disagree render as a span ------------------------------
out=$(render "$sound
$wider") || { guard_fail "two boots of one cell did not render"; fail=1; }
case $out in
*"12–14 bits"*) ;;
*)
  guard_fail "two boots at 12 and 14 bits did not render as a span"
  printf 'A residual is a sample wherever the evidence moved the window, and a\n' >&2
  printf 'single figure over disagreeing boots states one boot as the result.\n' >&2
  fail=1 ;;
esac
case $out in
*"booted 2 time(s)"*) ;;
*) guard_fail "the number of boots behind the figures was not stated"; fail=1 ;;
esac

# --- 4. a short line is ignored, not read with its fields shifted ---------
out=$(render "$sound
truncated	line") || { guard_fail "a truncated line broke the render"; fail=1; }
case $out in
*"12 bits"*) ;;
*) guard_fail "a truncated line displaced the record beside it"; fail=1 ;;
esac

# --- 5. rows from different sweeps are disclosed --------------------------
older=$(printf '%s' "$sound" | awk -F'\t' 'BEGIN{OFS="\t"} {$1="20250101T000000Z"; $4="hardened"; print}')
out=$(render "$sound
$older") || { guard_fail "records from two sweeps did not render"; fail=1; }
case $out in
*"sweeps between 20250101T000000Z and 20260101T000000Z"*) ;;
*)
  guard_fail "a matrix pooling two sweeps did not say so"
  printf 'A figure that moved between sweeps moved for a reason no column names.\n' >&2
  fail=1 ;;
esac

# --- 6. a live log is kept before a boot overwrites it -------------------
# A boot truncates its pair's live log the moment qemu starts. keep_live_log
# runs first and must: keep a log that was never archived, name it by its record
# only when the log proves it is that boot, never duplicate or replace an
# archive, and refuse -- not skip -- when it cannot keep the log at all. The
# boot logs this protects cost hours to regenerate, and the failure it prevents
# is silent: nothing reports a log that was overwritten.
sed -n '/^gz_keep()/,/^}/p; /^archive_log()/,/^}/p; /^keep_live_log()/,/^}/p' \
  "$RUN" >"$TMP/keep.sh"
printf '%s\n' "$sound" >"$TMP/kl-ledger"
keep_fn() { # function args... -> its status, with the ledger bound as run binds it
  (REC_FIELDS=$declared
    LEDGER=$TMP/kl-ledger
    export REC_FIELDS LEDGER
    # shellcheck disable=SC1091  # extracted from tests/vm/run above
    . "$TMP/keep.sh"
    "$@")
}
kl() { keep_fn keep_live_log "$1/boot-$2.log" "$CELL" "$2"; } # dir profile
boot_log() { # dir profile _text -> writes a live log carrying that landmark
  mkdir -p "$1"
  printf '=== kallsyms landmarks ===\n%s T _text\nboot %s\n' "$3" "$4" \
    >"$1/boot-$2.log"
}
# shellcheck disable=SC2012  # every name in there was created by this test
kept() { ls "$1/logs" 2>/dev/null | tr '\n' ' '; }
REC=20260101T000000Z-default-1.log.gz

d=$TMP/kl/none
mkdir -p "$d"
kl "$d" default || { guard_fail "a pair with no live log was refused"; fail=1; }
[ -z "$(kept "$d")" ] || { guard_fail "nothing to keep, yet something was written"; fail=1; }

d=$TMP/kl/proven
boot_log "$d" default c1000000 a
if ! kl "$d" default || ! gzip -dc "$d/logs/$REC" 2>/dev/null | cmp -s - "$d/boot-default.log"; then
  guard_fail "a log proven to be its record's boot was not kept under that record"
  printf '  kept: %s\n' "$(kept "$d")" >&2
  fail=1
fi
kl "$d" default
[ "$(kept "$d")" = "$REC " ] || {
  guard_fail "an already-kept log was kept a second time: $(kept "$d")"
  fail=1
}

# Kept under the name one ledger implies, then checked with LEDGER pointed at
# another that has never heard of the pair: still kept, so not kept again.
: >"$TMP/kl-empty-ledger"
if ! (REC_FIELDS=$declared
  LEDGER=$TMP/kl-empty-ledger
  export REC_FIELDS LEDGER
  # shellcheck disable=SC1091  # extracted from tests/vm/run above
  . "$TMP/keep.sh"
  keep_live_log "$d/boot-default.log" "$CELL" default) ||
  [ "$(kept "$d")" != "$REC " ]; then
  guard_fail "a kept log was kept again once LEDGER changed: $(kept "$d")"
  printf 'Whether a log is kept is a fact about the archive, not about the ledger.\n' >&2
  fail=1
fi

d=$TMP/kl/other-boot
boot_log "$d" default c2000000 b
kl "$d" default
case $(kept "$d") in
"unrecorded-default-1.log.gz ") ;;
*)
  guard_fail "a log whose _text is not its record's truth was attributed to it: $(kept "$d")"
  printf 'A kept log named by a record is a claim that it is that boot.\n' >&2
  fail=1 ;;
esac

d=$TMP/kl/no-landmark
mkdir -p "$d"
printf 'no kallsyms in this one\n' >"$d/boot-default.log"
kl "$d" default
[ "$(kept "$d")" = "unrecorded-default-1.log.gz " ] || {
  guard_fail "a log that cannot show its _text was attributed to a record: $(kept "$d")"
  fail=1
}

d=$TMP/kl/no-record
boot_log "$d" hardened c1000000 c
kl "$d" hardened
boot_log "$d" hardened c1000000 d
kl "$d" hardened
if [ "$(kept "$d")" != "unrecorded-hardened-1.log.gz unrecorded-hardened-2.log.gz " ] ||
  ! gzip -dc "$d/logs/unrecorded-hardened-1.log.gz" | grep -q '^boot c$'; then
  guard_fail "two unrecorded logs of one pair were not both kept intact: $(kept "$d")"
  fail=1
fi

d=$TMP/kl/archive-differs
boot_log "$d" default c1000000 e
mkdir -p "$d/logs"
printf 'an earlier boot\n' | gzip -c >"$d/logs/$REC"
cp "$d/logs/$REC" "$TMP/before.gz"
kl "$d" default
if ! cmp -s "$d/logs/$REC" "$TMP/before.gz"; then
  guard_fail "an existing archive was replaced"
  fail=1
elif [ "$(kept "$d")" != "$REC unrecorded-default-1.log.gz " ]; then
  guard_fail "a live log differing from its record's archive was not kept beside it: $(kept "$d")"
  fail=1
fi

# The refusal. A regular file where the archive directory belongs makes both the
# directory and the write fail whoever runs this, root included.
d=$TMP/kl/cannot-keep
boot_log "$d" default c1000000 f
: >"$d/logs"
if kl "$d" default 2>/dev/null; then
  guard_fail "a log that could not be kept was reported kept -- the boot would overwrite it"
  fail=1
fi
if keep_fn archive_log "$d/boot-default.log" "$CELL" default \
  20260101T000000Z 1 2>/dev/null; then
  guard_fail "archive_log reported success on a log it could not write"
  printf 'A swallowed failure leaves the log unkept with nothing saying so.\n' >&2
  fail=1
fi

# And it is called where it can still help: in run_one, before the qemu line
# whose redirect truncates the log, with a failure stopping the boot.
body=$(sed -n '/^run_one()/,/^}/p' "$RUN")
# shellcheck disable=SC2016  # literal source text, matched as written in run
guard_at=$(printf '%s\n' "$body" | grep -n 'if ! keep_live_log "\$log"' | cut -d: -f1)
# shellcheck disable=SC2016
qemu_at=$(printf '%s\n' "$body" | grep -n 'timeout "\$TIMEOUT" \$qemu' | cut -d: -f1)
if [ -z "$guard_at" ] || [ -z "$qemu_at" ] || [ "$guard_at" -ge "$qemu_at" ]; then
  guard_fail "keep_live_log does not run before the boot that overwrites the log"
  printf '  guard at line %s of run_one, qemu at line %s\n' "${guard_at:-none}" "${qemu_at:-none}" >&2
  fail=1
elif ! printf '%s\n' "$body" | sed -n "${guard_at},$((guard_at + 3))p" | grep -q 'return [1-9]'; then
  guard_fail "a log that cannot be kept does not stop the boot"
  fail=1
fi

[ "$fail" = 0 ] || exit 1
guard_ok "record shape agrees in 3 places ($declared fields); the gate refuses a truth outside its window; disagreeing boots render as a span; short lines and mixed sweeps are handled; a live log is kept before a boot overwrites it, or the boot is refused"
