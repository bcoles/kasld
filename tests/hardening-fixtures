#!/bin/sh
# This file is part of KASLD - https://github.com/bcoles/kasld
#
# hardening-fixtures — exercise the -H hardening advisor over the x86_64 replay
# fixtures and assert its structural invariants on real captured data.
#
# The advisor's meta -> gate -> suggestion logic is unit-tested in
# tests/test_render.c by seeding component logs synthetically. This harness
# instead drives the REAL binary over captured sysroots (the path that broke
# when component .kasld_meta was read through the sysroot wrapper), so the
# meta-extraction + gate-detection + projection pipeline is checked end to end
# against real fixtures rather than hand-built inputs.
#
# It is NOT a golden-master diff (fixture output is anonymised / environment-
# dependent). It asserts invariants that must hold for ANY fixture:
#   - every active-defense gate name is one KASLD knows;
#   - an ACTIVE gate is never re-offered as available hardening;
#   - every "Set <gate> = N" suggestion maps to an INACTIVE gate whose threshold
#     is N;
#   - components_blocked / components_bypassed are subsets of components_gated;
#   - projected posture is entropy-monotone: applying all hardening never lowers
#     the guaranteed residual entropy below the current posture.
#
# x86_64 host only (runs the native binary; no qemu). Soft-skips when the host
# is not x86_64, the binary/components are not built, python3 is absent, or no
# x86_64 fixtures exist — matching the other optional guards.
# ---
# <bcoles@gmail.com>

set -u
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
FIX=$ROOT/tests/fixtures/x86_64

if [ -t 1 ] || [ -n "${KASLD_COLOR:-}" ]; then
  RED=$(printf '\033[31m')
  GREEN=$(printf '\033[32m')
  YELLOW=$(printf '\033[33m')
  RESET=$(printf '\033[0m')
else
  RED=
  GREEN=
  YELLOW=
  RESET=
fi

case "$(uname -m)" in
  x86_64 | amd64) ;;
  *)
    printf '%shardening-fixtures: SKIP%s (host %s, not x86_64)\n' \
      "$YELLOW" "$RESET" "$(uname -m)"
    exit 0
    ;;
esac
command -v python3 >/dev/null 2>&1 || {
  printf '%shardening-fixtures: SKIP%s (python3 not found)\n' "$YELLOW" "$RESET"
  exit 0
}
BIN=$(echo "$ROOT"/build/x86_64-*/kasld | awk '{print $1}')
{ [ -n "$BIN" ] && [ -x "$BIN" ]; } || {
  printf '%shardening-fixtures: SKIP%s (no x86_64 kasld binary; run make first)\n' \
    "$YELLOW" "$RESET"
  exit 0
}
[ -d "$FIX" ] || {
  printf '%shardening-fixtures: SKIP%s (no x86_64 fixtures)\n' "$YELLOW" "$RESET"
  exit 0
}

# Invariant checker: cell name in $1, the -H -j JSON in $HF_JSON (a heredoc is
# python's own stdin here, so the payload rides an env var instead). Exits
# non-zero, printing the violations, on any breach.
check() {
  python3 - "$1" <<'PY'
import sys, os, json, re
cell = sys.argv[1]
KNOWN = {
    "kernel.kptr_restrict", "kernel.dmesg_restrict",
    "kernel.perf_event_paranoid", "kernel.unprivileged_bpf_disabled",
    "kernel pointer hashing (%pK)", "seccomp syscall filter",
}
try:
    h = json.loads(os.environ["HF_JSON"])
except Exception as e:
    print("    %s: invalid JSON: %s" % (cell, e)); sys.exit(1)
h = h.get("hardening", h)
errs = []
gates = {}
for g in h.get("active_defenses", []):
    gates[g.get("gate")] = g
    if g.get("gate") not in KNOWN:
        errs.append("unknown gate %r" % g.get("gate"))
    gated = set(g.get("components_gated", []))
    for k in ("components_blocked", "components_bypassed"):
        extra = set(g.get(k, [])) - gated
        if extra:
            errs.append("%s: %s not a subset of gated: %s" %
                        (g.get("gate"), k, sorted(extra)))
for s in h.get("available_hardening", []):
    m = re.match(r"Set (.+) = (\d+)$", s.get("action", ""))
    if not m:
        continue  # lockdown / dmesg-fallback suggestions carry no gate token
    name, thr = m.group(1), int(m.group(2))
    g = gates.get(name)
    if g is None:
        errs.append("suggestion for gate absent from active_defenses: %s" % name)
        continue
    if g.get("active"):
        errs.append("ACTIVE gate re-offered as hardening: %s" % name)
    if g.get("threshold") != thr:
        errs.append("suggestion threshold %d != gate threshold %r (%s)" %
                    (thr, g.get("threshold"), name))
pp = h.get("projected_posture")
if pp is not None:
    cur, allp = pp.get("current", {}), pp.get("all_suggestions_applied", {})
    for side, o in (("current", cur), ("all_suggestions_applied", allp)):
        for k in ("virt_base_entropy_bits", "phys_base_entropy_bits"):
            if o.get(k, 0) < 0:
                errs.append("projected_posture.%s.%s < 0" % (side, k))
    for axis in ("virt_base_entropy_bits", "phys_base_entropy_bits"):
        if allp.get(axis, 0) < cur.get(axis, 0):
            errs.append("applying all hardening LOWERED %s (%d < %d) — not "
                        "entropy-monotone" %
                        (axis, allp.get(axis, 0), cur.get(axis, 0)))
if errs:
    for e in errs:
        print("    %s: %s" % (cell, e))
    sys.exit(1)
PY
}

# Markdown/JSON parity: the -H report renders in two formats from one
# hardening_report, and only JSON was ever asserted. A markdown table that
# dropped a component, carried the wrong gate's value, or lost a CVE would
# show up nowhere. Cell name in $1, the JSON in $HF_JSON, the markdown in
# $HF_MD.
#
# The two formats do not publish identical sets, and the comparisons follow the
# emitters rather than assuming they do: JSON lists every gate while markdown
# lists a gate only where it is active or bypassed, and markdown lists a
# hardware channel only where it succeeded. Those two run one way. The rest are
# set equalities, so a row appearing in neither format is still caught.
check_markdown() {
  python3 - "$1" <<'PY'
import sys, os, json, re
cell = sys.argv[1]
errs = []
try:
    h = json.loads(os.environ["HF_JSON"])
except Exception as e:
    print("    %s: invalid JSON: %s" % (cell, e)); sys.exit(1)
h = h.get("hardening", h)

md = os.environ["HF_MD"]
start = md.find("## Hardening Assessment")
if start < 0:
    print("    %s: markdown carries no hardening report" % cell); sys.exit(1)
md = md[start:]

sections, cur = {}, None
for line in md.splitlines():
    if line.startswith("### "):
        cur = line[4:].strip()
        sections[cur] = []
    elif cur is not None:
        sections[cur].append(line)


def rows(name):
    """Body rows of a section's table, as lists of cells. The header row and
    the alignment row below it are not data."""
    out, past_header = [], False
    for line in sections.get(name, []):
        if not line.startswith("|"):
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if set("".join(cells)) <= set(":- "):
            past_header = True
            continue
        if past_header:
            out.append(cells)
    return out


def bullets(name):
    return [l[2:].strip() for l in sections.get(name, []) if l.startswith("- ")]


def plain(s):
    return s.replace("`", "")


exp = h.get("exposure", {})
m = re.search(r"\*\*(\d+) of (\d+)\*\* leak techniques succeeded", md)
if not m:
    errs.append("markdown states no exposure headline")
elif (int(m.group(1)), int(m.group(2))) != (exp.get("succeeded"), exp.get("total")):
    errs.append("exposure: markdown says %s of %s, json says %r of %r"
                % (m.group(1), m.group(2), exp.get("succeeded"), exp.get("total")))

gates = {g.get("gate"): g for g in h.get("active_defenses", [])}
md_gates, lockdown_rows = {}, 0
for r in rows("Active defenses"):
    name = plain(r[0])
    if name == "Kernel lockdown":
        lockdown_rows += 1
    else:
        md_gates[name] = r
if lockdown_rows != 1:
    errs.append("active defenses: %d lockdown rows, expected exactly 1"
                % lockdown_rows)
for name, r in md_gates.items():
    g = gates.get(name)
    if g is None:
        errs.append("markdown names gate %r, absent from json active_defenses"
                    % name)
        continue
    if re.match(r"^-?[0-9]+$", r[1]) and int(r[1]) != g.get("value"):
        errs.append("%s: markdown value %s, json value %r"
                    % (name, r[1], g.get("value")))
for name, g in gates.items():
    if (g.get("active") or g.get("components_bypassed")) and name not in md_gates:
        errs.append("json reports %r active or bypassed, markdown has no row"
                    % name)

avail = h.get("available_hardening", [])
bl = bullets("Available hardening")
if len(bl) != len(avail):
    errs.append("available hardening: %d markdown bullets, %d json actions"
                % (len(bl), len(avail)))
for a in avail:
    action = a.get("action", "")
    if not any(plain(b).startswith(action) for b in bl):
        errs.append("json action %r reaches no markdown bullet" % action)

unpatched = h.get("patched_vulnerabilities", {}).get("possibly_unpatched", [])
bl = bullets("Patched vulnerabilities")
if len(bl) != len(unpatched):
    errs.append("patched vulnerabilities: %d markdown bullets, %d json entries"
                % (len(bl), len(unpatched)))
for v in unpatched:
    hit = [b for b in bl if b.split(" ")[0] == v.get("component")]
    if not hit:
        errs.append("possibly-unpatched %r reaches no markdown bullet"
                    % v.get("component"))
        continue
    for k in ("cve", "patch"):
        if v.get(k) and v[k] not in hit[0]:
            errs.append("%s: markdown bullet omits %s %r"
                        % (v.get("component"), k, v[k]))

want = sorted((x.get("component"), x.get("config"),
               x.get("discloses") or "disclosure not stated")
              for x in h.get("compile_time_surface", []))
got = sorted(tuple(r[:3]) for r in rows("Compile-time attack surface"))
if want != got:
    errs.append("compile-time surface: markdown %r, json %r" % (got, want))

hw = h.get("hardware_side_channels", [])
md_hw = set(b.split(" - ")[0] for b in bullets("Hardware side-channels"))
for x in hw:
    if x.get("succeeded") and x.get("component") not in md_hw:
        errs.append("json hardware channel %r succeeded, markdown has no bullet"
                    % x.get("component"))
for name in md_hw - set(x.get("component") for x in hw):
    errs.append("markdown names hardware channel %r, absent from json" % name)

want = sorted((x.get("component"), x.get("discloses") or "not stated")
              for x in h.get("no_mitigation", []))
got = sorted(tuple(r[:2]) for r in rows("No known mitigation"))
if want != got:
    errs.append("no known mitigation: markdown %r, json %r" % (got, want))

if errs:
    for e in errs:
        print("    %s: %s" % (cell, e))
    sys.exit(1)
PY
}

COMP=$(dirname "$BIN")/components
fail=0
n=0
for d in "$FIX"/*/; do
  [ -d "$d/sysroot" ] || continue
  cell=$(basename "$d")
  json=$(KASLD_SYSROOT="$d/sysroot" KASLD_COMPONENT_DIR="$COMP" \
    "$BIN" -H -j 2>/dev/null)
  if [ -z "$json" ]; then
    echo "    $cell: no output"
    fail=1
    continue
  fi
  if ! HF_JSON="$json" check "$cell"; then
    fail=1
  fi
  md=$(KASLD_SYSROOT="$d/sysroot" KASLD_COMPONENT_DIR="$COMP" \
    "$BIN" -q -H -m 2>/dev/null)
  if [ -z "$md" ]; then
    echo "    $cell: no markdown output"
    fail=1
  elif ! HF_JSON="$json" HF_MD="$md" check_markdown "$cell"; then
    fail=1
  fi
  n=$((n + 1))
done

if [ "$fail" -ne 0 ]; then
  printf '%shardening-fixtures: advisor invariants violated above%s\n' \
    "$RED" "$RESET" >&2
  exit 1
fi
printf '%shardening-fixtures: OK%s (%s x86_64 fixtures, advisor invariants hold; the markdown report and json agree)\n' \
  "$GREEN" "$RESET" "$n"
