#!/bin/sh
# This file is part of KASLD - https://github.com/bcoles/kasld
#
# check-render-parity — the text readout, the markdown report and JSON must
# name the SAME set of resolved quantities for a given run.
#
# The Layout row model exists so no two formats can describe the same resolved
# state differently, but it only binds a format that consults it. The
# no-randomization postures (KASLR unsupported / disabled) used to return before
# the model was built and then hardcode the kernel image base, so a quantity the
# engine had fully resolved — the module region base, pinned to one address —
# reached JSON while the text and markdown readouts omitted it entirely. Nothing
# failed: each format was internally consistent, and the omission only surfaced
# by rendering the same machine three ways and comparing by hand.
#
# This compares the NAMES, never the values. Formats legitimately present the
# same bound differently — the text block snaps a window to the alignment grid
# while markdown prints the raw edges, which is the same candidate set written
# two ways. A difference in what they SAY is the bug; a difference in how they
# say it is not.
#
# Every quantity needs an entry in the map below. A new one with no entry fails
# here, which is the point: adding a quantity should require stating how each
# format names it, rather than discovering months later that one format never
# learned about it.
#
# Runs the native binary over the fixture corpus, then sweeps whatever cross
# binaries and qemu-user are present — the cross sweep is what reaches the
# static postures, which no host fixture triggers.
#
# Env:    QEMU_DIR (default: resolve qemu-<arch> from PATH)
# ---
# <bcoles@gmail.com>

set -u
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
QEMU_DIR=${QEMU_DIR:-}

if [ -t 1 ] || [ -n "${KASLD_COLOR:-}" ]; then
  RED=$(printf '\033[31m')
  GREEN=$(printf '\033[32m')
  YELLOW=$(printf '\033[33m')
  RESET=$(printf '\033[0m')
else
  RED=
  GREEN=
  YELLOW=
  RESET=
fi

fail=0
PY=$(command -v python3 2>/dev/null)
# Scratch pair for the row diff. POSIX sh has no process substitution, so the
# two normalised row lists are compared through files.
TMP_T=$(mktemp) || exit 1
TMP_M=$(mktemp) || exit 1
TMP_RAW=$(mktemp) || exit 1
TMP_J=$(mktemp) || exit 1
trap 'rm -f "$TMP_T" "$TMP_M" "$TMP_RAW" "$TMP_J"' EXIT INT TERM
note() {
  printf '  FAIL: %s\n' "$1"
  fail=1
}

# quantity-name -> JSON key. The readout label is the key the row model carries,
# so the left column is exactly what layout_add() is given.
json_key_for() {
  case "$1" in
  "Virtual Image Base")  echo inferred ;;
  "Physical Image Base") echo inferred_physical ;;
  "Direct Map Base")     echo virt_page_offset_base ;;
  "Vmalloc Base")        echo virt_vmalloc_base ;;
  "Vmemmap Base")        echo virt_vmemmap_base ;;
  "Module Region Base")  echo module_base ;;
  "Paging Level")        echo va_bits ;;
  *)                     echo "" ;;
  esac
}

# The quantity names a text readout presents, deduplicated.
#
# Anchored on the GRADE column rather than on the label's last word. Matching
# "... Base" caught only the quantities whose names happen to end that way, so
# the paging level -- a set of admissible address-space sizes, named "Paging
# Level" -- was invisible here: a format could report it, or fail to, and this
# guard would say nothing either way. Every Layout row carries a grade in its
# second column whatever the quantity is called, so keying on that catches a new
# quantity without anyone remembering to widen a pattern.
text_quantities() {
  sed -n 's/^  \([A-Za-z][A-Za-z0-9 ]*[A-Za-z]\)  *guaranteed .*/\1/p;s/^  \([A-Za-z][A-Za-z0-9 ]*[A-Za-z]\)  *likely .*/\1/p' |
    sort -u
}

# Same, from markdown's table rows.
md_quantities() {
  sed -n 's/^| \([A-Za-z][A-Za-z0-9 ]*[A-Za-z]\) | guaranteed |.*/\1/p;s/^| \([A-Za-z][A-Za-z0-9 ]*[A-Za-z]\) | likely |.*/\1/p' |
    sort -u
}

# The full content of each Layout row, normalised so two formats that agree can
# be compared directly. Whitespace and the markdown scaffolding (pipes, code
# spans) are removed entirely rather than parsed: the text table right-aligns
# inside its columns, so a range carries padding spaces that no field split
# survives, while markdown carries none. Stripping both to the same shape
# compares what the row SAYS -- quantity, grade, range, count, pitch -- without
# asserting how either format lays it out.
#
# Names alone were compared here once, which is what let two renderers drop the
# likely grade unnoticed and let one of them narrow a displayed edge that the
# others left alone. Both are content, and neither changes which quantities a
# format names.
text_rows() {
  sed -n 's/^  \([A-Za-z][A-Za-z0-9 ]*[A-Za-z]\)  *\(guaranteed\)  */\1|\2|/p;s/^  \([A-Za-z][A-Za-z0-9 ]*[A-Za-z]\)  *\(likely\)  */\1|\2|/p' |
    tr -d ' `|' | sort
}

md_rows() {
  sed -n 's/^| \([A-Za-z][A-Za-z0-9 ]*[A-Za-z]\) | \(guaranteed\) |/\1|\2|/p;s/^| \([A-Za-z][A-Za-z0-9 ]*[A-Za-z]\) | \(likely\) |/\1|\2|/p' |
    tr -d ' `|' | sort
}

# The candidate count each format states for a quantity and grade, compared
# between the readout and json.
#
# This is the only comparison here that can catch a WRONG VALUE. The text/
# markdown row diff above compares two formats that draw from the same row
# array, so they cannot disagree about a number -- that check finds formatting
# divergence and nothing else. json is built from the engine independently, so a
# count that differs is a format asserting something the resolution did not say.
#
# It is exactly the gap a real defect went through: a readout row read "1 of 472"
# for a base the engine had narrowed to 33, and json said 33 on the same run.
# Nothing compared them.
#
# Compared only where BOTH formats state a count. Which quantities each one
# emits is a presentation policy that legitimately differs, and this is a check
# on values, not on membership -- membership is covered above.
#
# Needs python3, and skips without it, so the checks above keep running
# everywhere.
compare_counts() {
  label=$1 txt=$2 jsn=$3
  [ -n "$PY" ] || return 0
  out=$("$PY" - "$txt" "$jsn" <<'PY'
import json, re, sys

text = open(sys.argv[1], encoding="utf-8", errors="replace").read()
try:
    doc = json.load(open(sys.argv[2], encoding="utf-8", errors="replace"))
except Exception:
    sys.exit(0)                      # a non-JSON run is not this check's business
k = doc.get("kaslr") or {}

def dig(*path):
    cur = k
    for p in path:
        if not isinstance(cur, dict) or p not in cur:
            return None
        cur = cur[p]
    return cur if isinstance(cur, int) else None

# Where each (quantity, grade) states its count in json. The image base has two
# possible homes for the proven count: json reports the concrete base under
# "virtual" where one was picked and the window under "inferred" otherwise, and
# both carry the same figure.
WHERE = {
    ("Virtual Image Base", "guaranteed"):  [("inferred", "slots"), ("virtual", "slots")],
    ("Virtual Image Base", "likely"):      [("likely", "slots")],
    ("Physical Image Base", "guaranteed"): [("inferred_physical", "slots"),
                                            ("physical", "slots")],
    ("Physical Image Base", "likely"):     [("likely_physical", "slots")],
    ("Direct Map Base", "guaranteed"):     [("memory_kaslr", "virt_page_offset_base", "slots")],
    ("Direct Map Base", "likely"):         [("memory_kaslr", "virt_page_offset_base", "likely", "slots")],
    ("Vmalloc Base", "guaranteed"):        [("memory_kaslr", "virt_vmalloc_base", "slots")],
    ("Vmalloc Base", "likely"):            [("memory_kaslr", "virt_vmalloc_base", "likely", "slots")],
    ("Vmemmap Base", "guaranteed"):        [("memory_kaslr", "virt_vmemmap_base", "slots")],
    ("Vmemmap Base", "likely"):            [("memory_kaslr", "virt_vmemmap_base", "likely", "slots")],
    ("Module Region Base", "guaranteed"):  [("module_base", "slots")],
    ("Module Region Base", "likely"):      [("module_base", "likely", "slots")],
    ("Paging Level", "guaranteed"):        [("va_bits", "candidates")],
    ("Paging Level", "likely"):            [("va_bits", "likely", "candidates")],
}

# A row: label, grade, then the Candidates cell ("N" or "N of M") and the Grain
# cell at the end. Read from the RIGHT, because the Window cell right-aligns its
# addresses and so contains runs of spaces that no column split survives.
HEAD = re.compile(r"^  (?P<label>[A-Za-z][A-Za-z0-9 ]*[A-Za-z])  +"
                  r"(?P<grade>guaranteed|likely)  ")
# The Candidates cell and the Grain cell, read from the right. The cell is
# matched WHOLE rather than by grabbing its last number: "- of 4194305" states
# no count -- the window has an unstated edge -- and taking the 4194305 from it
# would compare a denominator against json's count and call the difference a
# disagreement.
TAIL = re.compile(r"(?:^|\s)(?P<cell>-(?: of \d+)?|\d+(?: of \d+)?)"
                  r"\s+(?:-|[\d.]+\s[A-Za-z]+)\s*$")

bad, checked = [], 0
for line in text.splitlines():
    h = HEAD.match(line)
    t = TAIL.search(line)
    if not h or not t:
        continue
    cell = t.group("cell")
    if cell.startswith("-"):
        continue                      # no count stated; nothing to compare
    m = re.match(r"(\d+)", cell)
    key = (h.group("label"), h.group("grade"))
    paths = WHERE.get(key)
    if paths is None:
        bad.append("%s [%s] has no json count mapping" % key)
        continue
    for path in paths:
        got = dig(*path)
        if got is None:
            continue
        checked += 1
        want = int(m.group(1))
        if got != want:
            bad.append("%s [%s]: readout says %d, json says %d"
                       % (key[0], key[1], want, got))
        break

if bad:
    print("; ".join(bad))
    sys.exit(1)
sys.exit(0)
PY
  ) || { note "$label: $out"; return; }
}

# One target (binary + optional qemu + optional sysroot), all three formats.
# shellcheck disable=SC2086  # $q is an optional interpreter prefix, intentionally split
compare_one() {
  label=$1 q=$2 bin=$3 sysroot=$4
  compdir=$(dirname "$bin")/components
  run() {
    KASLD_SYSROOT="$sysroot" KASLD_COMPONENT_DIR="$compdir" \
      $q "$bin" -q "$@" 2>/dev/null
  }
  t=$(run | text_quantities)
  m=$(run -m | md_quantities)
  j=$(run -j)

  # Text vs markdown: both read the row model, so they must agree exactly.
  if [ "$t" != "$m" ]; then
    note "$label: text and markdown name different quantities"
    printf '        text:     %s\n' "$(echo "$t" | tr '\n' ' ')"
    printf '        markdown: %s\n' "$(echo "$m" | tr '\n' ' ')"
    return
  fi

  # Text vs markdown, by content: same quantities, same grades, same values.
  tr_=$(run | text_rows)
  mr=$(run -m | md_rows)
  if [ "$tr_" != "$mr" ]; then
    note "$label: text and markdown report different rows"
    printf '%s\n' "$tr_" >"$TMP_T"
    printf '%s\n' "$mr" >"$TMP_M"
    diff "$TMP_T" "$TMP_M" 2>/dev/null | head -6 | sed 's/^/        /'
    return
  fi

  # Text vs JSON. Not a two-way name match: the two apply different policies on
  # purpose. The readout draws a row for every quantity the architecture
  # randomizes, bounded or not, so the set of rows is a property of the machine
  # rather than of the run; JSON emits a quantity only once it has something to
  # say about it. So the assertion runs ONE way -- anything JSON reports must be
  # named by the readout -- which is exactly the direction the bug ran, and
  # leaves the policy difference alone.
  for name in $(echo "$t" | tr ' ' '_'); do
    disp=$(echo "$name" | tr '_' ' ')
    [ -n "$(json_key_for "$disp")" ] ||
      note "$label: quantity \"$disp\" has no entry in json_key_for()"
  done
  # The values themselves, against the engine's own numbers.
  run >"$TMP_RAW"
  printf '%s\n' "$j" >"$TMP_J"
  compare_counts "$label" "$TMP_RAW" "$TMP_J"

  for key in inferred inferred_physical virt_page_offset_base \
    virt_vmalloc_base virt_vmemmap_base module_base; do
    # Anchored to an object key ("name": {), never a bare occurrence: the
    # component catalogue in JSON describes quantities in prose, and a
    # substring match would treat an explain string as a reported value.
    printf '%s\n' "$j" | grep -q "\"$key\": {" || continue
    found=0
    for name in $(echo "$t" | tr ' ' '_'); do
      disp=$(echo "$name" | tr '_' ' ')
      [ "$(json_key_for "$disp")" = "$key" ] && found=1
    done
    [ "$found" -eq 1 ] ||
      note "$label: JSON reports \"$key\" but the readout names no quantity for it"
  done

  # And the other way, for the quantities whose presence is a property of the
  # MACHINE rather than of the run. json emits these because the architecture
  # has the unknown, not because this run narrowed it -- the same rule the
  # readout draws its rows by -- so for these the two sets must match exactly.
  #
  # The image-base windows are deliberately not in this list: a pinned base is
  # reported as "virtual"/"physical" instead of "inferred", so one readout label
  # legitimately maps to either of two keys, which is a presentation choice
  # rather than a membership difference.
  for name in $(echo "$t" | tr ' ' '_'); do
    disp=$(echo "$name" | tr '_' ' ')
    case "$(json_key_for "$disp")" in
    virt_page_offset_base | virt_vmalloc_base | virt_vmemmap_base | \
      module_base | va_bits)
      printf '%s\n' "$j" | grep -q "\"$(json_key_for "$disp")\": {" ||
        note "$label: the readout names \"$disp\" but JSON omits \"$(json_key_for "$disp")\""
      ;;
    esac
  done
}

# The build subdirectory is named for the compiler's triple, so name the native
# binary the same way the Makefile does. Running a candidate to see whether it
# works does NOT identify it: a build for a narrower architecture runs fine here
# (an i686 binary executes on x86_64) and sorts first, so a probe would select
# it and every "host" comparison below would silently be exercising i386
# rendering instead of the host's.
BIN=
for t in "$(cc -dumpmachine 2>/dev/null)" "$(${CC:-cc} -dumpmachine 2>/dev/null)"; do
  [ -n "$t" ] || continue
  if [ -x "$ROOT/build/$t/kasld" ]; then
    BIN=$ROOT/build/$t/kasld
    break
  fi
done
[ -n "$BIN" ] || {
  printf '%scheck-render-parity: SKIP%s (no native kasld build; run make first)\n' \
    "$YELLOW" "$RESET"
  exit 0
}

n=0
host_arch=$(basename "$(dirname "$BIN")")
host_arch=${host_arch%%-*}
for sysroot in "$ROOT"/tests/fixtures/*/*/sysroot; do
  [ -d "$sysroot" ] || continue
  # A fixture is only meaningful under a binary built for its architecture.
  fx=$(basename "$(dirname "$(dirname "$sysroot")")")
  case "$host_arch:$fx" in
  x86_64:x86_64) ;;
  *) continue ;;
  esac
  compare_one "$(basename "$(dirname "$sysroot")")" "" "$BIN" "$sysroot"
  n=$((n + 1))
done

# Baseline (no fixture): the widest state, and the one every arch can render.
compare_one "baseline" "" "$BIN" "/nonexistent-sysroot"
n=$((n + 1))

qemu_for() {
  case "${1%%-*}" in
  x86_64)      echo qemu-x86_64 ;;
  i686 | i586) echo qemu-i386 ;;
  aarch64)     echo qemu-aarch64 ;;
  arm | armv7) echo qemu-arm ;;
  armeb)       echo qemu-armeb ;;
  mips)        echo qemu-mips ;;
  mipsel)      echo qemu-mipsel ;;
  mips64)      echo qemu-mips64 ;;
  mips64el)    echo qemu-mips64el ;;
  powerpc64le) echo qemu-ppc64le ;;
  powerpc64)   echo qemu-ppc64 ;;
  powerpc)     echo qemu-ppc ;;
  riscv32)     echo qemu-riscv32 ;;
  riscv64)     echo qemu-riscv64 ;;
  s390x)       echo qemu-s390x ;;
  loongarch64) echo qemu-loongarch64 ;;
  *)           echo "" ;;
  esac
}
resolve_qemu() {
  [ -n "$1" ] || return 1
  if [ -n "$QEMU_DIR" ]; then
    [ -x "$QEMU_DIR/$1" ] && echo "$QEMU_DIR/$1"
  else
    command -v "$1" 2>/dev/null
  fi
}

# The cross sweep is what reaches the KASLR-unsupported posture: no host fixture
# produces it, and that posture is where the formats diverged.
for cand in "$ROOT"/build/*/kasld; do
  [ -x "$cand" ] || continue
  [ "$cand" = "$BIN" ] && continue
  triple=$(basename "$(dirname "$cand")")
  q=$(resolve_qemu "$(qemu_for "$triple")") || continue
  [ -n "$q" ] || continue
  compare_one "$triple" "$q" "$cand" "/nonexistent-sysroot"
  n=$((n + 1))
done

if [ "$fail" -ne 0 ]; then
  printf '%scheck-render-parity: formats disagree on which quantities exist%s\n' \
    "$RED" "$RESET" >&2
  exit 1
fi
printf '%scheck-render-parity: OK%s (%d runs; text/markdown agree row for row, readout and json agree on every count, json names nothing new)\n' \
  "$GREEN" "$RESET" "$n"
