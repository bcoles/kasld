#!/bin/sh
# This file is part of KASLD - https://github.com/bcoles/kasld
#
# check-diagram-data — a diagram drawn from a table still agrees with it.
#
# Three of the diagrams under docs/diagrams/ plot data that lives in a markdown
# table elsewhere in docs/. Nothing tied the two together, and an SVG drifts more
# quietly than prose: nobody reads its diff, and a stale chart looks exactly like
# a current one. The generated chart also once drew the source table's `|---|`
# separator row as though it were an architecture, which rendered as a real row
# labelled with dashes -- a defect no consistency check caught, because it was
# equally present in the generator's output and in every regeneration of it.
#
#   entropy-by-arch.svg  vs the results matrix in docs/reproducibility.md
#                        (generated by `tests/vm/run chart`)
#   kaslr-adoption.svg   vs the KASLR history table in docs/kaslr.md
#   vmsplit.svg          vs the vmsplit table in docs/kaslr.md
#
# What is asserted is MEMBERSHIP, not the plotted values: every architecture the
# table names appears in the diagram and vice versa, and every constant the table
# fixes appears verbatim. Residual bit counts are a sample that moves with each
# harness run, so pinning them here would fail on every honest re-run; the set of
# things plotted does not move, and a diagram plotting something the table never
# mentioned is the failure worth catching.
#
# The remaining twelve diagrams are conceptual -- they illustrate a mechanism
# rather than plot a table -- so they have no source to be checked against. They
# are still covered by the structural checks below, which apply to all fifteen.
# ---
# <bcoles@gmail.com>

set -u
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
# Tables are read by column name, never by position — see the header of
# md-table.sh for why a positional reader fails silently rather than loudly.
# shellcheck source=tests/lib/md-table.sh
. "$ROOT/tests/lib/md-table.sh"

# require_rows <label> <file> — a table that yielded nothing is a broken guard,
# not a passing one. Every membership check below iterates the extracted set, so
# an empty set makes both directions vacuously true; that is exactly the state a
# renamed column or a moved table produces.
require_rows() {
  [ -s "$2" ] && return 0
  printf '%s  %s: no rows read from the source table%s (renamed column, or the table moved)\n' \
    "$RED" "$1" "$RESET"
  fail=1
  return 1
}

if [ -t 1 ] || [ -n "${KASLD_COLOR:-}" ]; then
  RED=$(printf '\033[31m')
  GREEN=$(printf '\033[32m')
  YELLOW=$(printf '\033[33m')
  RESET=$(printf '\033[0m')
else
  RED=
  GREEN=
  YELLOW=
  RESET=
fi

cd "$ROOT" || exit 2

# Scratch for the two hand-offs below: a `while` loop on the right of a pipe
# runs in a subshell, so a finding recorded there cannot set `fail` in this
# shell and is passed back through a file instead. The files live in a private
# directory rather than under a predictable name in the shared temporary
# directory, where another user could pre-create the path as a symlink for the
# redirection to write through. mktemp -d gives a 0700 directory nobody else can
# create in, which makes the names inside it safe to derive.
TMP=$(mktemp -d "${TMPDIR:-/tmp}/kasld-diagram.XXXXXX") || {
  printf '%scheck-diagram-data: FAIL%s — mktemp\n' "$RED" "$RESET"
  exit 2
}
trap 'rm -rf "$TMP"' EXIT INT TERM HUP

fail=0
nd=0

# ---- structural, all diagrams -------------------------------------------
for s in docs/diagrams/*.svg; do
  nd=$((nd + 1))
  n=$(basename "$s")
  # Referenced by some document: an unreferenced diagram is either a stale file
  # or a lost image link, and both look like a healthy repository from the shell.
  grep -ql "diagrams/$n" docs/*.md || {
    printf '%s  diagram referenced by no document%s: %s\n' "$RED" "$RESET" "$n"
    fail=1
  }
  # House conventions: generic font family, and ASCII only -- a glyph the
  # renderer lacks silently becomes a blank box in the rendered page.
  grep -q 'font-family="sans-serif"' "$s" || {
    printf '%s  diagram does not use the generic sans-serif family%s: %s\n' "$RED" "$RESET" "$n"
    fail=1
  }
  # Arrow and box-drawing glyphs specifically: those are the ones a generic
  # sans-serif family is not guaranteed to carry, and a missing glyph renders as
  # a blank box rather than failing loudly. The em-dash is used freely by the
  # existing diagrams and by the prose, so it is not in scope here.
  #
  # Matched as raw UTF-8 lead bytes with grep -F rather than a PCRE class:
  # `grep -P` is a GNU extension that busybox does not carry, and a guard whose
  # matcher is missing reports a clean pass over a file it never examined.
  # U+2190-U+21FF encodes as E2 86 xx / E2 87 xx, U+2500-U+257F as E2 94 xx /
  # E2 95 xx, so the lead pairs cover both ranges exactly.
  if LC_ALL=C grep -qF \
       -e "$(printf '\342\206')" -e "$(printf '\342\207')" \
       -e "$(printf '\342\224')" -e "$(printf '\342\225')" "$s"; then
    printf '%s  diagram uses an arrow or box-drawing glyph (draw it in ASCII)%s: %s\n' \
      "$RED" "$RESET" "$n"
    fail=1
  fi
done

# Well-formedness, where a parser is available; skipped cleanly otherwise so the
# guard still runs on a host with neither.
if command -v xmllint >/dev/null 2>&1; then
  for s in docs/diagrams/*.svg; do
    xmllint --noout "$s" 2>/dev/null || {
      printf '%s  diagram is not well-formed XML%s: %s\n' "$RED" "$RESET" "$(basename "$s")"
      fail=1
    }
  done
else
  printf '%scheck-diagram-data: partial SKIP%s (xmllint not installed; '\
'well-formedness not checked)\n' "$YELLOW" "$RESET"
fi

# ---- entropy-by-arch.svg vs the results matrix ---------------------------
SVG=docs/diagrams/entropy-by-arch.svg
MTX=docs/reproducibility.md
if [ -f "$SVG" ]; then
  # "scenario" identifies the per-scenario matrix specifically: the summary
  # table above it names arch, release and source but no scenario, so the two
  # cannot be confused however either one grows.
  md_table_select "$MTX" 'arch,scenario,KASLR' arch | sort -u >"$TMP/mtx"
  require_rows "results matrix" "$TMP/mtx" || :
  tbl=$(cat "$TMP/mtx")
  plot=$(grep -oE 'text-anchor="end">[a-z0-9_]+</text>' "$SVG" |
         sed 's/.*>\(.*\)<.*/\1/' | grep -v '^bits$' | sort -u)
  for a in $tbl; do
    printf '%s\n' "$plot" | grep -qx "$a" || {
      printf '%s  matrix architecture missing from the chart%s: %s\n' "$RED" "$RESET" "$a"
      fail=1
    }
  done
  for a in $plot; do
    printf '%s\n' "$tbl" | grep -qx "$a" || {
      printf '%s  chart plots something the matrix never names%s: %s\n' "$RED" "$RESET" "$a"
      fail=1
    }
  done
fi

# ---- kaslr-adoption.svg vs the KASLR history table -----------------------
SVG=docs/diagrams/kaslr-adoption.svg
KAS=docs/kaslr.md
if [ -f "$SVG" ]; then
  # "KASLR Added" and "Enabled by Default" each name a release the timeline must
  # plot. An architecture that never gained KASLR carries an em dash rather than
  # a version and has no event; one that never became the default has only the
  # first of the two.
  md_table_select "$KAS" 'Architecture,KASLR Added,Date Enabled' \
    'Architecture' 'KASLR Added' 'Enabled by Default' >"$TMP/hist"
  require_rows "KASLR history table" "$TMP/hist" || :
  awk -F'\t' '$2 ~ /v[0-9]/ {
        if (match($2, /v[0-9]+\.[0-9]+/)) print $1 "\t" substr($2, RSTART, RLENGTH)
        if (match($3, /v[0-9]+\.[0-9]+/)) print $1 "\t" substr($3, RSTART, RLENGTH)
      }' "$TMP/hist" |
  while IFS="$(printf '\t')" read -r arch ver; do
    grep -q ">$arch<" "$SVG" || { echo "MISSARCH $arch"; continue; }
    grep -q ">$ver<" "$SVG" || echo "MISSVER $arch $ver"
  done >"$TMP/kd" 2>/dev/null
  while read -r kind rest; do
    case $kind in
      MISSARCH) printf '%s  history-table arch missing from the timeline%s: %s\n' "$RED" "$RESET" "$rest"; fail=1 ;;
      MISSVER)  printf '%s  timeline version disagrees with the history table%s: %s\n' "$RED" "$RESET" "$rest"; fail=1 ;;
    esac
  done <"$TMP/kd"
fi

# ---- vmsplit.svg vs the vmsplit table ------------------------------------
SVG=docs/diagrams/vmsplit.svg
if [ -f "$SVG" ]; then
  md_table_select "$KAS" 'Split,PAGE_OFFSET,User / Kernel' 'Split' 'PAGE_OFFSET' >"$TMP/vs"
  require_rows "vmsplit table" "$TMP/vs" || :
  while IFS="$(printf '\t')" read -r name po; do
    [ -n "$name" ] || continue
    grep -q ">$name<" "$SVG" || {
      printf '%s  vmsplit table row missing from the diagram%s: %s\n' "$RED" "$RESET" "$name"
      fail=1
    }
    grep -q ">$po<" "$SVG" || {
      printf '%s  vmsplit PAGE_OFFSET disagrees with the table%s: %s (%s)\n' "$RED" "$RESET" "$name" "$po"
      fail=1
    }
  done <"$TMP/vs"
fi

if [ "$fail" -eq 0 ]; then
  printf '%scheck-diagram-data: OK%s (%d diagrams; 3 checked against their source tables)\n' \
    "$GREEN" "$RESET" "$nd"
else
  printf '%scheck-diagram-data: FAIL%s\n' "$RED" "$RESET"
fi
exit "$fail"
