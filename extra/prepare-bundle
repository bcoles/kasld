#!/bin/sh
# This file is part of KASLD - https://github.com/bcoles/kasld
#
# prepare-bundle — turn a captured bundle into a sysroot kasld can be pointed at.
#
# extra/collect writes a bundle: a path-preserving sysroot/ mirror, meta.txt,
# and sizes.txt. The mirror is not directly runnable. Two of the files it
# describes are present only in outline, because carrying them whole would put
# a multi-megabyte kernel image in every capture:
#
#   sizes.txt   one "<bytes> <path>" row per file captured as a prefix. The
#               prefix holds the header a parser reads; the row holds the true
#               length, which is a proven lower bound on the kernel image and
#               reaches the engine as one. Restoring the length is what makes
#               the bundle carry the fact the live system carried.
#   sys/firmware/fdt   the flattened device tree, captured as the one blob
#               rather than the hundreds of files under /proc/device-tree that
#               the DT components read.
#
# So "point KASLD_SYSROOT at the bundle" is not the whole recipe, and the part
# it omits is silent: the run simply reads a short file and resolves one bound
# fewer. This is that recipe, in one place, so a harness and an operator
# prepare a bundle the same way.
#
# The recipe has an argument the bundle carries and the sysroot does not: WHICH
# kasld reads it. Nothing a kernel exposes names the machine it ran on, so that
# lives in the bundle's meta.txt beside the sysroot, and a prepared tree stands
# apart from it. The architecture is printed here so an operator can choose the
# build rather than guess it; kasld itself notices only when it is reading a
# capture still sitting in its bundle.
#
# Usage:  extra/prepare-bundle <bundle-dir> <dest-dir>
#         KASLD_SYSROOT=<dest-dir> kasld -v
#
# <dest-dir> is created; an existing non-empty one is refused rather than
# written into. The caller owns it afterwards, including removing it.
#
# Exit codes:  0 prepared;  2 bundle malformed or unusable.
#
# Device-tree expansion is soft: it needs python3, and without it the DT
# components report the source as unavailable, which is a valid run. The
# expander is tests/fdt-unflatten, beside the fixture corpus that motivates it;
# nothing under extra/ is installed, so both are repo-local either way.
# ---
# <bcoles@gmail.com>

set -u

PROG=$(basename "$0")
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

die() { echo "$PROG: $*" >&2; exit 2; }

# The bundle layout this reader understands. extra/collect stamps the version it
# wrote; a bundle from a LATER writer may describe files in a way this does not
# know how to restore, and reading it as though it did would prepare a tree that
# is quietly missing something. Older versions stay readable: every field this
# reads has been there since the first.
KNOWN_VERSION=3

[ "$#" -eq 2 ] || {
  echo "Usage: $PROG <bundle-dir> <dest-dir>" >&2
  exit 2
}
BUNDLE=$1
DEST=$2

[ -d "$BUNDLE" ] || die "bundle '$BUNDLE' is not a directory"
[ -d "$BUNDLE/sysroot" ] || die "bundle missing sysroot/"

meta_field() {
  awk -F: -v k="^$1:" '$0 ~ k { gsub(/[ \t]/, "", $2); print $2 }' \
    "$BUNDLE/meta.txt" 2>/dev/null | head -1
}

BUNDLE_ARCH=
if [ -f "$BUNDLE/meta.txt" ]; then
  v=$(meta_field collect_version)
  case "$v" in
  '' | *[!0-9]*) ;; # absent or not a number: read it as the original layout
  *)
    [ "$v" -le "$KNOWN_VERSION" ] ||
      die "bundle is collect_version $v; this reader knows $KNOWN_VERSION"
    ;;
  esac
  BUNDLE_ARCH=$(meta_field uname_m_raw)
fi

if [ -e "$DEST" ]; then
  [ -d "$DEST" ] || die "destination '$DEST' exists and is not a directory"
  [ -z "$(ls -A "$DEST" 2>/dev/null)" ] ||
    die "destination '$DEST' is not empty"
else
  mkdir -p "$DEST" || die "cannot create '$DEST'"
fi

# cp -a, so the mirror's symlinks survive as symlinks: /sys/class/<class>/<name>
# is a link into /sys/devices and dereferencing it would flatten the shape the
# components walk.
cp -a "$BUNDLE/sysroot/." "$DEST/" || die "copying the sysroot mirror failed"

if [ -f "$DEST/sys/firmware/fdt" ] && command -v python3 >/dev/null 2>&1; then
  python3 "$ROOT/tests/fdt-unflatten" "$DEST/sys/firmware/fdt" \
    "$DEST/sys/firmware/devicetree/base" 2>/dev/null || true
fi

# Restore each captured file to its true length. The bytes past the captured
# prefix are zero: the length is the fact, and a parser that needs content finds
# the header where it was.
# Both fields of a row come from the capture, so neither is trusted. The length
# reaches truncate and the path names a file this creates, so a path that leaves
# the destination turns a restore into a write anywhere the invoking user can
# reach. Three ways out exist, and a row carrying any of them reads as ordinary:
# a `..` component in the path, a symlink where the file goes, and a symlink
# standing in for one of its parent directories. The mirror keeps its symlinks
# deliberately (see cp -a above), so the last two need nothing but an innocent
# path -- the link does the leaving.
#
# Walking the path down from the destination refuses all three at once: with no
# `..` in the row and no symlink on the way, a component cannot name anything
# outside $DEST. CONTAINED_DEST is set to the destination path on success.
contained_dest() {
  cd_p=$1
  CONTAINED_DEST=

  # Absolute, and no `..` for any component. The trailing slash lets one pattern
  # cover a `..` at the end of the path as well as in the middle.
  case $cd_p in
    /*) ;;
    *) return 1 ;;
  esac
  case "$cd_p/" in
    */../*) return 1 ;;
  esac

  cd_leaf=${cd_p##*/}
  [ -n "$cd_leaf" ] || return 1

  # Create the directory part a component at a time. A component that is already
  # a symlink ends the row: following it is how a mirror escapes its own tree,
  # and `mkdir -p` would walk straight through.
  cd_cur=$DEST
  cd_rest=${cd_p%/*}
  cd_rest=${cd_rest#/}
  while [ -n "$cd_rest" ]; do
    cd_c=${cd_rest%%/*}
    case $cd_rest in
      */*) cd_rest=${cd_rest#*/} ;;
      *) cd_rest= ;;
    esac
    [ -n "$cd_c" ] || continue
    cd_cur=$cd_cur/$cd_c
    if [ -h "$cd_cur" ]; then
      return 1
    fi
    [ -d "$cd_cur" ] || mkdir "$cd_cur" 2>/dev/null || return 1
  done

  # The file itself, for the same reason: truncate follows a link.
  if [ -h "$cd_cur/$cd_leaf" ]; then
    return 1
  fi

  CONTAINED_DEST=$cd_cur/$cd_leaf
  return 0
}

if [ -f "$BUNDLE/sizes.txt" ]; then
  refused=0
  while read -r sz path; do
    if [ -z "$sz" ] || [ -z "$path" ]; then
      continue
    fi
    # A length that is not a plain decimal is not a length.
    case $sz in
      *[!0-9]*)
        refused=$((refused + 1))
        continue
        ;;
    esac
    if ! contained_dest "$path"; then
      refused=$((refused + 1))
      continue
    fi
    truncate -s "$sz" "$CONTAINED_DEST" 2>/dev/null || refused=$((refused + 1))
  done < "$BUNDLE/sizes.txt"

  # Said once, with a count: a bundle that trips this is either corrupt or
  # hostile, and either way the operator is reading a tree that is short a fact.
  if [ "$refused" -ne 0 ]; then
    echo "$PROG: refused $refused sizes.txt row(s): a length that is not a number," \
      "or a path that leaves the destination" >&2
  fi
fi

# Name the architecture the capture came from, so the reader is chosen rather
# than assumed. A bundle predating the field says nothing, and stays silent.
if [ -n "$BUNDLE_ARCH" ]; then
  echo "bundle architecture: $BUNDLE_ARCH — read it with the kasld built for that" >&2
fi

exit 0
