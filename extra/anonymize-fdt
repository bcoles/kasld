#!/bin/sh
# This file is part of KASLD - https://github.com/bcoles/kasld
#
# anonymize-fdt — strip board-identifying data from a captured flattened
# device tree before committing it to a shared replay fixture.
#
# The blob grabbed by extra/collect (sysroot/sys/firmware/fdt) can carry a board
# serial number and MAC addresses. These identify the specific device/owner, so
# the identifying properties are removed wherever they appear, and the Android /
# Pixel bootloader's /chosen/config identity node (IMEI, board/product serial,
# Wi-Fi/BT MAC, all under vendor property names a fixed list cannot enumerate)
# is dropped whole.
#
# Deliberately KEPT: chosen/kaslr-seed and chosen/rng-seed. They are random,
# non-identifying values (the kernel zeroes them after boot anyway), and KASLD
# *reads* kaslr-seed to infer the KASLR state (fdt_facts / riscv64_no_seed /
# riscv64_fdt_kaslr_seed) — scrubbing it would falsify the fixture's ground
# truth. Existing committed fixtures keep chosen/kaslr-seed as-is.
#
# Requires `dtc`. Edits each .dtb in place and writes no backup beside it: an
# unscrubbed copy of the tree left in the bundle is what this exists to keep out
# of it, and a name ending in .orig is not obviously a device tree to whoever
# files the capture. The original is held outside the bundle for as long as the
# rebuild takes and put back if it fails, so a failure leaves the input as it
# was rather than a truncated blob. Run on the dev host (the target usually has
# no dtc), then review the result before committing:
#   dtc -I dtb -O dts <file> | less
#
# Usage:  extra/anonymize-fdt <fdt.dtb> [more.dtb ...]
# ---
# <bcoles@gmail.com>
set -eu

# Property names removed wherever they occur (board/owner-identifying only).
SCRUB='serial-number local-mac-address mac-address'

# Whole nodes dropped by path. The Android/Pixel bootloader stashes device
# identity (IMEI, board/product serial, Wi-Fi/BT MAC) under /chosen/config with
# vendor-specific property names no fixed SCRUB list can enumerate; KASLD never
# reads that node, so drop it entire. kaslr-seed / rng-seed sit directly under
# /chosen as siblings, so they are untouched.
DROP_NODES='/chosen/config'

command -v dtc >/dev/null 2>&1 || {
  echo "anonymize-fdt: dtc not found (install device-tree-compiler)" >&2
  exit 1
}
[ "$#" -ge 1 ] || {
  echo "usage: extra/anonymize-fdt <fdt.dtb> [more.dtb ...]" >&2
  exit 2
}

# Every temporary file is allocated by mktemp and removed by the trap, so an
# error or a signal part-way through a file does not leave one behind. Names are
# never derived from each other: the temporary directory is shared and
# world-writable, and a name built by appending to another (`$clean.report`) is
# predictable from the moment the first one appears, so anyone on the host could
# pre-create it as a symlink and have the redirection below write through it.
dts=''
clean=''
report=''
orig=''
cleanup() {
  # `if` rather than `[ ... ] && rm`: under `set -e` an unset name would make the
  # && list return non-zero and abandon the removals after it.
  if [ -n "$dts" ]; then rm -f "$dts"; fi
  if [ -n "$clean" ]; then rm -f "$clean"; fi
  if [ -n "$report" ]; then rm -f "$report"; fi
  if [ -n "$orig" ]; then rm -f "$orig"; fi
  return 0
}
trap cleanup EXIT INT TERM HUP

for dtb in "$@"; do
  if [ ! -f "$dtb" ]; then
    echo "skip (not a file): $dtb" >&2
    continue
  fi
  orig=$(mktemp) || { echo "anonymize-fdt: mktemp failed" >&2; exit 1; }
  cp -f "$dtb" "$orig"
  dts=$(mktemp) || { echo "anonymize-fdt: mktemp failed" >&2; exit 1; }
  clean=$(mktemp) || { echo "anonymize-fdt: mktemp failed" >&2; exit 1; }
  report=$(mktemp) || { echo "anonymize-fdt: mktemp failed" >&2; exit 1; }
  dtc -I dtb -O dts -o "$dts" "$dtb" 2>/dev/null

  # Two removals over the decompiled tree, each logged to the report on stderr:
  #  - any whole node whose path is in DROP_NODES (its subtree, brace-balanced);
  #  - any property assignment whose name is in SCRUB, wherever it occurs (a
  #    value may span lines, so keep dropping until the terminating ';').
  # The node path is tracked with a small stack: stack[1] is the root, so a node
  # contributes the path /stack[2]/.../stack[sp].
  awk -v scrub="$SCRUB" -v dropnodes="$DROP_NODES" '
    BEGIN {
      n = split(scrub, a, " ");      for (i = 1; i <= n; i++)  deny[a[i]] = 1
      dn = split(dropnodes, b, " "); for (i = 1; i <= dn; i++) dropn[b[i]] = 1
    }
    drop { op = gsub(/\{/, "{"); cl = gsub(/\}/, "}"); bal += op - cl; if (bal <= 0) drop = 0; next }
    skip { if ($0 ~ /;[[:space:]]*$/) skip = 0; next }
    {
      t = $0; sub(/^[[:space:]]+/, "", t); sub(/[[:space:]]+$/, "", t)
      if (t ~ /\{$/ && t !~ /=/) {                        # node open: "name {"
        nm = t; sub(/[[:space:]]*\{$/, "", nm)
        sp++; stack[sp] = nm
        path = ""; for (i = 2; i <= sp; i++) path = path "/" stack[i]
        if (path in dropn) {
          print "  removed node: " path > "/dev/stderr"
          drop = 1; bal = 1; sp--; next                   # opening brace consumed
        }
        print; next
      }
      if (t == "};" || t == "}") { if (sp > 0) sp--; print; next }   # node close
      name = t; sub(/[[:space:]]*=.*/, "", name); sub(/;.*$/, "", name)
      if (name in deny) {
        print "  removed: " name > "/dev/stderr"
        if ($0 !~ /;[[:space:]]*$/) skip = 1
        next
      }
      print
    }
  ' "$dts" >"$clean" 2>"$report"

  # The rebuild writes over the input, so a failure half-way leaves a truncated
  # tree where a capture used to be. Put the original back and stop.
  if ! dtc -I dts -O dtb -o "$dtb" "$clean" 2>/dev/null || [ ! -s "$dtb" ]; then
    cp -f "$orig" "$dtb"
    echo "anonymize-fdt: $dtb: rebuild failed; original restored" >&2
    exit 1
  fi
  hits=$(grep -c '^  removed' "$report" 2>/dev/null || echo 0)
  grep '^  removed' "$report" >&2 || true
  echo "$dtb: removed ${hits} identifying item$([ "$hits" = 1 ] && echo '' || echo s)"
  echo "  review: dtc -I dtb -O dts $dtb | less"
  cleanup
  dts=''
  clean=''
  report=''
  orig=''
done
