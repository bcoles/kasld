#!/usr/bin/env bash
# This file is part of KASLD - https://github.com/bcoles/kasld
#
# Apply a KASLR slide to kernel symbols, derive the slide and text base
# from a known runtime symbol address, translate physical <-> virtual
# addresses through the direct map, or translate physical <-> `struct page`
# through the vmemmap array. Works against System.map,
# `/proc/kallsyms` snapshots, and vmlinux ELF (debug-symbols enabled).
#
# Synopsis:
#   ksymoff [-b BASE | --from NAME=ADDR] -s SOURCE [--slide] [SYMBOL ...]
#   ksymoff --page-offset BASE [--phys-offset ADDR]
#           { --phys2virt ADDR | --virt2phys ADDR }
#   ksymoff --vmemmap BASE [--vmemmap-offset ADDR] [--struct-page-size N]
#           [--page-shift N] { --phys2page ADDR | --page2phys ADDR }
#
# Modes
# -----
#   Forward    Given the runtime text base, print runtime addresses for
#              one or more symbols, or for every symbol in the source
#              when no symbols are listed.
#
#   Inverse    Given a known runtime symbol address (--from NAME=ADDR),
#              derive the runtime text base. Combine with positional
#              symbol names to chain into forward lookup — one leaked
#              address yields many.
#
#   --slide    Print only the KASLR slide (signed hex). Combines with
#              either mode.
#
#   Physical   Translate physical <-> virtual through the direct map, and
#              physical <-> `struct page` through the vmemmap array, for
#              data-only pivots (Dirty Pagetable, cross-cache) that work in
#              physical addresses. Needs bases, not a symbol source:
#                --phys2virt ADDR   phys -> direct-map virtual
#                --virt2phys ADDR   direct-map virtual -> phys
#                --phys2page ADDR   phys -> struct page *
#                --page2phys ADDR   struct page * -> phys
#
# Supply the runtime text base one of two mutually exclusive ways, or let it
# fall back to stdin:
#   --from NAME=ADDR    derived from any known runtime symbol address
#   -b BASE             a hex address (with or without 0x prefix)
#                       (--from and -b are alternatives; giving both is an error)
#   stdin               fallback: a `kasld -1` line piped in (uses `text=` field)
#
# Usage
# -----
#   # Forward: look up specific symbols
#   ksymoff -b 0xffffffff82200000 -s System.map commit_creds
#   ksymoff -b 0xffffffff82200000 -s vmlinux commit_creds prepare_kernel_cred
#   kasld -1 | ksymoff -s System.map commit_creds
#
#   # Forward: dump every symbol with the slide applied
#   ksymoff -b 0xffffffff82200000 -s System.map
#
#   # Slide only
#   ksymoff -b 0xffffffff82200000 -s System.map --slide
#   ksymoff --from commit_creds=0xffffffff82345678 -s System.map --slide
#
#   # Inverse: derive the runtime text base from one known symbol
#   ksymoff --from commit_creds=0xffffffff82345678 -s System.map
#
#   # Inverse + forward: one leak yields many symbols
#   ksymoff --from commit_creds=0xffffffff82345678 -s vmlinux \
#           prepare_kernel_cred init_cred modprobe_path
#
#   # Physical <-> virtual through the direct map (data-only pivots)
#   ksymoff --page-offset 0xffff9e8000000000 --phys2virt 0x34600000
#   ksymoff --page-offset 0xffff9e8000000000 --virt2phys 0xffff9e8034600000
#   kasld -1 | ksymoff --phys2virt 0x34600000        # reads the `dmap=` field
#
#   # Physical <-> struct page (page-table attacks, cross-cache)
#   ksymoff --vmemmap 0xffffea0000000000 --phys2page 0x34600000
#   ksymoff --vmemmap 0xffffea0000000000 --page2phys 0xffffea0000d18000
#   kasld -1 | ksymoff --phys2page 0x34600000        # reads the `vmemmap=` field
#
#   # A board whose RAM starts at 0x80000000 (riscv, arm32, ppc32)
#   kasld -1 | ksymoff --phys-offset 0x80000000 --phys2virt 0x80200000
#   kasld -1 | ksymoff --vmemmap-offset 0x80000000 --phys2page 0x80200000
#
# The linear-map anchor
# ---------------------
# The kernel maps physical address `phys_offset` at the direct-map base, so the
# translation is
#
#   virt = (phys − phys_offset) + page_offset
#
# and the familiar `phys + page_offset` is the special case phys_offset == 0.
# That case holds on the architectures which map physical 0 at the linear-map
# base — x86, mips, ppc64, loongarch64, s390 — and not on those which take the
# anchor from the base of DRAM (arm32, ppc32, riscv32/64, commonly 0x80000000
# on riscv) or from a runtime value (arm64's memstart_addr). Assuming zero
# where it does not hold misplaces every result by the anchor, silently.
#
# --phys-offset supplies it. The vmemmap array is indexed from an anchor of its
# own: the `struct page` for a physical address is found at index
# (phys − vmemmap_offset) >> page-shift, not at the raw PFN.
#
# The two are usually the same number, and --vmemmap-offset defaults to
# --phys-offset accordingly. x86 uses 0 for both; arm64 rounds the base of DRAM
# down once and uses that value for the linear map and the array alike. riscv
# rounds twice and to different granularities -- the linear map from the DRAM
# base at PMD granularity, the array from that value rounded down again to the
# memory-section size (128 MiB) -- so on a board whose DRAM does not begin on a
# section boundary the two differ, and --vmemmap-offset states the array's.
# A board whose RAM starts at 0x80000000 is already section-aligned.
#
# Where a base is taken from a piped `kasld -1` line, the `arch=` field beside
# it decides the default: zero for a machine known to anchor there, and
# otherwise a refusal rather than a wrong address. Naming the bases on the
# command line states the layout by hand, consults no `arch=`, and leaves the
# anchor at zero.
#
# Page geometry
# -------------
# The `struct page` modes also need the page size and sizeof(struct page), and
# the two are known to different degrees.
#
# A `kasld -1` line states the target's page size outright, as `pagesize=`, so
# --page-shift is taken from there rather than guessed from the machine. That
# matters on arm64, powerpc, mips and loongarch, which build with a choice of
# page sizes: a shift four out puts the entry sixteen times too far along the
# array, and no default can serve them.
#
# Where a line was read and stated none (`pagesize=na`), that is the tool saying
# it does not know, and the `struct page` modes refuse rather than assume.
# Where no line was read at all the bases were named by hand, and 4 KiB stands
# as the documented default beside the anchor's zero -- so on a 16 KiB or 64 KiB
# target the shift has to be stated there, since nothing is left to notice it
# was not. `getconf PAGESIZE` on the target reports it.
#
# sizeof(struct page) comes off the same line as `structpage=` where BTF
# reported it. Nothing outside the kernel's own BTF derives it, so it cannot be
# gated the way the page size is -- a check that could never pass would remove
# the mode rather than make it honest. Absent from the line, --struct-page-size
# defaults to 64, the value on essentially every 64-bit configuration.
#
# Output: a virtual address prints as 16 zero-padded hex digits with no prefix
# (`ffff9e8034600000`); a physical address prints `0x`-prefixed (`0x34600000`).
#
# Caveat: assumes a SINGLE KASLR slide — i.e. canonical (source/link-order)
# function layout, where every symbol sits at a fixed offset from the text base.
# This is FALSE on reordered-text kernels: under FG-KASLR each function is moved
# independently per boot (no single slide — one leak pins only that one symbol),
# and under LTO / AutoFDO / Propeller the offsets come from that exact build only
# (a generic version-level System.map mis-resolves). Check first with
# `kasld -H` ("Function layout" / "symbol resolution") or the `text_order` field
# in `kasld -H -j`: proceed only for `canonical`; for a static reorder use the
# build_id-matched map; for per-boot do not use ksymoff for chaining at all.
#
# Options
# -------
#   -b, --base BASE       Runtime text base (hex, with or without 0x).
#   -s, --symbols FILE    Symbol source: System.map, kallsyms dump, or
#                         vmlinux ELF. Required.
#   --from NAME=ADDR      Known runtime symbol address; derives base.
#                         Mutually exclusive with -b.
#   --slide               Print only the slide.
#   --page-offset BASE    Direct-map base (page_offset_base) for --phys2virt /
#                         --virt2phys; or piped from `kasld -1` (`dmap=` field).
#   --phys-offset ADDR    Physical address mapped at the direct-map base (the
#                         linear-map anchor). Default 0; see above.
#   --vmemmap-offset ADDR Physical address the vmemmap array indexes from.
#                         Defaults to --phys-offset.
#   --phys2virt ADDR      Print the direct-map virtual address of a phys addr.
#   --virt2phys ADDR      Print the physical address of a direct-map virt addr.
#   --vmemmap BASE        vmemmap base (struct page array) for --phys2page /
#                         --page2phys; or piped from `kasld -1` (`vmemmap=`).
#   --struct-page-size N  sizeof(struct page) (default 64).
#   --page-size N         Alias for --struct-page-size.
#   --page-shift N        Page shift, log2(memory page size) (default 12 = 4 KiB).
#   --phys2page ADDR      Print the `struct page *` for a physical address.
#   --page2phys ADDR      Print the physical address of a `struct page *`.
#   -h, --help            Show this help and exit.
#
# Symbol file
# -----------
# `-s` accepts System.map, a kallsyms dump, or a vmlinux ELF. The
# file must correspond to the running kernel; a mismatch produces
# wrong addresses without error.
#
# The KASLD `kernel_notes_buildid` component prints the GNU build_id
# from /sys/kernel/notes. `readelf -n vmlinux` prints the build_id
# embedded in a vmlinux. Equal values mean the vmlinux matches the
# running kernel.
#
# Sources for a matching vmlinux include: an offline build of the
# running kernel's source tree; a captured System.map from install
# time; the distro debug-symbols package when the target runs a
# stock distro kernel and the analysis host can reach that distro's
# archive (linux-image-$(uname -r)-dbgsym on Debian/Ubuntu,
# kernel-debuginfo-$(uname -r) on Fedora/RHEL); `debuginfod-find
# debuginfo <build_id>` when the kernel falls within a debuginfod
# server's coverage window.
#
# Requires bash for 64-bit hex arithmetic (dash clamps to LONG_MAX).
# Requires nm(1) or readelf(1) only when the symbol source is ELF.
# ---
# <bcoles@gmail.com>

set -e

die()  { printf 'ksymoff: %s\n' "$1" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# Unsigned less-than for up-to-64-bit hex (bash arithmetic is signed, so kernel
# addresses with the top bit set miscompare). Zero-pad to 16 and compare
# lexically — byte order on equal-width lowercase hex is unsigned order.
hex_ult() {  # a b (hex, no 0x) -> true if a < b unsigned
  local a b
  a=$(printf '%016s' "${1,,}"); a=${a// /0}
  b=$(printf '%016s' "${2,,}"); b=${b// /0}
  [[ "$a" < "$b" ]] && return 0
  return 1
}

# Read one address-valued field out of a `kasld -1` line.
#
# That line states a quantity three ways: `key=0xHEX` when the engine resolved
# it, `key=[0xLO..0xHI]` when it only bounded it, and `key=na` when it knows
# nothing. Only the bare-address form is a value to compute with, so the pattern
# requires `=0x` and the other two simply do not match -- a window's floor is an
# EDGE, and translating an address through it is wrong rather than approximate.
#
# The key is anchored to start-of-line or whitespace so a lookup for `text`
# cannot match inside `ptext` (the physical base, and a different slide).
#
# Prints the hex digits without the 0x prefix; returns 1 when the field is
# absent or holds no single value.
oneline_hex() {  # key line -> hex (no 0x)
  [[ "$2" =~ (^|[[:space:]])"$1"=0x([0-9a-fA-F]+)([[:space:]]|$) ]] || return 1
  printf '%s' "${BASH_REMATCH[2]}"
}

# Read one decimal-valued field out of a `kasld -1` line. The geometry keys are
# plain counts, not addresses, so they carry no 0x and use this rather than
# oneline_hex; `na` does not match, which is the whole point.
oneline_dec() {  # key line -> decimal
  [[ "$2" =~ (^|[[:space:]])"$1"=([0-9]+)([[:space:]]|$) ]] || return 1
  printf '%s' "${BASH_REMATCH[2]}"
}

# log2 of a power of two. Fails on anything else: a page size that is not a
# power of two is not a page size, and shifting by a rounded-down log would
# misplace every entry rather than approximate it.
size_to_shift() {  # varname size
  local n=$2 k=0
  (( n >= 1 )) || return 1
  while (( n > 1 )); do
    (( n & 1 )) && return 1
    n=$(( n >> 1 ))
    k=$(( k + 1 ))
  done
  printf -v "$1" '%s' "$k"
}

# SECURITY: any value interpolated into `$(( 0x$x ))` must be pure hex/decimal.
# bash arithmetic evaluates embedded command substitutions and array subscripts,
# so a value like `a[$(cmd)]` from an untrusted symbol source would execute as a
# command. Every arithmetic input is validated by one of these first. (The same
# guard is duplicated in extra/check-results — deliberately no shared library:
# ksymoff installs to $PREFIX/bin and check-results is copied to a target, so
# neither can source one. A correction here does NOT reach numeric()/hex16()
# there -- review all four together. The accept sets differ on purpose (is_hex
# refuses an 0x prefix, its callers having stripped one; is_dec is decimal-only
# for --page-shift and --page-size); what none may do is accept a shell
# metacharacter, which tests/check-validators asserts against a shared
# adversarial corpus.
#
# @arith-validator
is_hex() { case "$1" in ''|*[!0-9A-Fa-f]*) return 1 ;; *) return 0 ;; esac; }
# @arith-validator
is_dec() { case "$1" in ''|*[!0-9]*)       return 1 ;; *) return 0 ;; esac; }

# Strip an optional 0x prefix and require what remains to be pure hex, then
# assign it. Every address that reaches `$(( 0x$x ))` from the command line or
# from a piped line arrives through here, so the strip and the check cannot
# drift apart the way ten hand-written copies of the pair can.
#
# It assigns rather than prints because `die` must reach the real shell: inside
# `$( )` the exit would end only the subshell, the caller would carry on with an
# empty value, and a rejected address would read as an absent one.
hexset() {  # varname label value
  local v=${3#0[xX]}
  is_hex "$v" || die "bad $2: $3"
  printf -v "$1" '%s' "$v"
}

# -- Argument parsing -----------------------------------------------------
base="" symfile="" slide_only=0
from_sym="" from_addr=""
symbols=()
page_offset="" vmemmap="" struct_page_bytes=64 page_shift=""
phys_offset="" vmemmap_offset=""
# The requested translation is ONE axis with one value, not four variables that
# happen to be empty. Four made the mode and its operand the same string, so the
# set had to be counted to reject a second one, re-tested to decide which bases
# it needed, and tested a third time to dispatch -- with the last mode reached by
# elimination, which a fifth would have silently become.
phys_mode="" phys_addr=""
PHYS_MODES="--phys2virt / --virt2phys / --phys2page / --page2phys"
set_phys_mode() {  # mode addr
  [[ -z "$phys_mode" ]] || die "use one of $PHYS_MODES"
  phys_mode=$1 phys_addr=$2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -b|--base)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      base="$2"; shift 2 ;;
    -s|--symbols)
      [[ $# -ge 2 ]] || die "$1 requires an argument"
      symfile="$2"; shift 2 ;;
    --slide)
      slide_only=1; shift ;;
    --from)
      [[ $# -ge 2 ]] || die "$1 requires NAME=ADDR"
      [[ "$2" == *=* ]] || die "bad --from value: expected NAME=ADDR"
      from_sym="${2%%=*}"
      from_addr="${2#*=}"
      from_addr="${from_addr#0[xX]}"
      is_hex "$from_addr" \
        || die "bad --from address: ${2#*=}"
      [[ "$from_sym" =~ ^[A-Za-z_][A-Za-z0-9_.]*$ ]] \
        || die "bad --from symbol name: $from_sym"
      shift 2 ;;
    --page-offset)
      [[ $# -ge 2 ]] || die "$1 requires BASE"
      page_offset="$2"; shift 2 ;;
    --vmemmap)
      [[ $# -ge 2 ]] || die "$1 requires BASE"
      vmemmap="$2"; shift 2 ;;
    --phys-offset)
      [[ $# -ge 2 ]] || die "$1 requires ADDR"
      phys_offset="$2"; shift 2 ;;
    --vmemmap-offset)
      [[ $# -ge 2 ]] || die "$1 requires ADDR"
      vmemmap_offset="$2"; shift 2 ;;
    # One knob, two spellings: --page-shift is log2 of the MEMORY page size
    # while this is sizeof(struct page), so the unqualified name invites
    # `--page-size 4096` -- accepted, and wrong by a factor of 64.
    --struct-page-size|--page-size)
      [[ $# -ge 2 ]] || die "$1 requires N"
      struct_page_bytes="$2"; shift 2 ;;
    --page-shift)
      [[ $# -ge 2 ]] || die "$1 requires N"
      page_shift="$2"; shift 2 ;;
    --phys2virt|--virt2phys|--phys2page|--page2phys)
      [[ $# -ge 2 ]] || die "$1 requires ADDR"
      set_phys_mode "${1#--}" "$2"; shift 2 ;;
    -h|--help)
      sed -n '2,/^[^#]/{ /^#/s/^# \?//p; }' "$0"
      exit 0 ;;
    --)
      shift
      while [[ $# -gt 0 ]]; do symbols+=("$1"); shift; done ;;
    -*)
      die "unknown option: $1" ;;
    *)
      symbols+=("$1"); shift ;;
  esac
done

# -- Physical-address translation (data-only pivots) ----------------------
# Independent of the symbol modes: needs bases, not a symbol source. For
# data-only exploits that work in physical addresses (Dirty Pagetable,
# cross-cache).
#
# All four translations turn on one quantity -- the offset into the linear map:
#
#   delta       = phys − phys_offset
#   virt        = delta + page_offset               (--phys2virt / --virt2phys)
#   struct page = vmemmap + (delta >> page-shift) * struct-page-size
#                                                   (--phys2page / --page2phys)
#
# phys_offset is the physical address the kernel maps at the direct-map base.
# It is 0 on the architectures that map physical 0 there, and the base of DRAM
# (or arm64's memstart_addr) on those that do not; the anchor guard below is
# what keeps the zero default from reaching an architecture it is wrong for.
if [[ -n "$phys_mode" ]]; then
  [[ -z "$symfile" ]] || die "physical translation takes no symbol source (-s)"
  [[ -z "$base" && -z "$from_sym" ]] \
    || die "physical translation does not combine with -b/--from"

  # Which base the mode needs, read off the axis rather than re-derived from
  # the operands. Every mode names exactly one region, so this is total: a new
  # one that matched neither arm would fail to build its bases and be caught
  # here rather than reaching the arithmetic with an empty base.
  need_po=0 need_vm=0
  case "$phys_mode" in
    phys2virt|virt2phys) need_po=1 ;;
    phys2page|page2phys) need_vm=1 ;;
    *) die "internal: no region for mode $phys_mode" ;;
  esac

  # A piped `kasld -1` line supplies a base the command line did not, and the
  # `arch=` beside it then settles the anchor too. Read at most once, and only
  # when a base is actually still missing: stdin may be a pipe that never
  # produces a line, so reading it speculatively -- to learn `arch=` for an
  # invocation that already names its bases -- would block a call that has
  # everything it needs.
  want_stdin=0
  if (( need_po )) && [[ -z "$page_offset" ]]; then want_stdin=1; fi
  if (( need_vm )) && [[ -z "$vmemmap" ]];     then want_stdin=1; fi
  line=""
  if (( want_stdin )) && [[ ! -t 0 ]]; then
    IFS= read -r line || line=""
  fi

  # The machine the line names, read once: the anchor gate and the page-shift
  # gate below each consult it, and each has its own idea of which machines are
  # safe. The WHOLE token, not a leading run of name characters: a prefix match
  # would let `arch=x86_64-nonesuch` be served by the `x86_64` entry, and an
  # allowlist may only ever fail in the refusing direction. Control characters
  # are stripped so a hostile line cannot drive the terminal through a refusal.
  arch=""
  if [[ "$line" =~ (^|[[:space:]])arch=([^[:space:]]+) ]]; then
    # Truncated before the control-character strip so the work stays bounded by
    # this constant rather than by the line. A machine name is a dozen or so
    # characters; anything longer is not one, and the 64-character prefix it
    # becomes will not match the lists below -- so the bound errs towards
    # refusing, never towards taking a default.
    arch="${BASH_REMATCH[2]:0:64}"
    arch="${arch//[[:cntrl:]]/}"
  fi

  # Direct-map base: --page-offset, else the line's `dmap=`.
  po=""
  if (( need_po )); then
    if [[ -n "$page_offset" ]]; then
      hexset po --page-offset "$page_offset"
    else
      po=$(oneline_hex dmap "$line") \
        || die "no direct-map base — use --page-offset BASE, or pipe a \`kasld -1\` line whose \`dmap=\` names one"
    fi
  fi

  # vmemmap base: --vmemmap, else the line's `vmemmap=`.
  vm=""
  if (( need_vm )); then
    if [[ -n "$vmemmap" ]]; then
      hexset vm --vmemmap "$vmemmap"
    else
      vm=$(oneline_hex vmemmap "$line") \
        || die "no vmemmap base — use --vmemmap BASE, or pipe a \`kasld -1\` line whose \`vmemmap=\` names one"
    fi
  fi

  # Page geometry. Bounded above so an absurd value cannot reach the arithmetic:
  # a shift at or past the 64-bit width is undefined, and a struct-page size far
  # past the tens of bytes every configuration uses would overflow the multiply
  # and print a wrapped address rather than fail.
  { is_dec "$struct_page_bytes" && (( struct_page_bytes > 0 )) \
      && (( struct_page_bytes <= 4096 )); } \
    || die "bad --struct-page-size: $struct_page_bytes"

  # The page shift. The `kasld -1` line states the target's page size outright,
  # so the value is taken from there rather than inferred from the machine: the
  # architectures that build with a choice of page sizes -- arm64, powerpc, mips
  # and loongarch -- cannot be served by a default, and a shift four out puts
  # the entry sixteen times too far along the array.
  #
  # Where a line was read and did not state one, that is the authority saying it
  # does not know, and the page modes refuse rather than assume. Where no line
  # was read at all the bases were named by hand, and 4 KiB stands as the
  # documented default alongside the anchor's zero.
  #
  # sizeof(struct page) is taken from the same line where it says so. It has no
  # architectural answer -- only the kernel's own BTF reports it -- so where the
  # line is silent 64 stands as a stated default rather than a refusal, which
  # would remove the mode rather than make it honest.
  if [[ -n "$page_shift" ]]; then
    { is_dec "$page_shift" && (( page_shift > 0 && page_shift < 64 )); } \
      || die "bad --page-shift: $page_shift"
  elif ps=$(oneline_dec pagesize "$line"); then
    size_to_shift page_shift "$ps" \
      || die "\`pagesize=$ps\` on the piped line is not a power of two"
  elif (( need_vm )) && [[ -n "$line" ]]; then
    die "the piped line states no page size (\`pagesize=na\`) — pass --page-shift N (log2 of the target's page size; \`getconf PAGESIZE\` on the target reports it)"
  else
    page_shift=12
  fi

  if [[ "$struct_page_bytes" == 64 ]] && sp=$(oneline_dec structpage "$line"); then
    struct_page_bytes=$sp
  fi

  # Two anchors, one per region, because two architectures disagree about
  # whether they are the same number.
  #
  #   --phys-offset    the physical address mapped at the direct-map base
  #   --vmemmap-offset the physical address the vmemmap array indexes from
  #
  # x86 uses 0 for both, and arm64 rounds the base of DRAM down once and uses
  # that one value for the linear map and the array alike. riscv rounds twice
  # and to different granularities -- the linear map from the DRAM base at PMD
  # granularity, the array from that value rounded down again to the memory
  # section size -- so on a board whose DRAM does not begin on a section
  # boundary the two differ, and indexing the array by the linear-map anchor
  # puts the `struct page` at the wrong entry.
  #
  # --vmemmap-offset therefore defaults to --phys-offset, which is exact
  # wherever the kernel uses one number, and is stated separately where it does
  # not. Each option names exactly one quantity in every case.
  vf=""
  if (( need_vm )) && [[ -n "$vmemmap_offset" ]]; then
    hexset vf --vmemmap-offset "$vmemmap_offset"
  fi

  # The linear-map anchor, needed by the direct-map translations and as the
  # fallback for the array's. Defaulting it to zero is right only where the
  # kernel maps physical 0 at the direct-map base; assuming it anywhere else
  # misplaces every result by the anchor, without an error. So the default is
  # taken only for a machine known to anchor there, and the list names the
  # machines that are safe rather than the ones that are not -- an `arch=` this
  # list has never heard of refuses too, which is the direction a new port
  # should fail in.
  #
  # The check reaches as far as the evidence does: `arch=` is known only on the
  # line read above, which is the invocation that took a base from `kasld -1`.
  # Naming the bases by hand states the layout by hand, and the anchor is then
  # the operator's to state as well.
  pf=""
  if [[ -n "$vf" ]]; then
    # The array anchor was named outright, so nothing here consults the linear
    # map's and no default has to be defended for it.
    :
  elif [[ -n "$phys_offset" ]]; then
    hexset pf --phys-offset "$phys_offset"
  else
    case "$arch" in
      # No `arch=` was read: the bases came from the command line, which is the
      # operator stating the layout. Zero is the documented assumption.
      '') pf=0 ;;
      x86_64|amd64|i[3-6]86|mips|mipsel|mips64|mips64el|ppc64|ppc64le|\
      powerpc64|powerpc64le|loongarch64|loong64|s390x)
          pf=0 ;;
      # "not known to" rather than "does not": this arm is reached both by a
      # machine known to anchor elsewhere and by one the list cannot place,
      # `arch=unknown` included. Neither may take the zero default.
      # Name the option the requested translation actually wants: a page mode
      # is served by either anchor, a direct-map mode only by the linear one.
      *)  hint="--phys-offset ADDR, the physical address mapped there (the base of DRAM on arm32/ppc32/riscv, memstart_addr on arm64)"
          if (( need_vm )); then
            hint="--vmemmap-offset ADDR, the physical address the vmemmap array indexes from, or --phys-offset where the kernel anchors both alike"
          fi
          die "arch=$arch is not known to map physical 0 at the direct-map base — pass $hint" ;;
    esac
  fi
  [[ -n "$vf" ]] || vf=$pf

  # The operand, validated once for every mode. A virtual result prints as 16
  # zero-padded hex digits with no prefix, a physical one 0x-prefixed.
  hexset a "--$phys_mode address" "$phys_addr"
  case "$phys_mode" in
    phys2virt)
      hex_ult "$a" "$pf" \
        && die "physical address is below the linear-map anchor (--phys-offset)"
      printf '%016x\n' $(( (0x$a - 0x$pf) + 0x$po )) ;;
    virt2phys)
      hex_ult "$a" "$po" && die "virtual address is below the direct-map base"
      printf '0x%x\n' $(( (0x$a - 0x$po) + 0x$pf )) ;;
    phys2page)
      hex_ult "$a" "$vf" \
        && die "physical address is below the vmemmap anchor (--vmemmap-offset / --phys-offset)"
      printf '%016x\n' \
        $(( 0x$vm + ((0x$a - 0x$vf) >> page_shift) * struct_page_bytes )) ;;
    page2phys)
      hex_ult "$a" "$vm" && die "struct page address is below the vmemmap base"
      off=$(( 0x$a - 0x$vm ))
      # A `struct page *` lands on an entry boundary. One that does not is a
      # pointer into the middle of an entry, a wrong --struct-page-size, or a
      # vmemmap base that is not the array's -- each of which yields a plausible
      # physical address from a premise that is already false.
      (( off % struct_page_bytes == 0 )) \
        || die "not a struct page base: 0x$a is $(( off % struct_page_bytes )) bytes into a ${struct_page_bytes}-byte entry"
      printf '0x%x\n' $(( ((off / struct_page_bytes) << page_shift) + 0x$vf )) ;;
    *) die "internal: no translation for mode $phys_mode" ;;
  esac
  exit 0
fi

[[ -n "$symfile" ]] || die "no symbol source (use -s SOURCE)"
[[ -f "$symfile" ]] || die "symbol file not found: $symfile"
[[ -n "$from_sym" && -n "$base" ]] \
  && die "cannot combine -b/--base with --from"

# -- ELF symbol extraction ------------------------------------------------
# Normalise an ELF symbol source into `addr type name` format. Tries
# nm (.symtab), nm -D (.dynsym), then readelf -sW. Fails if all three
# yield empty output (a stripped binary without a usable symbol table).
if file "$symfile" 2>/dev/null | grep -q ELF; then
  tmp=$(mktemp)
  trap 'rm -f "$tmp"' EXIT
  if   have nm      && nm    "$symfile" 2>/dev/null > "$tmp" && [[ -s "$tmp" ]]; then :
  elif have nm      && nm -D "$symfile" 2>/dev/null > "$tmp" && [[ -s "$tmp" ]]; then :
  elif have readelf && readelf -sW "$symfile" 2>/dev/null \
         | awk 'NF>=8 && $2 ~ /^[0-9a-fA-F]+$/ { printf "%s %s %s\n", $2, substr($4,1,1), $8 }' \
         > "$tmp" && [[ -s "$tmp" ]]; then :
  else
    die "no usable symbols in ELF (stripped binary? install matching debug symbols)"
  fi
  symfile="$tmp"
fi

# -- Locate the default text base ----------------------------------------
# _text is the canonical entry symbol on every architecture; _stext and
# startup_64 are fallbacks for unusual sources (older kallsyms with
# section symbols stripped, x86_64-only dumps, etc.).
default_hex=""
for sym in _text _stext startup_64; do
  default_hex=$(awk -v s="$sym" '$2 ~ /^[Tt]$/ && $3 == s { print $1; exit }' "$symfile")
  [[ -n "$default_hex" ]] && break
done
[[ -n "$default_hex" ]] || die "no _text / _stext / startup_64 in symbol source"
# Security: this value is interpolated into `$(( 0x$default_hex ... ))`. A
# non-hex value from a hostile symbol source (e.g. `a[$(cmd)]`) would be
# executed by bash arithmetic evaluation, so require strict hex before use.
is_hex "$default_hex" \
  || die "malformed _text address in symbol source (expected hex)"

# -- Resolve runtime text base and KASLR slide ---------------------------
if [[ -n "$from_sym" ]]; then
  # Inverse: slide = runtime_addr − default_addr_of(NAME)
  sym_default=$(awk -v s="$from_sym" '$3 == s { print $1; exit }' "$symfile")
  [[ -n "$sym_default" ]] || die "symbol not in source: $from_sym"
  # Security: validate before arithmetic — see the _text check above.
  is_hex "$sym_default" \
    || die "malformed address for $from_sym in symbol source (expected hex)"
  slide=$(( 0x$from_addr - 0x$sym_default ))
  base_hex=$(printf '%x' $(( 0x$default_hex + slide )))
else
  # Forward: base from -b or stdin; slide = base − default _text
  if [[ -z "$base" ]]; then
    [[ ! -t 0 ]] || die "no runtime base supplied — use -b BASE, --from NAME=ADDR, or pipe \`kasld -1\` on stdin"
    if ! IFS= read -r line; then
      die "stdin: no input (expected \`kasld -1\` output)"
    fi
    # `text`, not the `ptext=` it is a substring of: that is the PHYSICAL base,
    # and a different slide. oneline_hex anchors the key, so the two cannot be
    # confused.
    base=$(oneline_hex text "$line") \
      || die "no virtual \`text=0x...\` field in stdin (ptext alone cannot derive the virt slide)"
    base="0x$base"
  fi
  base_hex="${base#0[xX]}"
  is_hex "$base_hex" || die "bad runtime base: $base"
  slide=$(( 0x$base_hex - 0x$default_hex ))
fi

# -- Output ---------------------------------------------------------------
if (( slide_only )); then
  (( slide >= 0 )) && printf '+0x%x\n' "$slide" \
                   || printf -- '-0x%x\n' $(( -slide ))
  exit 0
fi

# --from with no positional symbols: print just the derived base.
if [[ -n "$from_sym" && ${#symbols[@]} -eq 0 ]]; then
  printf '0x%s\n' "$base_hex"
  exit 0
fi

# Look up specific symbols, or dump every symbol with the slide applied.
if (( ${#symbols[@]} > 0 )); then
  for sym in "${symbols[@]}"; do
    line=$(awk -v s="$sym" '$3 == s { print; exit }' "$symfile")
    if [[ -z "$line" ]]; then
      printf '# not found: %s\n' "$sym" >&2
      continue
    fi
    read -r addr_hex sym_type _ <<< "$line"
    # Security: validate before arithmetic — a non-hex address from a hostile
    # symbol source would otherwise be executed by bash arithmetic evaluation.
    if ! is_hex "$addr_hex"; then
      printf '# malformed address for: %s\n' "$sym" >&2
      continue
    fi
    # Strip control characters from the file-derived type: a hostile symbol
    # source must not inject terminal escape sequences into the output (CWE-150).
    printf '%016x %s %s\n' $(( 0x$addr_hex + slide )) "${sym_type//[[:cntrl:]]/}" "$sym"
  done
else
  while IFS=' ' read -r addr sym_type name _; do
    is_hex "$addr" || continue
    [[ -n "$name" ]] || continue
    # Strip control characters from file-derived fields (see the per-symbol path).
    printf '%016x %s %s\n' $(( 0x$addr + slide )) "${sym_type//[[:cntrl:]]/}" "${name//[[:cntrl:]]/}"
  done < "$symfile"
fi
